// Модуль формы внешней обработки «Обмен» (tools/1c/diag/Обмен).
// Живая проверка обмена УТ 11.5 -> БП 3.0 по плану обмена
// «СинхронизацияДанныхЧерезУниверсальныйФормат» (формат EnterpriseData).
//
// Режимы: инфо | настройка | завершить | выгрузка | загрузка | повтор |
//         создать | провести | снимок
//
// Задание: /tmp/opencode/exch/task.txt, поверх него task-<Метаданные.Имя>.txt
// (строки «ключ=значение», «#» — комментарий, пустые строки игнорируются).
// Результат: /tmp/opencode/exch/<ИмяБазы>-<режим>.txt
// Прогресс:  /tmp/opencode/exch/<ИмяБазы>-<режим>.progress.txt
// Сбой:      /tmp/opencode/exch/сбой-<ИмяБазы>-<режим>.txt
//
// Модуль компилируется и в УТ, и в БП. Объекты, которых нет в одной из
// конфигураций, трогаются только динамически: Метаданные.<Коллекция>.Найти(...),
// Документы["Имя"], ПредопределенноеЗначение(...). Каждый необязательный шаг
// завёрнут в Попытку, чтобы отсутствие объекта не рушило весь прогон.

&НаСервере
Функция КаталогРаботы()
	Возврат "/tmp/opencode/exch";
КонецФункции

&НаСервере
Функция КаталогФайлов(Задание)
	Возврат Параметр(Задание, "каталог", КаталогРаботы() + "/files");
КонецФункции

&НаСервере
Процедура Стр(Лог, Текст)
	Лог.Добавить(Текст);
КонецПроцедуры

&НаСервере
Процедура Секция(Лог, Заголовок)
	Лог.Добавить("");
	Лог.Добавить("=== " + Заголовок + " ===");
КонецПроцедуры

&НаСервере
Функция СтрЗнач(Значение)
	Попытка
		Если Значение = Неопределено Тогда
			Возврат "<неопределено>";
		КонецЕсли;
		Текст = Строка(Значение);
		Если СтрДлина(Текст) > 500 Тогда
			Текст = Лев(Текст, 500) + "…";
		КонецЕсли;
		Возврат Текст;
	Исключение
		Возврат "<ошибка преобразования>";
	КонецПопытки;
КонецФункции

&НаСервере
Функция ДатаКлюч(Дата)
	// Имя спецификации и комментарий сборки — ключ идемпотентности постобработки.
	// Формат(Дата, "ДФ=dd.MM.yyyy HH:mm") отдаёт дату в локали сеанса: один
	// прогон дал «04.11.2026 13:15:19», другой — «11/4/2026 1:15:19 PM».
	// При смене локали прежние объекты по имени не находятся и появляются
	// дубли (две спецификации и две сборки на одну продажу), поэтому части
	// даты собираем вручную, без локали.
	ДеньТекст = Формат(День(Дата), "ЧГ=0");
	МесяцТекст = Формат(Месяц(Дата), "ЧГ=0");
	ЧасТекст = Формат(Час(Дата), "ЧГ=0");
	МинутаТекст = Формат(Минута(Дата), "ЧГ=0");
	СекундаТекст = Формат(Секунда(Дата), "ЧГ=0");
	Возврат Формат(Год(Дата), "ЧГ=0")
		+ "-" + Прав("0" + МесяцТекст, 2)
		+ "-" + Прав("0" + ДеньТекст, 2)
		+ " " + Прав("0" + ЧасТекст, 2)
		+ ":" + Прав("0" + МинутаТекст, 2)
		+ ":" + Прав("0" + СекундаТекст, 2);
КонецФункции

&НаСервере
Процедура ВывестиСообщенияПользователю(Лог)
	// причина отказа проведения уходит в «Сообщения», а не в текст исключения:
	// при «Failed to post» единственный способ увидеть её — забрать сообщения
	Попытка
		Сообщения = ПолучитьСообщенияПользователю(Истина);
		Для Каждого Сообщение Из Сообщения Цикл
			Стр(Лог, "  сообщение: " + Сообщение.Текст);
		КонецЦикла;
	Исключение
		Стр(Лог, "  сообщения недоступны: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура ЗаписатьФайл(Путь, Строки, Дописывать = Ложь)
	Файл = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8, Символы.ПС, Дописывать);
	Для Каждого Строка Из Строки Цикл
		Файл.ЗаписатьСтроку(Строка);
	КонецЦикла;
	Файл.Закрыть();
КонецПроцедуры

&НаСервере
Функция ПрочитатьФайлСтроки(Путь)
	Если Не ФайлСуществует(Путь) Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Результат = Новый Массив;
	Файл = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	СтрокаТекста = Файл.ПрочитатьСтроку();
	Пока СтрокаТекста <> Неопределено Цикл
		Результат.Добавить(СтрокаТекста);
		СтрокаТекста = Файл.ПрочитатьСтроку();
	КонецЦикла;
	Файл.Закрыть();
	Возврат Результат;
КонецФункции

&НаСервере
Функция ФайлСуществует(Путь)
	Попытка
		Ф = Новый Файл(Путь);
		Возврат Ф.Существует();
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Разбирает файлы задания в Соответствие «ключ -> значение».
&НаСервере
Функция ПрочитатьЗадание()
	Задание = Новый Соответствие;
	Пути = Новый Массив;
	Пути.Добавить(КаталогРаботы() + "/task.txt");
	Пути.Добавить(КаталогРаботы() + "/task-" + Метаданные.Имя + ".txt");
	Для Каждого Путь Из Пути Цикл
		Для Каждого СтрокаТекста Из ПрочитатьФайлСтроки(Путь) Цикл
			Текст = СокрЛП(СтрокаТекста);
			Если ПустаяСтрока(Текст) Или Лев(Текст, 1) = "#" Тогда
				Продолжить;
			КонецЕсли;
			Позиция = СтрНайти(Текст, "=");
			Если Позиция = 0 Тогда
				Продолжить;
			КонецЕсли;
			Ключ = ВРег(СокрЛП(Лев(Текст, Позиция - 1)));
			Значение = СокрЛП(Сред(Текст, Позиция + 1));
			Задание.Вставить(Ключ, Значение);
		КонецЦикла;
	КонецЦикла;
	Возврат Задание;
КонецФункции

&НаСервере
Функция Параметр(Задание, Ключ, ЗначениеПоУмолчанию = "")
	Значение = Задание.Получить(ВРег(Ключ));
	Если Значение = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	Возврат Значение;
КонецФункции

&НаСервере
Функция Флаг(Задание, Ключ, ЗначениеПоУмолчанию = Ложь)
	Значение = Задание.Получить(ВРег(Ключ));
	Если Значение = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	Возврат ВРег(Значение) = "ДА" Или Значение = "1" Или ВРег(Значение) = "TRUE";
КонецФункции

&НаСервере
Процедура Прогресс(ИмяБазы, Режим, Текст)
	Попытка
		Файл = Новый ЗаписьТекста(КаталогРаботы() + "/" + ИмяБазы + "-" + Режим + ".progress.txt",
			КодировкаТекста.UTF8, Символы.ПС, Истина);
		Файл.ЗаписатьСтроку(Формат(ТекущаяДатаСеанса(), "ДФ=HH:mm:ss") + "  " + Текст);
		Файл.Закрыть();
	Исключение
	КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяСсылка)

	Задание = ПрочитатьЗадание();
	ИмяБазы = Параметр(Задание, "имя", Метаданные.Имя);
	Режим = ВРег(Параметр(Задание, "режим", "инфо"));
	Лог = Новый Массив;

	Стр(Лог, "база: " + Метаданные.Имя + " " + СтрЗнач(Метаданные.Версия));
	Стр(Лог, "режим: " + Режим);
	Стр(Лог, "момент: " + Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-dd HH:mm:ss"));

	Попытка
		ВыполнитьРежим(Задание, Режим, ИмяБазы, Лог);
	Исключение
		Стр(Лог, "");
		Стр(Лог, "!!! ИСКЛЮЧЕНИЕ: " + ОписаниеОшибки());
	КонецПопытки;

	Попытка
		ЗаписатьФайл(КаталогРаботы() + "/" + ИмяБазы + "-" + Режим + ".txt", Лог);
		УдалитьФайлы(КаталогРаботы(), ИмяБазы + "-" + Режим + ".progress.txt");
	Исключение
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	// при отладке сообщений проведения окно оставляем открытым, чтобы снять экран
	Если Параметр(ПрочитатьЗадание(), "показать", "") = "" Тогда
		ЗавершитьРаботуСистемы(Ложь);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ВыполнитьРежим(Задание, Режим, ИмяБазы, Лог)

	Если Режим = "ИНФО" Тогда
		РежимИнфо(Задание, ИмяБазы, Лог);
	ИначеЕсли Режим = "НАСТРОЙКА" Тогда
		РежимНастройка(Задание, ИмяБазы, Лог);
	ИначеЕсли Режим = "ЗАВЕРШИТЬ" Тогда
		РежимЗавершить(Задание, ИмяБазы, Лог);
	ИначеЕсли Режим = "ВЫГРУЗКА" Тогда
		РежимОбмен(Задание, ИмяБазы, Лог, Истина);
	ИначеЕсли Режим = "ЗАГРУЗКА" Тогда
		РежимОбмен(Задание, ИмяБазы, Лог, Ложь);
	ИначеЕсли Режим = "ПОВТОР" Тогда
		РежимПовтор(Задание, ИмяБазы, Лог);
	ИначеЕсли Режим = "СОЗДАТЬ" Тогда
		РежимСоздать(Задание, ИмяБазы, Лог);
	ИначеЕсли Режим = "ПРОДАЖА" Тогда
		РежимПродажа(Задание, ИмяБазы, Лог);
	ИначеЕсли Режим = "НАБОР" Тогда
		РежимНабор(Задание, ИмяБазы, Лог);
	ИначеЕсли Режим = "ПРОВЕСТИ" Тогда
		РежимПровести(Задание, ИмяБазы, Лог);
	ИначеЕсли Режим = "СНИМОК" Тогда
		РежимСнимок(Задание, ИмяБазы, Лог);
	ИначеЕсли Режим = "ЗАПРОС" Тогда
		РежимЗапрос(Задание, ИмяБазы, Лог);
	ИначеЕсли Режим = "ПОЛИТИКА" Тогда
		РежимПолитика(Задание, ИмяБазы, Лог);
	ИначеЕсли Режим = "ИЗМЕНИТЬ" Тогда
		РежимИзменить(Задание, ИмяБазы, Лог);
	ИначеЕсли Режим = "УДАЛИТЬ" Тогда
		РежимУдалить(Задание, ИмяБазы, Лог);
	ИначеЕсли Режим = "КОМПЛЕКТ" Тогда
		РежимКомплект(Задание, ИмяБазы, Лог);
	ИначеЕсли Режим = "ЗАМЕНА" Тогда
		РежимЗамена(Задание, ИмяБазы, Лог);
	ИначеЕсли Режим = "ВЕРСИЯ" Тогда
		РежимВерсия(Задание, ИмяБазы, Лог);
	ИначеЕсли Режим = "ПОСТОБРАБОТКА" Тогда
		РежимПостобработка(Задание, ИмяБазы, Лог);
	ИначеЕсли Режим = "УБОРКА" Тогда
		РежимУборка(Задание, ИмяБазы, Лог);
	ИначеЕсли Режим = "СОСТАВ" Тогда
		РежимСостав(Задание, ИмяБазы, Лог);
	ИначеЕсли Режим = "ПРИХОД" Тогда
		РежимПриход(Задание, ИмяБазы, Лог);
	ИначеЕсли Режим = "ЕДИНИЦЫ" Тогда
		РежимЕдиницы(Задание, ИмяБазы, Лог);
	Иначе
		Стр(Лог, "неизвестный режим: " + Режим);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ИмяПланаОбмена(Задание)
	Имя = Параметр(Задание, "план", "");
	Если Не ПустаяСтрока(Имя) Тогда
		Возврат Имя;
	КонецЕсли;
	Если Метаданные.ПланыОбмена.Найти("СинхронизацияДанныхЧерезУниверсальныйФормат") <> Неопределено Тогда
		Возврат "СинхронизацияДанныхЧерезУниверсальныйФормат";
	КонецЕсли;
	Для Каждого План Из Метаданные.ПланыОбмена Цикл
		Если СтрНайти(ВРег(План.Имя), "СИНХРОНИЗАЦИЯ") > 0 Тогда
			Возврат План.Имя;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

&НаСервере
Функция УзелКорреспондента(Задание, Лог, Создавать = Ложь)

	ИмяПлана = ИмяПланаОбмена(Задание);
	Если ПустаяСтрока(ИмяПлана) Тогда
		Стр(Лог, "план обмена не найден в метаданных");
		Возврат Неопределено;
	КонецЕсли;

	Менеджер = ПланыОбмена[ИмяПлана];
	Код = Параметр(Задание, "код", "");
	Если ПустаяСтрока(Код) Тогда
		Стр(Лог, "в задании не указан код узла-корреспондента");
		Возврат Неопределено;
	КонецЕсли;

	Узел = Менеджер.НайтиПоКоду(Код);
	Если ЗначениеЗаполнено(Узел) Тогда
		Возврат Узел;
	КонецЕсли;
	Если Не Создавать Тогда
		Стр(Лог, "узел с кодом " + Код + " не найден");
		Возврат Неопределено;
	КонецЕсли;

	Стр(Лог, "узел с кодом " + Код + " не найден — создаю");
	Попытка
		Объект = Менеджер.СоздатьУзел();
	Исключение
		Объект = Менеджер.СоздатьЭлемент();
	КонецПопытки;
	Объект.Код = Код;
	Объект.Наименование = Параметр(Задание, "наименование", "Обмен " + Код);
	Объект.ОбменДанными.Загрузка = Истина;
	Попытка
		Объект.Записать();
	Исключение
		Стр(Лог, "ошибка создания узла: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
	Возврат Объект.Ссылка;

КонецФункции

&НаСервере
Функция ФайлыОбмена(Каталог)
	Результат = Новый Массив;
	Попытка
		Ф = Новый Файл(Каталог);
		Если Не Ф.Существует() Тогда
			Возврат Результат;
		КонецЕсли;
		Для Каждого Элемент Из НайтиФайлы(Каталог, "*", Ложь) Цикл
			Если Не Элемент.ЭтоФайл() Тогда
				Продолжить;
			КонецЕсли;
			Результат.Добавить(Элемент.ПолноеИмя + "  " + Формат(Элемент.Размер(), "ЧГ=0") + " байт, "
				+ Формат(Элемент.ПолучитьВремяИзменения(), "ДФ=yyyy-MM-dd HH:mm:ss"));
		КонецЦикла;
	Исключение
		Результат.Добавить("ошибка чтения каталога: " + ОписаниеОшибки());
	КонецПопытки;
	Возврат Результат;
КонецФункции

// ============================== РЕЖИМ «ИНФО» ==============================

&НаСервере
Функция МетаданныеЕсть(Коллекция, Имя)
	Попытка
		КоллекцияМетаданных = Метаданные[Коллекция];
		Если КоллекцияМетаданных = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		Возврат КоллекцияМетаданных.Найти(Имя) <> Неопределено;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

&НаСервере
Функция ИменаМетаданных(Коллекция)
	Результат = Новый Массив;
	Попытка
		Для Каждого Объект Из Метаданные[Коллекция] Цикл
			Результат.Добавить(Объект.Имя);
		КонецЦикла;
	Исключение
	КонецПопытки;
	Возврат Результат;
КонецФункции

&НаСервере
Функция ЗначениеНастройкиПлана(ИмяПлана, ИмяНастройки)
	Попытка
		Возврат ОбменДаннымиСервер.ЗначениеНастройкиПланаОбмена(ИмяПлана, ИмяНастройки);
	Исключение
		Возврат "<нет доступа: " + ОписаниеОшибки() + ">";
	КонецПопытки;
КонецФункции

&НаСервере
Функция КоличествоЗаписей(ТекстЗапроса)
	Попытка
		Запрос = Новый Запрос(ТекстЗапроса);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Формат(Выборка.Всего, "ЧГ=0");
		КонецЕсли;
		Возврат "0";
	Исключение
		Возврат "ошибка: " + ОписаниеОшибки();
	КонецПопытки;
КонецФункции

&НаСервере
Процедура РежимИнфо(Задание, ИмяБазы, Лог)

	Секция(Лог, "Конфигурация");
	Стр(Лог, "имя: " + Метаданные.Имя);
	Стр(Лог, "версия: " + СтрЗнач(Метаданные.Версия));
	Стр(Лог, "синоним: " + СтрЗнач(Метаданные.Синоним));
	Стр(Лог, "планы обмена: " + СтрСоединить(ИменаМетаданных("ПланыОбмена"), ", "));

	ИмяПлана = ИмяПланаОбмена(Задание);
	Прогресс(ИмяБазы, "ИНФО", "план обмена: " + ИмяПлана);

	Секция(Лог, "План обмена «" + ИмяПлана + "»");
	Для Каждого ИмяНастройки Из СтрРазделить("ЭтоПланОбменаXDTO,ФорматОбмена,ИмяКонфигурацииИсточника,"
		+ "ПредупреждатьОНесоответствииВерсийПравилОбмена,ВариантНастройки,ОбъектнаяКонвертацияXDTO", ",") Цикл
		Стр(Лог, ИмяНастройки + " = " + СтрЗнач(ЗначениеНастройкиПлана(ИмяПлана, ИмяНастройки)));
	КонецЦикла;

	Стр(Лог, "ВерсииФорматаОбмена:");
	Версии = ЗначениеНастройкиПлана(ИмяПлана, "ВерсииФорматаОбмена");
	Если ТипЗнч(Версии) = Тип("Соответствие") Тогда
		Для Каждого Версия Из Версии Цикл
			Стр(Лог, "  " + Версия.Ключ + " -> " + СтрЗнач(Версия.Значение));
		КонецЦикла;
	Иначе
		Стр(Лог, "  " + СтрЗнач(Версии));
	КонецЕсли;

	Прогресс(ИмяБазы, "ИНФО", "узлы плана");
	Секция(Лог, "Узлы плана обмена");
	ИнфоУзлы(ИмяПлана, Задание, Лог);

	Прогресс(ИмяБазы, "ИНФО", "состояние обмена");
	Секция(Лог, "Состояние обмена");
	ИнфоСостояние(Задание, Лог);

	Прогресс(ИмяБазы, "ИНФО", "поддерживаемые объекты");
	Секция(Лог, "Поддерживаемые объекты формата");
	ИнфоПоддерживаемыеОбъекты(ИмяПлана, Лог);

	Прогресс(ИмяБазы, "ИНФО", "справочная база");
	Секция(Лог, "Справочная база");
	ИнфоСоставБазы(ИмяБазы, Лог);

	Прогресс(ИмяБазы, "ИНФО", "готово");

КонецПроцедуры

&НаСервере
Процедура ИнфоУзлы(ИмяПлана, Задание, Лог)

	Если ПустаяСтрока(ИмяПлана) Тогда
		Возврат;
	КонецЕсли;

	Менеджер = ПланыОбмена[ИмяПлана];
	Попытка
		ЭтотУзел = Менеджер.ЭтотУзел();
		Стр(Лог, "этот узел: " + СтрЗнач(ЭтотУзел) + " (код " + СтрЗнач(ЭтотУзел.Код) + ")");
	Исключение
		Стр(Лог, "этот узел: ошибка " + ОписаниеОшибки());
	КонецПопытки;

	ТекстЗапроса = "ВЫБРАТЬ Код, Наименование, ВерсияФорматаОбмена, НомерОтправленного, НомерПринятого
		|ИЗ ПланОбмена." + ИмяПлана + "
		|УПОРЯДОЧИТЬ ПО Код";
	Попытка
		Запрос = Новый Запрос(ТекстЗапроса);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Стр(Лог, "узел " + СтрЗнач(Выборка.Код) + " «" + СтрЗнач(Выборка.Наименование) + "»"
				+ " формат=" + СтрЗнач(Выборка.ВерсияФорматаОбмена)
				+ " отправлено=" + СтрЗнач(Выборка.НомерОтправленного)
				+ " принято=" + СтрЗнач(Выборка.НомерПринятого));
		КонецЦикла;
	Исключение
		Стр(Лог, "ошибка чтения узлов: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура ИнфоСостояние(Задание, Лог)

	Узел = УзелКорреспондента(Задание, Лог, Ложь);
	Если Узел = Неопределено Тогда
		Стр(Лог, "состояние не читается: нет узла-корреспондента");
		Возврат;
	КонецЕсли;

	Стр(Лог, "корреспондент: " + СтрЗнач(Узел) + ", код " + СтрЗнач(Узел.Код));

	Попытка
		Стр(Лог, "имя плана корреспондента: "
			+ СтрЗнач(РегистрыСведений.ОбщиеНастройкиУзловИнформационныхБаз.ИмяПланаОбменаКорреспондента(Узел)));
	Исключение
		Стр(Лог, "имя плана корреспондента: ошибка " + ОписаниеОшибки());
	КонецПопытки;

	Попытка
		Стр(Лог, "настройка завершена: "
			+ ?(РегистрыСведений.ОбщиеНастройкиУзловИнформационныхБаз.НастройкаЗавершена(Узел), "да", "нет"));
	Исключение
		Стр(Лог, "настройка завершена: ошибка " + ОписаниеОшибки());
	КонецПопытки;

	Попытка
		Стр(Лог, "признак начальной выгрузки: "
			+ ?(РегистрыСведений.ОбщиеНастройкиУзловИнформационныхБаз.УстановленПризнакНачальнойВыгрузкиДанных(Узел),
				"да", "нет"));
	Исключение
		Стр(Лог, "признак начальной выгрузки: ошибка " + ОписаниеОшибки());
	КонецПопытки;

	Попытка
		Стр(Лог, "версия корреспондента: "
			+ СтрЗнач(РегистрыСведений.ОбщиеНастройкиУзловИнформационныхБаз.ВерсияКорреспондента(Узел)));
	Исключение
		Стр(Лог, "версия корреспондента: ошибка " + ОписаниеОшибки());
	КонецПопытки;

	Попытка
		Настройки = Справочники.НастройкиТранспортаСообщенийОбмена.НастройкиТранспорта(Узел, "FILE");
		Стр(Лог, "настройки транспорта FILE:");
		Если Настройки.Количество() = 0 Тогда
			Стр(Лог, "  <пусто>");
		Иначе
			Для Каждого Настройка Из Настройки Цикл
				Стр(Лог, "  " + Настройка.Ключ + " = " + СтрЗнач(Настройка.Значение));
			КонецЦикла;
		КонецЕсли;
	Исключение
		Стр(Лог, "настройки транспорта FILE: ошибка " + ОписаниеОшибки());
	КонецПопытки;

	Стр(Лог, "файлы в каталоге обмена " + КаталогФайлов(Задание) + ":");
	Для Каждого Файл Из ФайлыОбмена(КаталогФайлов(Задание)) Цикл
		Стр(Лог, "  " + Файл);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ИнфоПоддерживаемыеОбъекты(ИмяПлана, Лог)

	Попытка
		Таблица = ОбменДаннымиXDTOСервер.ПоддерживаемыеОбъектыФормата(ИмяПлана, "ОтправкаПолучение");
	Исключение
		Стр(Лог, "таблица не получена: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	Стр(Лог, "всего строк: " + Формат(Таблица.Количество(), "ЧГ=0"));
	Интересные = Новый Массив;
	Интересные.Добавить("ДОКУМЕНТ.СБОРКАТОВАРОВ");
	Интересные.Добавить("ДОКУМЕНТ.КОМПЛЕКТАЦИЯНОМЕНКЛАТУРЫ");
	Интересные.Добавить("СПРАВОЧНИК.НОМЕНКЛАТУРА");
	Интересные.Добавить("СПРАВОЧНИК.ВИДЫНОМЕНКЛАТУРЫ");
	Интересные.Добавить("СПРАВОЧНИК.ТИПЫНОМЕНКЛАТУРЫ");
	Интересные.Добавить("СПРАВОЧНИК.СПЕЦИФИКАЦИИНОМЕНКЛАТУРЫ");
	Интересные.Добавить("СПРАВОЧНИК.ВАРИАНТЫКОМПЛЕКТАЦИИНОМЕНКЛАТУРЫ");
	Интересные.Добавить("СПРАВОЧНИК.НАБОРЫНОМЕНКЛАТУРЫ");
	Интересные.Добавить("ПЛАНВИДОВХАРАКТЕРИСТИК.ВИДЫХАРАКТЕРИСТИКНОМЕНКЛАТУРЫ");

	Для Каждого СтрокаТаблицы Из Таблица Цикл
		ИмяОбъекта = ВРег(СтрЗнач(СтрокаТаблицы.Объект));
		Подходит = Не Ложь;
		Если Интересные.Найти(ИмяОбъекта) <> Неопределено Тогда
			Подходит = Истина;
		ИначеЕсли СтрНайти(ИмяОбъекта, "СБОРК") > 0 Или СтрНайти(ИмяОбъекта, "КОМПЛЕКТ") > 0
			Или СтрНайти(ИмяОбъекта, "СПЕЦИФИК") > 0 Или СтрНайти(ИмяОбъекта, "НАБОР") > 0 Тогда
			Подходит = Истина;
		КонецЕсли;
		Если Не Подходит Тогда
			Продолжить;
		КонецЕсли;
		Текст = "  " + СтрокаТаблицы.Объект + " (формат " + СтрЗнач(СтрокаТаблицы.Версия) + ")";
		Попытка
			Текст = Текст + ": отправка=" + ?(СтрокаТаблицы.Отправка, "да", "нет")
				+ ", получение=" + ?(СтрокаТаблицы.Получение, "да", "нет");
		Исключение
		КонецПопытки;
		Стр(Лог, Текст);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ИнфоВывестиЗапрос(Лог, Заголовок, ТекстЗапроса, Колонки)
	Стр(Лог, Заголовок);
	Попытка
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("Дата", КонецДня(ТекущаяДатаСеанса()));
		Выборка = Запрос.Выполнить().Выбрать();
		Есть = Ложь;
		Пока Выборка.Следующий() Цикл
			Есть = Истина;
			Части = Новый Массив;
			Для Каждого Колонка Из Колонки Цикл
				Части.Добавить(Колонка + "=" + СтрЗнач(Выборка[Колонка]));
			КонецЦикла;
			Стр(Лог, "  " + СтрСоединить(Части, "; "));
		КонецЦикла;
		Если Не Есть Тогда
			Стр(Лог, "  <пусто>");
		КонецЕсли;
	Исключение
		Стр(Лог, "  ошибка: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура ИнфоСоставБазы(ИмяБазы, Лог)

	Для Каждого Имя Из ИменаМетаданных("Документы") Цикл
		Если СтрНайти(ВРег(Имя), "СБОРК") > 0 Или СтрНайти(ВРег(Имя), "КОМПЛЕКТ") > 0 Тогда
			Стр(Лог, "документ " + Имя + ": всего "
				+ КоличествоЗаписей("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего ИЗ Документ." + Имя));
		КонецЕсли;
	КонецЦикла;

	Для Каждого Имя Из СтрРазделить("ВариантыКомплектацииНоменклатуры,СпецификацииНоменклатуры,"
		+ "НаборыНоменклатуры,ВидыНоменклатуры,ТипыНоменклатуры", ",") Цикл
		Если МетаданныеЕсть("Справочники", Имя) Тогда
			Стр(Лог, "справочник " + Имя + ": всего "
				+ КоличествоЗаписей("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего ИЗ Справочник." + Имя));
		КонецЕсли;
	КонецЦикла;

	Для Каждого Имя Из СтрРазделить("ТипНоменклатуры,ВидыОперацийКомплектацияНоменклатуры,"
		+ "ХозяйственныеОперации,СтатусыСборокТоваров", ",") Цикл
		Если МетаданныеЕсть("Перечисления", Имя) Тогда
			Значения = Новый Массив;
			Попытка
				КоллекцияПеречисления = Метаданные["Перечисления"].Найти(Имя);
				Если КоллекцияПеречисления <> Неопределено Тогда
					Для Каждого Значение Из КоллекцияПеречисления.ЗначенияПеречисления Цикл
						Значения.Добавить(Значение.Имя);
					КонецЦикла;
				КонецЕсли;
			Исключение
			КонецПопытки;
			Первые = Новый Массив;
			Для Инд = 0 По Мин(29, Значения.Количество() - 1) Цикл
				Первые.Добавить(Значения[Инд]);
			КонецЦикла;
			Хвост = ?(Значения.Количество() > 30,
				" … (всего " + Формат(Значения.Количество(), "ЧГ=0") + ")", "");
			Стр(Лог, "перечисление " + Имя + " (" + Формат(Значения.Количество(), "ЧГ=0") + "): "
				+ СтрСоединить(Первые, ", ") + Хвост);
		КонецЕсли;
	КонецЦикла;

	Попытка
		Стр(Лог, "номенклатура по типу:");
		Запрос = Новый Запрос("ВЫБРАТЬ ТипНоменклатуры КАК Тип, КОЛИЧЕСТВО(*) КАК Всего
			|ИЗ Справочник.Номенклатура
			|СГРУППИРОВАТЬ ПО ТипНоменклатуры
			|УПОРЯДОЧИТЬ ПО Всего УБЫВ");
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Стр(Лог, "  " + СтрЗнач(Выборка.Тип) + ": " + Формат(Выборка.Всего, "ЧГ=0"));
		КонецЦикла;
	Исключение
		Стр(Лог, "  тип номенклатуры: ошибка " + ОписаниеОшибки());
	КонецПопытки;

	ИнфоВывестиЗапрос(Лог, "последние документы сборки:",
		"ВЫБРАТЬ ПЕРВЫЕ 10 Ссылка КАК Ссылка, Дата КАК Дата, Номер КАК Номер,
		|	ХозяйственнаяОперация КАК Операция, Номенклатура КАК Номенклатура,
		|	Количество КАК Количество, Проведен КАК Проведен
		|ИЗ Документ.СборкаТоваров
		|УПОРЯДОЧИТЬ ПО Дата УБЫВ",
		СтрРазделить("Дата,Номер,Операция,Номенклатура,Количество,Проведен", ","));

	ИнфоВывестиЗапрос(Лог, "последние документы комплектации:",
		"ВЫБРАТЬ ПЕРВЫЕ 10 Ссылка КАК Ссылка, Дата КАК Дата, Номер КАК Номер,
		|	ВидОперации КАК Операция, Номенклатура КАК Номенклатура,
		|	Количество КАК Количество, Проведен КАК Проведен
		|ИЗ Документ.КомплектацияНоменклатуры
		|УПОРЯДОЧИТЬ ПО Дата УБЫВ",
		СтрРазделить("Дата,Номер,Операция,Номенклатура,Количество,Проведен", ","));

	ИнфоВывестиЗапрос(Лог, "комплектующие с остатком (ТоварыНаСкладах):",
		"ВЫБРАТЬ ПЕРВЫЕ 15 Остатки.Номенклатура КАК Номенклатура, Остатки.Склад КАК Склад,
		|	Остатки.ВНаличииОстаток КАК ВНаличии
		|ИЗ РегистрНакопления.ТоварыНаСкладах.Остатки(&Дата) КАК Остатки
		|ГДЕ Остатки.ВНаличииОстаток > 0
		|УПОРЯДОЧИТЬ ПО ВНаличии УБЫВ",
		СтрРазделить("Номенклатура,Склад,ВНаличии", ","));

	ИнфоВывестиЗапрос(Лог, "спецификации номенклатуры:",
		"ВЫБРАТЬ ПЕРВЫЕ 10 Ссылка КАК Ссылка, Номенклатура КАК Номенклатура,
		|	Количество КАК Количество
		|ИЗ Справочник.СпецификацииНоменклатуры
		|УПОРЯДОЧИТЬ ПО Номенклатура",
		СтрРазделить("Ссылка,Номенклатура,Количество", ","));

	ИнфоВывестиЗапрос(Лог, "варианты комплектации:",
		"ВЫБРАТЬ ПЕРВЫЕ 10 Ссылка КАК Ссылка, Владелец КАК Владелец, Количество КАК Количество,
		|	Основной КАК Основной
		|ИЗ Справочник.ВариантыКомплектацииНоменклатуры
		|УПОРЯДОЧИТЬ ПО Владелец",
		СтрРазделить("Ссылка,Владелец,Количество,Основной", ","));

КонецПроцедуры

// ============================ РЕЖИМ «НАСТРОЙКА» ============================

&НаСервере
Процедура РежимНастройка(Задание, ИмяБазы, Лог)

	Секция(Лог, "Настройка узла обмена");

	ИмяПлана = ИмяПланаОбмена(Задание);
	Если ПустаяСтрока(ИмяПлана) Тогда
		Стр(Лог, "план обмена не найден");
		Возврат;
	КонецЕсли;
	Стр(Лог, "план обмена: " + ИмяПлана);

	Менеджер = ПланыОбмена[ИмяПлана];
	Попытка
		Стр(Лог, "этот узел: " + СтрЗнач(Менеджер.ЭтотУзел()));
	Исключение
		Стр(Лог, "этот узел: ошибка " + ОписаниеОшибки());
	КонецПопытки;

	Узел = УзелКорреспондента(Задание, Лог, Истина);
	Если Не ЗначениеЗаполнено(Узел) Тогда
		Возврат;
	КонецЕсли;

	Объект = Узел.ПолучитьОбъект();
	ВерсияФормата = Параметр(Задание, "версияформата", "1.20");
	Попытка
		Объект.ОбменДанными.Загрузка = Истина;
		Объект.ВерсияФорматаОбмена = ВерсияФормата;
		Если Не ПустаяСтрока(Параметр(Задание, "наименование", "")) Тогда
			Объект.Наименование = Параметр(Задание, "наименование", "");
		КонецЕсли;
		Объект.Записать();
		Стр(Лог, "узел записан: код " + СтрЗнач(Объект.Код) + " «" + СтрЗнач(Объект.Наименование)
			+ "», формат " + СтрЗнач(Объект.ВерсияФорматаОбмена));
	Исключение
		Стр(Лог, "ошибка записи узла: " + ОписаниеОшибки());
	КонецПопытки;

	Узел = Объект.Ссылка;

	// Версия формата собственного узла: её читает корреспондент при обмене.
	Попытка
		ЭтоТотЖеУзел = (Менеджер.ЭтотУзел() = Узел);
	Исключение
		ЭтоТотЖеУзел = Ложь;
	КонецПопытки;
	Если Не ЭтоТотЖеУзел Тогда
		Попытка
			СвойОбъект = Менеджер.ЭтотУзел().ПолучитьОбъект();
			СвойОбъект.ОбменДанными.Загрузка = Истина;
			СвойОбъект.ВерсияФорматаОбмена = ВерсияФормата;
			СвойОбъект.Записать();
			Стр(Лог, "формат собственного узла: " + СтрЗнач(СвойОбъект.ВерсияФорматаОбмена));
		Исключение
			Стр(Лог, "формат собственного узла: ошибка " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;

	ИмяПланаКорреспондента = Параметр(Задание, "планакорреспондента", ИмяПлана);
	Попытка
		РегистрыСведений.ОбщиеНастройкиУзловИнформационныхБаз.УстановитьИмяПланаОбменаКорреспондента(Узел,
			ИмяПланаКорреспондента);
		Стр(Лог, "имя плана корреспондента: " + ИмяПланаКорреспондента);
	Исключение
		Стр(Лог, "имя плана корреспондента: ошибка " + ОписаниеОшибки());
	КонецПопытки;

	Каталог = КаталогФайлов(Задание);
	Попытка
		Ф = Новый Файл(Каталог);
		Если Не Ф.Существует() Тогда
			СоздатьКаталог(Каталог);
			Стр(Лог, "каталог обмена создан: " + Каталог);
		Иначе
			Стр(Лог, "каталог обмена: " + Каталог);
		КонецЕсли;
	Исключение
		Стр(Лог, "каталог обмена: ошибка " + ОписаниеОшибки());
	КонецПопытки;

	Настройки = Новый Структура;
	Настройки.Вставить("КаталогОбменаИнформацией", Каталог);
	Настройки.Вставить("СжиматьФайлИсходящегоСообщения", Флаг(Задание, "сжатие", Ложь));
	Настройки.Вставить("ПарольАрхиваСообщенияОбмена", "");
	Настройки.Вставить("Транслитерация", Ложь);

	Попытка
		СтруктураЗаписи = Новый Структура;
		СтруктураЗаписи.Вставить("Корреспондент", Узел);
		СтруктураЗаписи.Вставить("ИдентификаторТранспорта", "FILE");
		СтруктураЗаписи.Вставить("Настройки", Настройки);
		СтруктураЗаписи.Вставить("НастройкаПоУмолчанию", Истина);
		Справочники.НастройкиТранспортаСообщенийОбмена.ОбновитьНастройки(СтруктураЗаписи);
		Стр(Лог, "транспорт FILE записан:");
		Для Каждого Настройка Из Настройки Цикл
			Стр(Лог, "  " + Настройка.Ключ + " = " + СтрЗнач(Настройка.Значение));
		КонецЦикла;
	Исключение
		Стр(Лог, "ошибка записи транспорта: " + ОписаниеОшибки());
	КонецПопытки;

	Попытка
		Стр(Лог, "регистрировать изменения: "
			+ СтрЗнач(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Узел, "РегистрироватьИзменения")));
	Исключение
	КонецПопытки;

	Попытка
		Стр(Лог, "настройка завершена: "
			+ ?(РегистрыСведений.ОбщиеНастройкиУзловИнформационныхБаз.НастройкаЗавершена(Узел), "да", "нет"));
	Исключение
	КонецПопытки;

	Стр(Лог, "настройка оставлена незавершённой: первым идёт обмен настройками");

КонецПроцедуры

// =========================== РЕЖИМ «ЗАВЕРШИТЬ» =============================

&НаСервере
Процедура РежимЗавершить(Задание, ИмяБазы, Лог)

	Секция(Лог, "Завершение настройки синхронизации");

	Узел = УзелКорреспондента(Задание, Лог, Ложь);
	Если Не ЗначениеЗаполнено(Узел) Тогда
		Возврат;
	КонецЕсли;

	Было = Неопределено;
	Попытка
		Было = РегистрыСведений.ОбщиеНастройкиУзловИнформационныхБаз.НастройкаЗавершена(Узел);
	Исключение
	КонецПопытки;
	Стр(Лог, "до вызова: настройка завершена = " + СтрЗнач(Было));
	Стр(Лог, "номер принятого: " + СтрЗнач(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Узел, "НомерПринятого")));

	Попытка
		ОбменДаннымиСервер.ЗавершитьНастройкуСинхронизацииДанных(Узел);
		Стр(Лог, "вызов ЗавершитьНастройкуСинхронизацииДанных выполнен");
	Исключение
		Стр(Лог, "ошибка вызова: " + ОписаниеОшибки());
	КонецПопытки;

	Стало = Неопределено;
	Попытка
		Стало = РегистрыСведений.ОбщиеНастройкиУзловИнформационныхБаз.НастройкаЗавершена(Узел);
	Исключение
	КонецПопытки;
	Стр(Лог, "после вызова: настройка завершена = " + СтрЗнач(Стало));

	Если Стало <> Истина И Флаг(Задание, "принудительно", Ложь) Тогда
		Стр(Лог, "штатный путь отказал — ставлю признак принудительно (принудительно=да)");
		Попытка
			РегистрыСведений.ОбщиеНастройкиУзловИнформационныхБаз.УстановитьПризнакНастройкаЗавершена(Узел);
			Стр(Лог, "после принудительной установки: настройка завершена = "
				+ СтрЗнач(РегистрыСведений.ОбщиеНастройкиУзловИнформационныхБаз.НастройкаЗавершена(Узел)));
		Исключение
			Стр(Лог, "принудительная установка: ошибка " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

// ======================= РЕЖИМЫ «ВЫГРУЗКА»/«ЗАГРУЗКА» ======================

// Повторная загрузка последнего принятого сообщения: счётчик «принято» на узле
// уменьшается на единицу, после чего выполняется обычная загрузка. Нужно на
// стенде, чтобы вернуть документу исходные строки после постобработки
// (§6 протокола EVIDENCE-2026-11-03-nabor-komplekt.md).
&НаСервере
Процедура РежимПовтор(Задание, ИмяБазы, Лог)

	Секция(Лог, "Повторная загрузка последнего сообщения");

	Узел = УзелКорреспондента(Задание, Лог, Ложь);
	Если Не ЗначениеЗаполнено(Узел) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Объект = Узел.ПолучитьОбъект();
		Стр(Лог, "номер принятого до: " + СтрЗнач(Объект.НомерПринятого));
		Было = Объект.НомерПринятого;
		Объект.ОбменДанными.Загрузка = Истина;
		Объект.НомерПринятого = ?(Было > 0, Было - 1, 0);
		Объект.Записать();
		Стр(Лог, "номер принятого после: " + СтрЗнач(Объект.НомерПринятого));
	Исключение
		Стр(Лог, "счётчик не сброшен: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	РежимОбмен(Задание, ИмяБазы, Лог, Ложь);

КонецПроцедуры

&НаСервере
Процедура РежимОбмен(Задание, ИмяБазы, Лог, ЭтоВыгрузка)

	Секция(Лог, ?(ЭтоВыгрузка, "Выгрузка данных", "Загрузка данных"));

	Узел = УзелКорреспондента(Задание, Лог, Ложь);
	Если Не ЗначениеЗаполнено(Узел) Тогда
		Возврат;
	КонецЕсли;

	Каталог = КаталогФайлов(Задание);
	Стр(Лог, "каталог обмена: " + Каталог);
	Стр(Лог, "файлы до обмена:");
	Для Каждого Файл Из ФайлыОбмена(Каталог) Цикл
		Стр(Лог, "  " + Файл);
	КонецЦикла;

	Попытка
		Стр(Лог, "настройка завершена: "
			+ ?(РегистрыСведений.ОбщиеНастройкиУзловИнформационныхБаз.НастройкаЗавершена(Узел), "да", "нет"));
	Исключение
		Стр(Лог, "настройка завершена: ошибка " + ОписаниеОшибки());
	КонецПопытки;

	Действие = ?(ЭтоВыгрузка, Перечисления.ДействияПриОбмене.ВыгрузкаДанных,
		Перечисления.ДействияПриОбмене.ЗагрузкаДанных);
	Транспорт = Параметр(Задание, "транспорт", "FILE");

	Начало = ТекущаяДатаСеанса();
	Отказ = Ложь;
	Попытка
		ОбменДаннымиСервер.ВыполнитьДействиеОбмена(Отказ, Узел, Действие, Транспорт);
		Стр(Лог, "обмен выполнен");
	Исключение
		Стр(Лог, "ошибка обмена: " + ОписаниеОшибки());
		Отказ = Истина;
	КонецПопытки;

	Стр(Лог, "длительность, с: " + Формат(ТекущаяДатаСеанса() - Начало, "ЧЦ=10; ЧДЦ=1"));
	Стр(Лог, "отказ: " + ?(Отказ, "да", "нет"));
	Если Отказ Тогда
		// причина отказа загрузки не попадает ни в исключение, ни в лог обмена
		ВывестиСообщенияПользователю(Лог);
	КонецЕсли;
	Стр(Лог, "файлы после обмена:");
	Для Каждого Файл Из ФайлыОбмена(Каталог) Цикл
		Стр(Лог, "  " + Файл);
	КонецЦикла;

	Попытка
		Стр(Лог, "номер отправленного: " + СтрЗнач(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Узел, "НомерОтправленного")));
		Стр(Лог, "номер принятого: " + СтрЗнач(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Узел, "НомерПринятого")));
	Исключение
	КонецПопытки;

	Попытка
		Стр(Лог, "состояние узла: " + СтрЗнач(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Узел, "Наименование")));
	Исключение
	КонецПопытки;

	РазобратьСообщения(Лог, Каталог);

КонецПроцедуры

&НаСервере
Функция ПрочитатьТекст(Путь)
	Попытка
		Файл = Новый ЧтениеТекста(Путь, "UTF-8");
		Текст = Файл.Прочитать();
		Файл.Закрыть();
		Возврат Текст;
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

&НаСервере
Функция Между(Текст, Начало, Конец)
	Позиция = СтрНайти(Текст, Начало);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(Текст, Позиция + СтрДлина(Начало));
	Позиция = СтрНайти(Хвост, Конец);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Лев(Хвост, Позиция - 1);
КонецФункции

&НаСервере
Процедура РазобратьСообщения(Лог, Каталог)

	Попытка
		Файлы = НайтиФайлы(Каталог, "Message_*", Ложь);
	Исключение
		Стр(Лог, "сообщения: ошибка чтения каталога " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	Стр(Лог, "сообщений в каталоге: " + Формат(Файлы.Количество(), "ЧГ=0"));

	Для Каждого Файл Из Файлы Цикл
		Если Не Файл.ЭтоФайл() Тогда
			Продолжить;
		КонецЕсли;
		Текст = ПрочитатьТекст(Файл.ПолноеИмя);
		Стр(Лог, "  " + Файл.Имя);
		Стр(Лог, "    размер: " + Формат(Файл.Размер(), "ЧГ=0") + " байт");
		Если ПустаяСтрока(Текст) Тогда
			Стр(Лог, "    <файл не прочитан>");
			Продолжить;
		КонецЕсли;
		Если СтрНайти(Текст, "ТолькоНастройки") > 0 Тогда
			Стр(Лог, "    вид: только настройки (ТолькоНастройкиXDTO)");
		КонецЕсли;
		Стр(Лог, "    от: " + Между(Текст, "<msg:From>", "</msg:From>")
			+ ", кому: " + Между(Текст, "<msg:To>", "</msg:To>")
			+ ", сообщение №" + Между(Текст, "<msg:MessageNo>", "</msg:MessageNo>")
			+ ", принято №" + Между(Текст, "<msg:ReceivedNo>", "</msg:ReceivedNo>"));
		Стр(Лог, "    формат: " + Между(Текст, "<msg:Format>", "</msg:Format>")
			+ ", дата: " + Между(Текст, "<msg:CreationDate>", "</msg:CreationDate>"));
		Стр(Лог, "    версии в списке: " + СтрЗаменить(Между(Текст,
			"<msg:AvailableVersion>", "</msg:AvailableVersions>"), "</msg:AvailableVersion>", ","));

		Типы = Новый Соответствие;
		Кавычка = """";
		Позиция = 1;
		Пока Истина Цикл
			Позиция = СтрНайти(Текст, "<Object Тип=", , Позиция);
			Если Позиция = 0 Тогда
				Прервать;
			КонецЕсли;
			Кусок = Сред(Текст, Позиция, 200);
			ИмяТипа = Между(Кусок, "Тип=" + Кавычка, Кавычка);
			Типы.Вставить(ИмяТипа, ?(Типы.Получить(ИмяТипа) = Неопределено, 1,
				Типы.Получить(ИмяТипа) + 1));
			Позиция = Позиция + 10;
		КонецЦикла;

		Если Типы.Количество() = 0 Тогда
			Стр(Лог, "    объектов в теле: нет");
		Иначе
			Стр(Лог, "    объектов в теле: " + Формат(Типы.Количество(), "ЧГ=0") + " видов");
			Для Каждого Пара Из Типы Цикл
				Стр(Лог, "      " + Пара.Ключ + ": " + Формат(Пара.Значение, "ЧГ=0"));
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// ============================= РЕЖИМ «СОЗДАТЬ» =============================

&НаСервере
Функция РеквизитЕсть(Объект, ИмяРеквизита)
	Попытка
		Возврат Объект.Метаданные().Реквизиты.Найти(ИмяРеквизита) <> Неопределено;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

&НаСервере
Процедура УстановитьРеквизит(Объект, ИмяРеквизита, Значение)
	Если Значение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Если Объект.Метаданные().Реквизиты.Найти(ИмяРеквизита) = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Объект[ИмяРеквизита] = Значение;
	Исключение
	КонецПопытки;
КонецПроцедуры

&НаСервере
Функция ЗначениеПеречисления(ИмяПеречисления, ЧастьИмени)
	Попытка
		КоллекцияПеречисления = Метаданные["Перечисления"].Найти(ИмяПеречисления);
		Если КоллекцияПеречисления = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Для Каждого Значение Из КоллекцияПеречисления.ЗначенияПеречисления Цикл
			Если СтрНайти(ВРег(Значение.Имя), ВРег(ЧастьИмени)) > 0 Тогда
				Возврат Перечисления[ИмяПеречисления][Значение.Имя];
			КонецЕсли;
		КонецЦикла;
	Исключение
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

&НаСервере
Функция НайтиПоНаименованиюВхождение(ИмяСправочника, Наименование)
	Попытка
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка КАК Ссылка ИЗ Справочник." + ИмяСправочника
			+ " ГДЕ Наименование ПОДОБНО &Шаблон УПОРЯДОЧИТЬ ПО Наименование");
		Запрос.УстановитьПараметр("Шаблон", "%" + Наименование + "%");
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

&НаСервере
Функция НайтиНаборПоНаименованию(Наименование)
	// в демо-базе есть одноимённые позиции: товар и набор; продавать надо набор
	Ссылка = НайтиПоНаименованиюВхождение("Номенклатура", Наименование);
	Попытка
		Если Ссылка <> Неопределено И Ссылка.ТипНоменклатуры = Перечисления["ТипыНоменклатуры"]["Набор"] Тогда
			Возврат Ссылка;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Попытка
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка КАК Ссылка ИЗ Справочник.Номенклатура
			|ГДЕ Наименование ПОДОБНО &Шаблон
			|	И ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Набор)
			|УПОРЯДОЧИТЬ ПО Наименование");
		Запрос.УстановитьПараметр("Шаблон", "%" + Наименование + "%");
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	Исключение
		// в БП перечисления типов номенклатуры может не быть — остаётся обычный поиск
	КонецПопытки;
	Возврат Ссылка;
КонецФункции

&НаСервере
Функция ПерваяОрганизация(Лог = Неопределено)
	Попытка
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 5 Ссылка КАК Ссылка, Наименование КАК Наименование,
			|	ПометкаУдаления КАК ПометкаУдаления
			|ИЗ Справочник.Организации
			|УПОРЯДОЧИТЬ ПО Наименование");
		Выборка = Запрос.Выполнить().Выбрать();
		Резерв = Неопределено;
		Пока Выборка.Следующий() Цикл
			Если Лог <> Неопределено Тогда
				Стр(Лог, "  организация-кандидат: " + Выборка.Наименование
					+ ", пометка=" + ?(Выборка.ПометкаУдаления, "да", "нет"));
			КонецЕсли;
			Если Резерв = Неопределено Тогда
				Резерв = Выборка.Ссылка;
			КонецЕсли;
			Если Не Выборка.ПометкаУдаления Тогда
				Возврат Выборка.Ссылка;
			КонецЕсли;
		КонецЦикла;
		Возврат Резерв;
	Исключение
		Если Лог <> Неопределено Тогда
			Стр(Лог, "  организации: ошибка " + ОписаниеОшибки());
		КонецЕсли;
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

&НаСервере
Функция ШаблонСборки(Лог, Операция = Неопределено)
	// донором должен быть проведённый документ той же операции; если разборка
	// в базе не проводилась никогда — берём любую проведённую сборку
	Для НомерПопытки = 1 По 2 Цикл
		Попытка
			Если НомерПопытки = 1 Тогда
				Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка КАК Ссылка ИЗ Документ.СборкаТоваров
					|ГДЕ Проведен И ХозяйственнаяОперация = &Операция
					|	И Комментарий НЕ ПОДОБНО ""Живой прогон%""
					|УПОРЯДОЧИТЬ ПО Дата УБЫВ");
				Запрос.УстановитьПараметр("Операция", Операция);
			Иначе
				Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка КАК Ссылка ИЗ Документ.СборкаТоваров
					|ГДЕ Проведен И Комментарий НЕ ПОДОБНО ""Живой прогон%""
					|УПОРЯДОЧИТЬ ПО Дата УБЫВ");
			КонецЕсли;
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Если НомерПопытки = 2 Тогда
					Стр(Лог, "шаблона нужной операции нет, донор — любая проведённая сборка");
				КонецЕсли;
				Возврат Выборка.Ссылка;
			КонецЕсли;
		Исключение
			Стр(Лог, "поиск шаблона сборки: ошибка " + ОписаниеОшибки());
			Прервать;
		КонецПопытки;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

&НаСервере
Функция ОстаткиКомплекта(Номенклатура, Лог, Склад = Неопределено)
	// разборка списывает комплект: нужен склад и организация, где он в остатке
	Если Номенклатура = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		ТекстОтбора = "ГДЕ Остатки.КоличествоОстаток > 0"
			+ " И Остатки.АналитикаУчетаНоменклатуры.Номенклатура = &Номенклатура";
		Если ЗначениеЗаполнено(Склад) Тогда
			ТекстОтбора = ТекстОтбора + " И Остатки.АналитикаУчетаНоменклатуры.МестоХранения = &Склад";
		КонецЕсли;
		Запрос = Новый Запрос("ВЫБРАТЬ
			|	Остатки.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
			|	Остатки.АналитикаУчетаНоменклатуры.Характеристика КАК Характеристика,
			|	Остатки.АналитикаУчетаНоменклатуры.МестоХранения КАК Склад,
			|	Остатки.Организация КАК Организация,
			|	СУММА(Остатки.КоличествоОстаток) КАК ВНаличии
			|ИЗ РегистрНакопления.ТоварыОрганизаций.Остатки(&Дата) КАК Остатки
			|" + ТекстОтбора + "
			|СГРУППИРОВАТЬ ПО
			|	Остатки.АналитикаУчетаНоменклатуры.Номенклатура,
			|	Остатки.АналитикаУчетаНоменклатуры.Характеристика,
			|	Остатки.АналитикаУчетаНоменклатуры.МестоХранения,
			|	Остатки.Организация
			|УПОРЯДОЧИТЬ ПО ВНаличии УБЫВ");
		Запрос.УстановитьПараметр("Дата", КонецДня(ТекущаяДатаСеанса()));
		Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
		Если ЗначениеЗаполнено(Склад) Тогда
			Запрос.УстановитьПараметр("Склад", Склад);
		КонецЕсли;
		ТЗ = Запрос.Выполнить().Выгрузить();
		Если ТЗ.Количество() > 0 Тогда
			Возврат ТЗ[0];
		КонецЕсли;
		Стр(Лог, "комплекта нет в остатках ни на одном складе");
	Исключение
		Стр(Лог, "остатки комплекта: ошибка " + ОписаниеОшибки());
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

&НаСервере
Функция ИмяРеквизитаИзМассива(Коллекция, ЧастьИмени)
	// имя свойства метаданных по подстроке: в УТ и БП реквизиты называются по-разному
	Если Коллекция = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Для Каждого Свойство Из Коллекция Цикл
		Если СтрНайти(ВРег(Свойство.Имя), ВРег(ЧастьИмени)) > 0 Тогда
			Возврат Свойство.Имя;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

&НаСервере
Функция ОсновнойВариантКомплектации(Комплект, Характеристика, Лог)
	// штатный механизм УТ; метод платформы не срабатывает, когда комплект
	// — номенклатура с типом «Товар», поэтому при пустом результате ищем запросом
	Если Не МетаданныеЕсть("Справочники", "ВариантыКомплектацииНоменклатуры") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		// обращение по имени: в БП такого справочника нет, прямая ссылка не компилируется
		МенеджерВариантов = Справочники["ВариантыКомплектацииНоменклатуры"];
		Вариант = МенеджерВариантов.ПолучитьОсновнуюКомплектацию(Комплект, Характеристика);
		Если ЗначениеЗаполнено(Вариант) Тогда
			Возврат Вариант;
		КонецЕсли;
		Стр(Лог, "штатный метод вернул пустой вариант — ищем вариант владельца запросом");
	Исключение
		Стр(Лог, "основной вариант комплектации: ошибка " + ОписаниеОшибки());
	КонецПопытки;
	Попытка
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка КАК Ссылка
			|ИЗ Справочник.ВариантыКомплектацииНоменклатуры
			|ГДЕ Владелец = &Владелец
			|	И НЕ ПометкаУдаления
			|УПОРЯДОЧИТЬ ПО Основной УБЫВ, Наименование");
		Запрос.УстановитьПараметр("Владелец", Комплект);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	Исключение
		Стр(Лог, "вариант комплектации запросом: ошибка " + ОписаниеОшибки());
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

&НаСервере
Функция КомплектующиеВарианта(Вариант, Лог)
	// состав варианта вместе с долями стоимости; свой запрос, если штатный метод пуст
	Попытка
		ТЗ = Справочники["ВариантыКомплектацииНоменклатуры"].ПолучитьКомплектующиеНоменклатуры(Вариант);
		Если ТЗ <> Неопределено И ТЗ.Количество() > 0 Тогда
			Возврат ТЗ;
		КонецЕсли;
		Стр(Лог, "штатный метод вернул пустой состав — читаем ТЧ варианта");
	Исключение
		Стр(Лог, "состав варианта комплектации: ошибка " + ОписаниеОшибки());
	КонецПопытки;
	Попытка
		Запрос = Новый Запрос("ВЫБРАТЬ
			|	Состав.Номенклатура КАК Номенклатура,
			|	Состав.Характеристика КАК Характеристика,
			|	Состав.Упаковка КАК Упаковка,
			|	Состав.КоличествоУпаковок КАК КоличествоУпаковок,
			|	Состав.Количество КАК Количество,
			|	Состав.ДоляСтоимости КАК ДоляСтоимости
			|ИЗ Справочник.ВариантыКомплектацииНоменклатуры.Товары КАК Состав
			|ГДЕ Состав.Ссылка = &Вариант
			|УПОРЯДОЧИТЬ ПО Номенклатура");
		Запрос.УстановитьПараметр("Вариант", Вариант);
		Возврат Запрос.Выполнить().Выгрузить();
	Исключение
		Стр(Лог, "состав варианта запросом: ошибка " + ОписаниеОшибки());
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

&НаСервере
Процедура ОчиститьТЧ(Док, ИмяТЧ)
	Попытка
		Док[ИмяТЧ].Очистить();
	Исключение
	КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура ОчиститьРеквизит(Док, ИмяРеквизита)
	Если Не РеквизитЕсть(Док, ИмяРеквизита) Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Док[ИмяРеквизита] = Неопределено;
	Исключение
	КонецПопытки;
КонецПроцедуры

&НаСервере
Функция ПерваяХарактеристика(Номенклатура)
	Если Номенклатура = Неопределено Или Не МетаданныеЕсть("Справочники", "ХарактеристикиНоменклатуры") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка КАК Ссылка
			|ИЗ Справочник.ХарактеристикиНоменклатуры
			|ГДЕ Владелец = &Владелец И НЕ ПометкаУдаления
			|УПОРЯДОЧИТЬ ПО Наименование");
		Запрос.УстановитьПараметр("Владелец", Номенклатура);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

&НаСервере
Функция ЧислаИзСтроки(Текст)
	Результат = Новый Массив;
	Для Каждого Часть Из СтрРазделить(Текст, ",", Ложь) Цикл
		Значение = Число(СокрЛП(СтрЗаменить(Часть, ".", ",")));
		Если Значение > 0 Тогда
			Результат.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаСервере
Процедура РежимСоздать(Задание, ИмяБазы, Лог)

	Секция(Лог, "Создание документа сборки");

	Если Не МетаданныеЕсть("Документы", "СборкаТоваров") Тогда
		Стр(Лог, "документа СборкаТоваров нет — режим только для УТ");
		Возврат;
	КонецЕсли;

	МенеджерДокумента = Документы["СборкаТоваров"];

	// --- уборка непроведённых черновиков прежних попыток прогона
	Попытка
		Запрос = Новый Запрос("ВЫБРАТЬ Ссылка КАК Ссылка ИЗ Документ.СборкаТоваров
			|ГДЕ НЕ Проведен И Комментарий ПОДОБНО ""Живой прогон%""");
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			СсылкаЧерновика = Выборка.Ссылка;
			Попытка
				СсылкаЧерновика.ПолучитьОбъект().Удалить();
				Стр(Лог, "удалён непроведённый черновик: " + СтрЗнач(СсылкаЧерновика));
			Исключение
				Стр(Лог, "удаление черновика " + СтрЗнач(СсылкаЧерновика) + ": " + ОписаниеОшибки());
			КонецПопытки;
		КонецЦикла;
	Исключение
		Стр(Лог, "уборка черновиков: ошибка " + ОписаниеОшибки());
	КонецПопытки;

	// --- хозяйственная операция: сборка (по умолчанию) или разборка
	ИмяОперации = Параметр(Задание, "операция", "Сборка");
	Разборка = СтрНайти(ВРег(ИмяОперации), "РАЗБОРК") > 0;
	// значения перечисления в УТ называются СборкаТоваров / РазборкаТоваров
	ХозОперация = ЗначениеПеречисления("ХозяйственныеОперации",
		?(Разборка, "РазборкаТоваров", "СборкаТоваров"));
	Если ХозОперация = Неопределено Тогда
		Стр(Лог, "операция «" + ИмяОперации + "» в перечислении не найдена");
		Возврат;
	КонецЕсли;
	Стр(Лог, "операция по заданию: " + ИмяОперации + " -> " + СтрЗнач(ХозОперация));

	// --- комплект
	Комплект = Неопределено;
	ЗаданныйКомплект = Параметр(Задание, "номенклатура", "");
	Если Не ПустаяСтрока(ЗаданныйКомплект) Тогда
		Комплект = НайтиПоНаименованиюВхождение("Номенклатура", ЗаданныйКомплект);
		Стр(Лог, "комплект по заданию «" + ЗаданныйКомплект + "»: " + СтрЗнач(Комплект));
	КонецЕсли;

	Если Комплект = Неопределено Тогда
		ТипНабор = ЗначениеПеречисления("ТипНоменклатуры", "Набор");
		Если ТипНабор = Неопределено Тогда
			ТипНабор = ЗначениеПеречисления("ТипНоменклатуры", "Комплект");
		КонецЕсли;
		Если ТипНабор <> Неопределено Тогда
			Попытка
				Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка КАК Ссылка ИЗ Справочник.Номенклатура
					|ГДЕ ТипНоменклатуры = &Тип И НЕ ПометкаУдаления
					|УПОРЯДОЧИТЬ ПО Наименование");
				Запрос.УстановитьПараметр("Тип", ТипНабор);
				Выборка = Запрос.Выполнить().Выбрать();
				Если Выборка.Следующий() Тогда
					Комплект = Выборка.Ссылка;
				КонецЕсли;
			Исключение
				Стр(Лог, "подбор набора: ошибка " + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;

	Если Комплект = Неопределено И МетаданныеЕсть("Справочники", "ВариантыКомплектацииНоменклатуры") Тогда
		Попытка
			Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Владелец КАК Владелец ИЗ Справочник.ВариантыКомплектацииНоменклатуры
				|УПОРЯДОЧИТЬ ПО Владелец");
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Комплект = Выборка.Владелец;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;

	Если Комплект = Неопределено Тогда
		Стр(Лог, "комплект не найден: в задании нет номенклатуры, в базе нет наборов/комплектов");
		Возврат;
	КонецЕсли;
	Стр(Лог, "комплект: " + СтрЗнач(Комплект));

	// --- комплектующие с остатком (при разборке вместо них ищем остаток комплекта)
	ТаблицаКомплектующих = Новый ТаблицаЗначений;
	ТаблицаКомплектующих.Колонки.Добавить("Номенклатура");
	ТаблицаКомплектующих.Колонки.Добавить("Характеристика");
	ТаблицаКомплектующих.Колонки.Добавить("Склад");
	ТаблицаКомплектующих.Колонки.Добавить("Организация");
	ТаблицаКомплектующих.Колонки.Добавить("ВНаличии");
	ТаблицаКомплектующих.Колонки.Добавить("Количество");

	СписокИзЗадания = Параметр(Задание, "комплектующие", "");
	РежимДолей = ВРег(Параметр(Задание, "доли из", "задание"));
	ВариантКомплектации = Неопределено;
	ТЗВарианта = Неопределено;
	Если ПустаяСтрока(СписокИзЗадания) И РежимДолей = "СПЕЦИФИКАЦИЯ" Тогда
		// состав и доли берём там, где их держит УТ, — в основном варианте комплектации
		ВариантКомплектации = ОсновнойВариантКомплектации(Комплект, ПерваяХарактеристика(Комплект), Лог);
		Если ВариантКомплектации <> Неопределено Тогда
			ТЗВарианта = КомплектующиеВарианта(ВариантКомплектации, Лог);
			Если ТЗВарианта <> Неопределено Тогда
				Для Каждого СтрокаВарианта Из ТЗВарианта Цикл
					СтрокаТЗ = ТаблицаКомплектующих.Добавить();
					СтрокаТЗ.Номенклатура = СтрокаВарианта.Номенклатура;
					СтрокаТЗ.Характеристика = СтрокаВарианта.Характеристика;
					Если СтрокаВарианта.Количество > 0 Тогда
						СтрокаТЗ.Количество = СтрокаВарианта.Количество;
					КонецЕсли;
					Стр(Лог, "  из варианта комплектации: " + СтрЗнач(СтрокаВарианта.Номенклатура)
						+ ", количество " + Формат(СтрокаВарианта.Количество, "ЧДЦ=3")
						+ ", доля стоимости " + Формат(СтрокаВарианта.ДоляСтоимости, "ЧДЦ=2"));
				КонецЦикла;
				Стр(Лог, "состав взят из варианта комплектации " + СтрЗнач(ВариантКомплектации)
					+ ", строк: " + Формат(ТаблицаКомплектующих.Количество(), "ЧГ=0"));
			КонецЕсли;
		Иначе
			Стр(Лог, "основного варианта комплектации нет — состав возьмём из остатков");
		КонецЕсли;
	КонецЕсли;
	Если Разборка И ПустаяСтрока(СписокИзЗадания) И ТаблицаКомплектующих.Количество() = 0 Тогда
		// комплектующих нет ни в задании, ни в варианте — берём склад/оргу по остатку комплекта
		СтрокаОстатков = ОстаткиКомплекта(Комплект, Лог);
		Если СтрокаОстатков <> Неопределено Тогда
			СтрокаТЗ = ТаблицаКомплектующих.Добавить();
			СтрокаТЗ.Номенклатура = СтрокаОстатков.Номенклатура;
			СтрокаТЗ.Характеристика = СтрокаОстатков.Характеристика;
			СтрокаТЗ.Склад = СтрокаОстатков.Склад;
			СтрокаТЗ.Организация = СтрокаОстатков.Организация;
			СтрокаТЗ.ВНаличии = СтрокаОстатков.ВНаличии;
			Стр(Лог, "разборка: комплект в остатке " + Формат(СтрокаОстатков.ВНаличии, "ЧДЦ=3")
				+ " на складе " + СтрЗнач(СтрокаОстатков.Склад));
		КонецЕсли;
	ИначеЕсли ПустаяСтрока(СписокИзЗадания) И ТаблицаКомплектующих.Количество() = 0 Тогда
		Попытка
			Запрос = Новый Запрос("ВЫБРАТЬ
				|	Остатки.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
				|	Остатки.АналитикаУчетаНоменклатуры.Характеристика КАК Характеристика,
				|	Остатки.АналитикаУчетаНоменклатуры.МестоХранения КАК Склад,
				|	Остатки.Организация КАК Организация,
				|	СУММА(Остатки.КоличествоОстаток) КАК ВНаличии
				|ИЗ РегистрНакопления.ТоварыОрганизаций.Остатки(&Дата) КАК Остатки
				|ГДЕ Остатки.КоличествоОстаток > 0
				|	И Остатки.АналитикаУчетаНоменклатуры.Номенклатура <> &Комплект
				|СГРУППИРОВАТЬ ПО
				|	Остатки.АналитикаУчетаНоменклатуры.Номенклатура,
				|	Остатки.АналитикаУчетаНоменклатуры.Характеристика,
				|	Остатки.АналитикаУчетаНоменклатуры.МестоХранения,
				|	Остатки.Организация
				|УПОРЯДОЧИТЬ ПО ВНаличии УБЫВ");
			Запрос.УстановитьПараметр("Дата", КонецДня(ТекущаяДатаСеанса()));
			Запрос.УстановитьПараметр("Комплект", Комплект);
			ОстаткиТЗ = Запрос.Выполнить().Выгрузить();

			// сборка идёт на одном складе одной организации: ищем сочетание,
			// в котором хватает строк, и берём строки только из него
			НужноСтрок = Число(Параметр(Задание, "строк", "3"));
			Сочетания = Новый Соответствие;
			Для Каждого СтрокаОстатков Из ОстаткиТЗ Цикл
				Ключ = Строка(СтрокаОстатков.Склад) + "|" + Строка(СтрокаОстатков.Организация);
				СтрокиСочетания = Сочетания.Получить(Ключ);
				Если СтрокиСочетания = Неопределено Тогда
					СтрокиСочетания = Новый Массив;
					Сочетания.Вставить(Ключ, СтрокиСочетания);
				КонецЕсли;
				СтрокиСочетания.Добавить(СтрокаОстатков);
			КонецЦикла;

			ЛучшееСочетание = Неопределено;
			Для Каждого Сочетание Из Сочетания Цикл
				Если ЛучшееСочетание = Неопределено
					Или Сочетание.Значение.Количество() > ЛучшееСочетание.Значение.Количество() Тогда
					ЛучшееСочетание = Сочетание;
				КонецЕсли;
			КонецЦикла;

			Если ЛучшееСочетание <> Неопределено Тогда
				СтрокиСочетания = ЛучшееСочетание.Значение;
				Стр(Лог, "сочетание склад+организация: " + ЛучшееСочетание.Ключ
					+ ", строк с остатком: " + Формат(СтрокиСочетания.Количество(), "ЧГ=0"));
				Индекс = 0;
				Для Каждого ВыборкаСтрока Из СтрокиСочетания Цикл
					Если Индекс >= НужноСтрок Тогда
						Прервать;
					КонецЕсли;
					СтрокаТЗ = ТаблицаКомплектующих.Добавить();
					СтрокаТЗ.Номенклатура = ВыборкаСтрока.Номенклатура;
					СтрокаТЗ.Характеристика = ВыборкаСтрока.Характеристика;
					СтрокаТЗ.Склад = ВыборкаСтрока.Склад;
					СтрокаТЗ.Организация = ВыборкаСтрока.Организация;
					СтрокаТЗ.ВНаличии = ВыборкаСтрока.ВНаличии;
					Индекс = Индекс + 1;
				КонецЦикла;
			КонецЕсли;
		Исключение
			Стр(Лог, "подбор комплектующих: ошибка " + ОписаниеОшибки());
		КонецПопытки;
	Иначе
		Для Каждого Имя Из СтрРазделить(СписокИзЗадания, ",", Ложь) Цикл
			Номенклатура = НайтиПоНаименованиюВхождение("Номенклатура", СокрЛП(Имя));
			Если Номенклатура = Неопределено Тогда
				Стр(Лог, "комплектующая «" + СокрЛП(Имя) + "» не найдена");
				Продолжить;
			КонецЕсли;
			СтрокаТЗ = ТаблицаКомплектующих.Добавить();
			СтрокаТЗ.Номенклатура = Номенклатура;
		КонецЦикла;
	КонецЕсли;

	Если ТаблицаКомплектующих.Количество() = 0 Тогда
		Стр(Лог, "комплектующие не найдены — создавать нечего");
		Возврат;
	КонецЕсли;
	Стр(Лог, "комплектующих строк: " + Формат(ТаблицаКомплектующих.Количество(), "ЧГ=0"));

	// склад и организацию берём из остатков: для сборки — по первой комплектующей,
	// для разборки — по остатку комплекта, который списывается
	Если Не ЗначениеЗаполнено(ТаблицаКомплектующих[0].Склад) Тогда
		// склад можно задать прямо: остаток по регистру не учитывает резервы
		ИмяСклада = Параметр(Задание, "склад", "");
		СкладИзЗадания = ?(ПустаяСтрока(ИмяСклада), Неопределено, НайтиПоНаименованиюВхождение("Склады", ИмяСклада));
		Если ЗначениеЗаполнено(СкладИзЗадания) Тогда
			ТаблицаКомплектующих[0].Склад = СкладИзЗадания;
			// организацию берём из остатка на этом складе, чтобы не подставить чужую
			СтрокаСклада = ОстаткиКомплекта(?(Разборка, Комплект, ТаблицаКомплектующих[0].Номенклатура), Лог, СкладИзЗадания);
			Если СтрокаСклада <> Неопределено Тогда
				ТаблицаКомплектующих[0].Организация = СтрокаСклада.Организация;
			КонецЕсли;
			Стр(Лог, "склад из задания: " + СтрЗнач(СкладИзЗадания));
		Иначе
			СтрокаМеста = ОстаткиКомплекта(?(Разборка, Комплект, ТаблицаКомплектующих[0].Номенклатура), Лог);
			Если СтрокаМеста <> Неопределено Тогда
				ТаблицаКомплектующих[0].Склад = СтрокаМеста.Склад;
				ТаблицаКомплектующих[0].Организация = СтрокаМеста.Организация;
				Стр(Лог, "склад по остатку: " + СтрЗнач(СтрокаМеста.Склад));
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	// --- доли стоимости
	Доли = ЧислаИзСтроки(Параметр(Задание, "доли", "50,30,20"));
	Если РежимДолей = "СПЕЦИФИКАЦИЯ" И ТЗВарианта <> Неопределено
		И ТЗВарианта.Количество() = ТаблицаКомплектующих.Количество() Тогда
		// доли из варианта комплектации: проверяем, что УТ их не обнулила
		Доли = Новый Массив;
		Для ИндексДоли = 0 По ТЗВарианта.Количество() - 1 Цикл
			Доли.Добавить(ТЗВарианта[ИндексДоли].ДоляСтоимости);
		КонецЦикла;
		Стр(Лог, "доли взяты из варианта комплектации");
	ИначеЕсли Доли.Количество() <> ТаблицаКомплектующих.Количество() Тогда
		Доли = Новый Массив;
		Равная = Окр(100 / ТаблицаКомплектующих.Количество(), 2);
		Для ИндексДоли = 1 По ТаблицаКомплектующих.Количество() Цикл
			Доли.Добавить(Равная);
		КонецЦикла;
	КонецЕсли;

	// --- документ: основа — копия проведённого документа той же операции, иначе с нуля
	Док = Неопределено;
	Шаблон = ШаблонСборки(Лог, ХозОперация);
	Если ЗначениеЗаполнено(Шаблон) Тогда
		Док = Шаблон.ПолучитьОбъект().Скопировать();
		// операцию ставим до заполнения ТЧ: от неё зависит, что заполнит Заполнить()
		УстановитьРеквизит(Док, "ХозяйственнаяОперация", ХозОперация);
		Док.Товары.Очистить();
		ОчиститьТЧ(Док, "ВидыЗапасовСписание");
		ОчиститьТЧ(Док, "ВидыЗапасовОприходование");
		ОчиститьТЧ(Док, "Серии");
		ОчиститьТЧ(Док, "ШтрихкодыУпаковок");
		Для Каждого ИмяРеквизита Из СтрРазделить("Характеристика,Назначение,Серия,Упаковка,"
			+ "КоличествоУпаковок,ВариантКомплектации,ЗаказНаСборку,Сделка,НоменклатураОсновногоКомпонента,"
			+ "ХарактеристикаОсновногоКомпонента,ИсправляемыйДокумент,СторнируемыйДокумент", ",") Цикл
			ОчиститьРеквизит(Док, ИмяРеквизита);
		КонецЦикла;
		Стр(Лог, "документ создан копией шаблона " + СтрЗнач(Шаблон));
	Иначе
		Док = МенеджерДокумента.СоздатьДокумент();
		Стр(Лог, "документ создан с нуля: проведённого шаблона в базе нет");
	КонецЕсли;
	Док.Дата = ТекущаяДатаСеанса();
	Организация = ТаблицаКомплектующих[0].Организация;
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Организация = ПерваяОрганизация(Лог);
	КонецЕсли;
	Стр(Лог, "организация: " + СтрЗнач(Организация));
	УстановитьРеквизит(Док, "Организация", Организация);
	УстановитьРеквизит(Док, "Склад", ТаблицаКомплектующих[0].Склад);
	УстановитьРеквизит(Док, "Номенклатура", Комплект);
	УстановитьРеквизит(Док, "Количество", 1);
	УстановитьРеквизит(Док, "Комментарий", "Живой прогон обмена УТ -> БП "
		+ Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-dd HH:mm"));
	УстановитьРеквизит(Док, "ХозяйственнаяОперация", ХозОперация);
	Стр(Лог, "хозяйственная операция: " + СтрЗнач(ХозОперация));
	Если ВариантКомплектации <> Неопределено Тогда
		// в БП документа СборкаТоваров нет — идём через метаданные по имени
		МетаданныеСборки = Метаданные["Документы"].Найти("СборкаТоваров");
		Если МетаданныеСборки = Неопределено Тогда
			ИмяВарианта = "";
		Иначе
			ИмяВарианта = ИмяРеквизитаИзМассива(МетаданныеСборки.Реквизиты, "ВариантКомплектации");
		КонецЕсли;
		Если Не ПустаяСтрока(ИмяВарианта) Тогда
			УстановитьРеквизит(Док, ИмяВарианта, ВариантКомплектации);
			Стр(Лог, "вариант комплектации: " + СтрЗнач(ВариантКомплектации));
		КонецЕсли;
	КонецЕсли;
	СтатусСборки = ЗначениеПеречисления("СтатусыСборокТоваров", "СобраноРазобрано");
	УстановитьРеквизит(Док, "Статус", СтатусСборки);
	Стр(Лог, "статус сборки: " + СтрЗнач(СтатусСборки));

	ХарактеристикаКомплекта = ПерваяХарактеристика(Комплект);
	Если ЗначениеЗаполнено(ХарактеристикаКомплекта) Тогда
		УстановитьРеквизит(Док, "Характеристика", ХарактеристикаКомплекта);
		Стр(Лог, "характеристика комплекта: " + СтрЗнач(ХарактеристикаКомплекта));
	Иначе
		Стр(Лог, "характеристика комплекта: нет");
	КонецЕсли;

	ИндексДоли = 0;
	Для Каждого СтрокаТЗ Из ТаблицаКомплектующих Цикл
		СтрокаДокумента = Док.Товары.Добавить();
		СтрокаДокумента.Номенклатура = СтрокаТЗ.Номенклатура;
		КоличествоСтроки = 1;
		Попытка
			Если СтрокаТЗ.Количество > 0 Тогда
				КоличествоСтроки = СтрокаТЗ.Количество;
			КонецЕсли;
		Исключение
		КонецПопытки;
		СтрокаДокумента.Количество = КоличествоСтроки;
		УстановитьРеквизитСтроки(СтрокаДокумента, "ДоляСтоимости", Доли[ИндексДоли]);
		Попытка
			Стр(Лог, "  доля в строку записано: " + СтрЗнач(СтрокаДокумента.ДоляСтоимости));
		Исключение
			Стр(Лог, "  доля в строку: колонки ДоляСтоимости нет");
		КонецПопытки;
		Характеристика = СтрокаТЗ.Характеристика;
		Если Не ЗначениеЗаполнено(Характеристика) Тогда
			Характеристика = ПерваяХарактеристика(СтрокаТЗ.Номенклатура);
		КонецЕсли;
		Если ЗначениеЗаполнено(Характеристика) Тогда
			УстановитьРеквизитСтроки(СтрокаДокумента, "Характеристика", Характеристика);
		КонецЕсли;
		Стр(Лог, "  строка " + Формат(ИндексДоли + 1, "ЧГ=0") + ": " + СтрЗнач(СтрокаТЗ.Номенклатура)
			+ ", количество " + Формат(КоличествоСтроки, "ЧДЦ=3")
			+ ", доля " + Формат(Доли[ИндексДоли], "ЧДЦ=2") + ", характеристика " + СтрЗнач(Характеристика));
		ИндексДоли = ИндексДоли + 1;
	КонецЦикла;

	Попытка
		Док.ЗаполнитьАналитикиУчетаНоменклатуры();
		Стр(Лог, "аналитики учёта номенклатуры заполнены");
	Исключение
		Стр(Лог, "аналитики учёта номенклатуры: ошибка " + ОписаниеОшибки());
	КонецПопытки;

	Проведен = Ложь;
	Попытка
		Док.Записать(РежимЗаписиДокумента.Запись);
		Стр(Лог, "документ записан: " + СтрЗнач(Док.Ссылка));
		// что осталось в строках после ПередЗаписью: УТ обнуляет доли на сборке
		Попытка
			Для ИндексПроверки = 0 По Док.Товары.Количество() - 1 Цикл
				СтрокаПроверки = Док.Товары[ИндексПроверки];
				Стр(Лог, "  после записи строка " + Формат(ИндексПроверки + 1, "ЧГ=0") + ": доля "
					+ СтрЗнач(СтрокаПроверки.ДоляСтоимости)
					+ ", аналитика " + СтрЗнач(СтрокаПроверки.АналитикаУчетаНоменклатуры));
			КонецЦикла;
		Исключение
			Стр(Лог, "проверка строк после записи: ошибка " + ОписаниеОшибки());
		КонецПопытки;
	Исключение
		Стр(Лог, "ошибка записи документа: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	Попытка
		Док.Записать(РежимЗаписиДокумента.Проведение);
		Проведен = Истина;
		Стр(Лог, "документ проведён");
	Исключение
		СведенияОбОшибке = ИнформацияОбОшибке();
		Стр(Лог, "проведение не удалось: " + ПодробноеПредставлениеОшибки(СведенияОбОшибке));
		Стр(Лог, "  описание: " + СведенияОбОшибке.Описание);
		Стр(Лог, "  место: " + СтрЗнач(СведенияОбОшибке.ИмяМодуля) + ", строка "
			+ Формат(СведенияОбОшибке.НомерСтроки, "ЧГ=0"));
		Стр(Лог, "  исходная строка: " + СведенияОбОшибке.ИсходнаяСтрока);
		// вторая попытка — как при загрузке данных: часть проверок УТ пропускается
		Попытка
			Док.ОбменДанными.Загрузка = Истина;
			Док.Записать(РежимЗаписиДокумента.Проведение);
			Проведен = Истина;
			Стр(Лог, "документ проведён в режиме загрузки данных");
		Исключение
			Стр(Лог, "проведение в режиме загрузки тоже не удалось: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Попытка
				Док.Записать(РежимЗаписиДокумента.Запись);
			Исключение
			КонецПопытки;
		КонецПопытки;
	КонецПопытки;

	// --- регистрация изменений для узла
	Узел = УзелКорреспондента(Задание, Лог, Ложь);
	Если Узел = Неопределено Тогда
		Стр(Лог, "узел не найден — регистрация изменений не выполнена");
		Возврат;
	КонецЕсли;

	Попытка
		Ссылки = Новый Массив;
		Ссылки.Добавить(Док.Ссылка);
		ПланыОбмена.ЗарегистрироватьИзменения(Узел, Ссылки);
		Стр(Лог, "изменения зарегистрированы для узла " + СтрЗнач(Узел));
	Исключение
		Стр(Лог, "регистрация изменений: ошибка " + ОписаниеОшибки());
	КонецПопытки;

	Стр(Лог, "проведён: " + ?(Проведен, "да", "нет"));

КонецПроцедуры

&НаСервере
Процедура УстановитьРеквизитСтроки(Строка, ИмяРеквизита, Значение)
	Попытка
		Строка[ИмяРеквизита] = Значение;
	Исключение
	КонецПопытки;
КонецПроцедуры

// ============================ РЕЖИМ «ПРОДАЖА» ==============================

&НаСервере
Процедура РежимНабор(Задание, ИмяБазы, Лог)
	// Стендовое создание набора в УТ: номенклатура с типом «Набор» и вариант
	// комплектации с составом. Состав задаётся через «;»: «Кровать=1;Шкаф=1».
	// Нужен для проверок, где набора в базе ещё нет (смешанный НДС и т. п.).

	Секция(Лог, "Создание набора");

	Если Не МетаданныеЕсть("Справочники", "ВариантыКомплектацииНоменклатуры") Тогда
		Стр(Лог, "вариантов комплектации нет — режим только для УТ");
		Возврат;
	КонецЕсли;

	ИмяНабора = СокрЛП(Параметр(Задание, "набор", ""));
	Если ПустаяСтрока(ИмяНабора) Тогда
		Стр(Лог, "не задано имя набора (параметр «набор»)");
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка КАК Ссылка
	|ИЗ Справочник.Номенклатура КАК Н
	|ГДЕ Н.Наименование = &Имя
	|	И Н.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Набор)");
	Запрос.УстановитьПараметр("Имя", ИмяНабора);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Ном = Выборка.Ссылка.ПолучитьОбъект();
		Стр(Лог, "набор уже есть: " + СтрЗнач(Ном.Ссылка));
	Иначе
		Ном = Справочники["Номенклатура"].СоздатьЭлемент();
		Ном.Наименование = ИмяНабора;
		Ном.ТипНоменклатуры = Перечисления["ТипыНоменклатуры"]["Набор"];
	КонецЕсли;
	Вид = НайтиПоНаименованиюВхождение("ВидыНоменклатуры",
		Параметр(Задание, "вид", "Мебельный гарнитур (набор мебели)"));
	Если Вид = Неопределено Тогда
		Стр(Лог, "вид номенклатуры-набора не найден");
		Возврат;
	КонецЕсли;
	УстановитьРеквизит(Ном, "ВидНоменклатуры", Вид);
	// у набора единица «компл»: с «шт» штатное разложение падает на цене
	Единица = НайтиТочноПоНаименованию("УпаковкиЕдиницыИзмерения", Параметр(Задание, "единица", "компл"));
	Если Единица = Неопределено Тогда
		Единица = ЕдиницаПоУмолчанию(Лог);
	КонецЕсли;
	УстановитьРеквизит(Ном, "ЕдиницаИзмерения", Единица);
	УстановитьРеквизит(Ном, "СтавкаНДС", НайтиТочноПоНаименованию("СтавкиНДС", "20%"));
	Попытка
		Ном.Записать();
	Исключение
		Стр(Лог, "номенклатура не записана: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	Набор = Ном.Ссылка;
	Стр(Лог, "набор: " + СтрЗнач(Набор) + ", единица " + СтрЗнач(Единица));

	// вариант комплектации с составом
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка КАК Ссылка
	|ИЗ Справочник.ВариантыКомплектацииНоменклатуры КАК ВР
	|ГДЕ ВР.Владелец = &Набор И ВР.ПометкаУдаления = ЛОЖЬ");
	Запрос.УстановитьПараметр("Набор", Набор);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Вариант = Выборка.Ссылка.ПолучитьОбъект();
		Стр(Лог, "вариант уже есть: " + СтрЗнач(Вариант.Ссылка));
	Иначе
		Вариант = Справочники["ВариантыКомплектацииНоменклатуры"].СоздатьЭлемент();
		Вариант.Владелец = Набор;
		Вариант.Наименование = Параметр(Задание, "вариант", "Состав набора");
	КонецЕсли;
	Вариант.Товары.Очистить();
	// без способа расчёта цены штатное разложение уходит в ветку, где нужна
	// цена за набор, и падает — «Object field not found (Цена)»
	УстановитьРеквизит(Вариант, "ВариантРасчетаЦеныНабора",
		Перечисления["ВариантыРасчетаЦенНаборов"]["РассчитываетсяИзЦенКомплектующих"]);

	Для Каждого Часть Из СтрРазделить(Параметр(Задание, "состав", ""), ";", Ложь) Цикл
		Кусочки = СтрРазделить(Часть, "=", Ложь);
		Если Кусочки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		ИмяТовара = СокрЛП(Кусочки[0]);
		Если ПустаяСтрока(ИмяТовара) Тогда
			Продолжить;
		КонецЕсли;
		Товар = НайтиПоНаименованиюВхождение("Номенклатура", ИмяТовара);
		Если Товар = Неопределено Тогда
			Стр(Лог, "  товар не найден: " + ИмяТовара);
			Продолжить;
		КонецЕсли;
		Количество = 1;
		Если Кусочки.Количество() > 1 Тогда
			Количество = Число(СтрЗаменить(СокрЛП(Кусочки[1]), ".", ","));
		КонецЕсли;
		СтрокаВарианта = Вариант.Товары.Добавить();
		СтрокаВарианта.Номенклатура = Товар;
		СтрокаВарианта.Количество = Количество;
		// без количества упаковок штатное разложение падает на цене
		// («Object field not found (Цена)»)
		УстановитьРеквизитСтроки(СтрокаВарианта, "КоличествоУпаковок", Количество);
		// доли в наборе не нужны: в БП они считаются по составу продажи
		Попытка
			СтрокаВарианта.ДоляСтоимости = 0;
		Исключение
		КонецПопытки;
		Стр(Лог, "  состав: " + СтрЗнач(Товар) + " x " + Формат(Количество, "ЧДЦ=3")
			+ " (НДС " + СтрЗнач(Товар.СтавкаНДС) + ")");
	КонецЦикла;

	Попытка
		Вариант.Записать();
		Стр(Лог, "вариант записан: " + СтрЗнач(Вариант.Ссылка));
	Исключение
		Стр(Лог, "вариант не записан: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	Стр(Лог, "итог: набор «" + СтрЗнач(Набор) + "», вариант «" + СтрЗнач(Вариант.Ссылка)
		+ "», строк состава " + Формат(Вариант.Товары.Количество(), "ЧГ=0"));

КонецПроцедуры

&НаСервере
Процедура РежимПродажа(Задание, ИмяБазы, Лог)
	// продажа набора: строки получаем штатным механизмом УТ
	// «НаборыВызовСервера.Комплектующие» — так же, как это делает форма документа

	Секция(Лог, "Продажа набора");
	Прогресс(ИмяБазы, "ПРОДАЖА", "старт");

	Если Не МетаданныеЕсть("Документы", "РеализацияТоваровУслуг")
		Или Не МетаданныеЕсть("ОбщиеМодули", "НаборыВызовСервера") Тогда
		Стр(Лог, "нет документа РеализацияТоваровУслуг или модуля НаборыВызовСервера — режим только для УТ");
		Возврат;
	КонецЕсли;

	Набор = НайтиНаборПоНаименованию(Параметр(Задание, "набор", ""));
	Если Набор = Неопределено Тогда
		Стр(Лог, "набор не найден");
		Возврат;
	КонецЕсли;
	Стр(Лог, "набор: " + СтрЗнач(Набор) + ", тип номенклатуры: " + СтрЗнач(Набор.ТипНоменклатуры));
	Прогресс(ИмяБазы, "ПРОДАЖА", "набор найден");

	Склад = НайтиПоНаименованиюВхождение("Склады", Параметр(Задание, "склад", ""));
	Орг = НайтиПоНаименованиюВхождение("Организации", Параметр(Задание, "организация", ""));
	Партнер = НайтиПоНаименованиюВхождение("Партнеры", Параметр(Задание, "партнер", ""));
	Контрагент = НайтиПоНаименованиюВхождение("Контрагенты", Параметр(Задание, "контрагент", ""));
	ВидЦены = НайтиПоНаименованиюВхождение("ВидыЦен", Параметр(Задание, "видцены", "Розничная"));
	Стр(Лог, "склад: " + СтрЗнач(Склад) + "; организация: " + СтрЗнач(Орг));
	Стр(Лог, "партнёр: " + СтрЗнач(Партнер) + "; контрагент: " + СтрЗнач(Контрагент)
		+ "; вид цены: " + СтрЗнач(ВидЦены));

	// --- разложение набора на комплектующие штатным механизмом УТ
	ПараметрыНабора = Новый Структура;
	ПараметрыНабора.Вставить("НоменклатураНабора", Набор);
	// характеристики и варианты комплектации есть только в УТ — ссылки берём по имени
	ХарактеристикаПустая = Неопределено;
	Если МетаданныеЕсть("Справочники", "ХарактеристикиНоменклатуры") Тогда
		ХарактеристикаПустая = Справочники["ХарактеристикиНоменклатуры"].ПустаяСсылка();
	КонецЕсли;
	ПараметрыНабора.Вставить("ХарактеристикаНабора", ХарактеристикаПустая);
	ПараметрыНабора.Вставить("КоличествоУпаковок", Число(Параметр(Задание, "количество", "1")));
	ПараметрыНабора.Вставить("Склад", Склад);
	// модуль обращается к полю напрямую — пустая ссылка = вариант по умолчанию
	ПараметрыНабора.Вставить("ВариантКомплектацииНоменклатуры",
		Справочники["ВариантыКомплектацииНоменклатуры"].ПустаяСсылка());

	Валюта = Неопределено;
	Попытка
		Валюта = Справочники.Валюты.НайтиПоКоду("643");
	Исключение
		Валюта = Неопределено;
	КонецПопытки;

	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Дата", ТекущаяДатаСеанса());
	ДопПараметры.Вставить("ВидЦены", ВидЦены);
	ДопПараметры.Вставить("Валюта", Валюта);
	ДопПараметры.Вставить("Организация", Орг);
	МассивСкладов = Новый Массив;
	МассивСкладов.Добавить(Склад);
	ДопПараметры.Вставить("Склады", МассивСкладов);

	// набор разлагается общим модулем УТ; в БП его нет, поэтому вызов по имени
	ПараметрыВызова = Новый Массив;
	ПараметрыВызова.Добавить(ПараметрыНабора);
	ПараметрыВызова.Добавить(ДопПараметры);
	Попытка
		СтрокиНабора = ОбщегоНазначения.ВыполнитьМетодКонфигурации(
			"НаборыВызовСервера.Комплектующие", ПараметрыВызова, Истина);
	Исключение
		Стр(Лог, "НаборыВызовСервера.Комплектующие: ошибка " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	Прогресс(ИмяБазы, "ПРОДАЖА", "комплектующие получены: " + Формат(СтрокиНабора.Количество(), "ЧГ=0"));
	Стр(Лог, "комплектующих получилось: " + Формат(СтрокиНабора.Количество(), "ЧГ=0"));
	Если СтрокиНабора.Количество() = 0 Тогда
		Стр(Лог, "документ не создаю");
		Возврат;
	КонецЕсли;

	// --- документ продажи
	Док = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
	Док.Дата = ТекущаяДатаСеанса();
	Док.Организация = Орг;
	Док.Партнер = Партнер;
	Док.Контрагент = Контрагент;
	Док.Склад = Склад;
	Док.ХозяйственнаяОперация = Перечисления["ХозяйственныеОперации"]["РеализацияКлиенту"];
	Док.ЦенаВключаетНДС = Истина;
	Док.НалогообложениеНДС = Перечисления["ТипыНалогообложенияНДС"]["ПродажаОблагаетсяНДС"];
	Док.Комментарий = "Живой прогон: продажа набора " + Набор;
	// шапка как у типовой реализации: без валюты/соглашения проведение не проходит
	УстановитьРеквизитСтроки(Док, "Валюта", Валюта);
	УстановитьРеквизитСтроки(Док, "ВалютаВзаиморасчетов", Валюта);
	УстановитьРеквизитСтроки(Док, "Статус", Перечисления["СтатусыРеализацийТоваровУслуг"]["Отгружено"]);
	Соглашение = НайтиПоНаименованиюВхождение("СоглашенияСКлиентами", Параметр(Задание, "соглашение", "Оптовые продажи (предоплата)"));
	Подразделение = НайтиПоНаименованиюВхождение("СтруктураПредприятия", Параметр(Задание, "подразделение", "Отдел маркетинга"));
	УстановитьРеквизитСтроки(Док, "Соглашение", Соглашение);
	УстановитьРеквизитСтроки(Док, "Подразделение", Подразделение);
	Стр(Лог, "соглашение: " + СтрЗнач(Соглашение) + "; подразделение: " + СтрЗнач(Подразделение)
		+ "; валюта: " + СтрЗнач(Валюта));
	Прогресс(ИмяБазы, "ПРОДАЖА", "шапка заполнена");

	Цены = СтрРазделить(Параметр(Задание, "цены", ""), ",", Ложь);
	// смешанный НДС в одном наборе: ставки по строкам через запятую (20,10).
	// Пусто — ставка берётся из разложения набора (у комплектующих она своя),
	// а если и там пусто — 20%.
	СтавкиЗадания = СтрРазделить(Параметр(Задание, "ставки", ""), ",", Ложь);
	Номер = 0;
	ВсегоСумма = 0;
	// в УТ ставка НДС — это справочник (в БП — перечисление)
	Ставка20 = НайтиТочноПоНаименованию("СтавкиНДС", "20%");
	Стр(Лог, "ставка по умолчанию: " + СтрЗнач(Ставка20));
	Для Каждого ПараметрыТовара Из СтрокиНабора Цикл
		НоваяСтрока = Док.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ПараметрыТовара);
		УстановитьРеквизитСтроки(НоваяСтрока, "Склад", Склад);
		УстановитьРеквизитСтроки(НоваяСтрока, "ВидЦены", ВидЦены);
		Если Номер < Цены.Количество() Тогда
			НоваяСтрока.Цена = Число(СтрЗаменить(СокрЛП(Цены[Номер]), ".", ","));
		КонецЕсли;
		НоваяСтрока.Сумма = НоваяСтрока.Цена * НоваяСтрока.Количество;
		// ставка строки: задание → разложение набора → 20%
		СтавкаСтроки = Неопределено;
		Если Номер < СтавкиЗадания.Количество() Тогда
			ИмяСтавки = СокрЛП(СтавкиЗадания[Номер]);
			СтавкаСтроки = НайтиТочноПоНаименованию("СтавкиНДС", ИмяСтавки);
			Если СтавкаСтроки = Неопределено Тогда
				СтавкаСтроки = НайтиТочноПоНаименованию("СтавкиНДС", ИмяСтавки + "%");
			КонецЕсли;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтавкаСтроки) Тогда
			// ставка из карточки товара: в строке ТЧ она может остаться
			// пустой или подставиться по умолчанию (20%)
			Попытка
				СтавкаСтроки = НоваяСтрока.Номенклатура.СтавкаНДС;
			Исключение
				СтавкаСтроки = Неопределено;
			КонецПопытки;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтавкаСтроки) Тогда
			Попытка
				СтавкаСтроки = НоваяСтрока.СтавкаНДС;
			Исключение
				СтавкаСтроки = Неопределено;
			КонецПопытки;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтавкаСтроки) Тогда
			СтавкаСтроки = Ставка20;
		КонецЕсли;
		Процент = ПроцентСтавкиНДС(СтавкаСтроки);
		УстановитьРеквизитСтроки(НоваяСтрока, "СуммаНДС", Окр(НоваяСтрока.Сумма * Процент / (100 + Процент), 2));
		УстановитьРеквизитСтроки(НоваяСтрока, "СтавкаНДС", СтавкаСтроки);
		// УТ считает сумму документа по СуммаСНДС. Расчётная ставка («20/120»,
		// «10/110») означает, что НДС уже внутри суммы, — тогда СуммаСНДС = Сумма.
		// Обычная ставка («20%») начисляется сверху: СуммаСНДС = Сумма + НДС.
		СуммаСНДС = ?(СтрНайти(Строка(СтавкаСтроки), "/") > 0,
			НоваяСтрока.Сумма, НоваяСтрока.Сумма + НоваяСтрока.СуммаНДС);
		УстановитьРеквизитСтроки(НоваяСтрока, "СуммаСНДС", СуммаСНДС);
		ВсегоСумма = ВсегоСумма + НоваяСтрока.Сумма;
		Номер = Номер + 1;
		Стр(Лог, "  строка " + Формат(Номер, "ЧГ=0") + ": " + СтрЗнач(НоваяСтрока.Номенклатура)
			+ " | набор: " + СтрЗнач(НоваяСтрока.НоменклатураНабора)
			+ " | кол-во " + Формат(НоваяСтрока.Количество, "ЧДЦ=3")
			+ " | цена " + Формат(НоваяСтрока.Цена, "ЧДЦ=2")
			+ " | сумма " + Формат(НоваяСтрока.Сумма, "ЧДЦ=2"));
	КонецЦикла;

	// --- услуга: в УТ услуги лежат в той же ТЧ «Товары», различаются типом
	ИмяУслуги = Параметр(Задание, "услуга", "");
	Если Не ПустаяСтрока(ИмяУслуги) Тогда
		Услуга = НайтиПоНаименованиюВхождение("Номенклатура", ИмяУслуги);
		Если Услуга = Неопределено Тогда
			Стр(Лог, "услуга не найдена: " + ИмяУслуги);
		Иначе
			ЦенаУслуги = Число(СтрЗаменить(СокрЛП(Параметр(Задание, "ценауслуги", "1000")), ".", ","));
			НоваяСтрока = Док.Товары.Добавить();
			НоваяСтрока.Номенклатура = Услуга;
			НоваяСтрока.Количество = 1;
			УстановитьРеквизитСтроки(НоваяСтрока, "Склад", Склад);
			УстановитьРеквизитСтроки(НоваяСтрока, "ВидЦены", ВидЦены);
			НоваяСтрока.Цена = ЦенаУслуги;
			НоваяСтрока.Сумма = ЦенаУслуги;
			УстановитьРеквизитСтроки(НоваяСтрока, "СуммаНДС", Окр(ЦенаУслуги * 20 / 120, 2));
			УстановитьРеквизитСтроки(НоваяСтрока, "СтавкаНДС", Ставка20);
			УстановитьРеквизитСтроки(НоваяСтрока, "СуммаСНДС", ЦенаУслуги + Окр(ЦенаУслуги * 20 / 120, 2));
			ВсегоСумма = ВсегоСумма + ЦенаУслуги;
			Стр(Лог, "  услуга: " + СтрЗнач(Услуга)
				+ " | тип " + СтрЗнач(Услуга.ТипНоменклатуры)
				+ " | сумма " + Формат(ЦенаУслуги, "ЧДЦ=2"));
		КонецЕсли;
	КонецЕсли;

	// без этого УТ отказывает в проведении: «не рассчитаны автоматические скидки»
	УстановитьРеквизитСтроки(Док, "СкидкиРассчитаны", Истина);
	// итоги документа УТ по строкам не пересчитывает
	УстановитьРеквизитСтроки(Док, "СуммаДокумента", ВсегоСумма);
	УстановитьРеквизитСтроки(Док, "СуммаВзаиморасчетов", ВсегоСумма);
	Стр(Лог, "итог по строкам: " + Формат(ВсегоСумма, "ЧДЦ=2"));
	Прогресс(ИмяБазы, "ПРОДАЖА", "строки заполнены: " + Формат(Док.Товары.Количество(), "ЧГ=0"));
	Попытка
		Док.Записать(РежимЗаписиДокумента.Запись);
		Стр(Лог, "записан: " + СтрЗнач(Док.Ссылка));
		Стр(Лог, "шапка после записи: сумма " + Формат(Док.СуммаДокумента, "ЧДЦ=2")
			+ ", валюта " + СтрЗнач(Док.Валюта)
			+ ", валюта взаиморасчётов " + СтрЗнач(Док.ВалютаВзаиморасчетов)
			+ ", соглашение " + СтрЗнач(Док.Соглашение)
			+ ", договор " + СтрЗнач(Док.Договор)
			+ ", статус " + СтрЗнач(Док.Статус));
		Прогресс(ИмяБазы, "ПРОДАЖА", "записан");
	Исключение
		Стр(Лог, "запись не удалась: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	Прогресс(ИмяБазы, "ПРОДАЖА", "провожу");
	Попытка
		Док.Записать(РежимЗаписиДокумента.Проведение);
		Стр(Лог, "проведён");
		Прогресс(ИмяБазы, "ПРОДАЖА", "проведён");
	Исключение
		СведенияОбОшибке = ИнформацияОбОшибке();
		Стр(Лог, "проведение не удалось: " + ПодробноеПредставлениеОшибки(СведенияОбОшибке));
		ВывестиСообщенияПользователю(Лог);
		Попытка
			Док.ОбменДанными.Загрузка = Ложь;
			Док.Записать(РежимЗаписиДокумента.Запись);
			Стр(Лог, "документ остаётся записанным, но не проведённым");
		Исключение
			Стр(Лог, "повторная запись не удалась: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецПопытки;

	// --- регистрация изменений для узла
	Узел = УзелКорреспондента(Задание, Лог, Ложь);
	Если Узел <> Неопределено Тогда
		Попытка
			Ссылки = Новый Массив;
			Ссылки.Добавить(Док.Ссылка);
			ПланыОбмена.ЗарегистрироватьИзменения(Узел, Ссылки);
			Стр(Лог, "изменения зарегистрированы для узла " + СтрЗнач(Узел));
		Исключение
			Стр(Лог, "регистрация изменений: ошибка " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;

	// --- что записалось в документ
	Секция(Лог, "Строки документа после записи");
	Попытка
		Запрос = Новый Запрос("ВЫБРАТЬ
			|	Т.НомерСтроки КАК НС,
			|	Т.Номенклатура КАК Ном,
			|	Т.НоменклатураНабора КАК Набор,
			|	Т.Характеристика КАК Хар,
			|	Т.Количество КАК Кол,
			|	Т.Цена КАК Цена,
			|	Т.Сумма КАК Сумма,
			|	Т.СтавкаНДС КАК НДС,
			|	Т.Склад КАК Склад
			|ИЗ Документ.РеализацияТоваровУслуг.Товары КАК Т
			|ГДЕ Т.Ссылка = &Ссылка
			|УПОРЯДОЧИТЬ ПО НС");
		Запрос.УстановитьПараметр("Ссылка", Док.Ссылка);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Стр(Лог, "  " + Формат(Выборка.НС, "ЧГ=0") + ". " + СтрЗнач(Выборка.Ном)
				+ " | набор " + СтрЗнач(Выборка.Набор)
				+ " | кол " + Формат(Выборка.Кол, "ЧДЦ=3")
				+ " | сумма " + Формат(Выборка.Сумма, "ЧДЦ=2")
				+ " | НДС " + СтрЗнач(Выборка.НДС)
				+ " | склад " + СтрЗнач(Выборка.Склад));
		КонецЦикла;
	Исключение
		Стр(Лог, "чтение строк документа: ошибка " + ОписаниеОшибки());
	КонецПопытки;

	// --- движения по регистрам накопления
	Секция(Лог, "Движения документа по регистрам накопления");
	Для Каждого ИмяРегистра Из СтрРазделить("ТоварыОрганизаций,ЗапасыИПотребности,ВыручкаИСебестоимостьПродаж", ",") Цикл
		Попытка
			МетаданныеРегистра = Метаданные.РегистрыНакопления.Найти(ИмяРегистра);
			Если МетаданныеРегистра = Неопределено Тогда
				Стр(Лог, "  " + ИмяРегистра + ": регистра нет");
				Продолжить;
			КонецЕсли;
			ИменаПолей = Новый Массив;
			Для Каждого Измерение Из МетаданныеРегистра.Измерения Цикл
				ИменаПолей.Добавить(Измерение.Имя);
			КонецЦикла;
			Для Каждого Ресурс Из МетаданныеРегистра.Ресурсы Цикл
				ИменаПолей.Добавить(Ресурс.Имя);
			КонецЦикла;
			Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 20 " + СтрСоединить(ИменаПолей, ", ")
				+ " ИЗ РегистрНакопления." + ИмяРегистра + " КАК Р ГДЕ Р.Регистратор = &Ссылка");
			Запрос.УстановитьПараметр("Ссылка", Док.Ссылка);
			Таблица = Запрос.Выполнить().Выгрузить();
			Стр(Лог, "  " + ИмяРегистра + ": записей " + Формат(Таблица.Количество(), "ЧГ=0"));
			Для Каждого СтрокаТЗ Из Таблица Цикл
				ТекстСтроки = "";
				Для Каждого Колонка Из Таблица.Колонки Цикл
					ТекстСтроки = ТекстСтроки + " | " + Колонка.Имя + "=" + СтрЗнач(СтрокаТЗ[Колонка.Имя]);
				КонецЦикла;
				Стр(Лог, "    " + ТекстСтроки);
			КонецЦикла;
		Исключение
			Стр(Лог, "  " + ИмяРегистра + ": ошибка " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

	// --- аналитика наборов: ключ, который поедет в обмен
	Секция(Лог, "Регистр сведений АналитикаУчетаНаборов по набору");
	Попытка
		Запрос = Новый Запрос("ВЫБРАТЬ
			|	А.НоменклатураНабора КАК Набор,
			|	А.ХарактеристикаНабора КАК Хар,
			|	А.КлючАналитики КАК Ключ
			|ИЗ РегистрСведений.АналитикаУчетаНаборов КАК А
			|ГДЕ А.НоменклатураНабора = &Набор");
		Запрос.УстановитьПараметр("Набор", Набор);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Стр(Лог, "  " + СтрЗнач(Выборка.Набор) + " / " + СтрЗнач(Выборка.Хар)
				+ " -> ключ " + СтрЗнач(Выборка.Ключ));
		КонецЦикла;
	Исключение
		Стр(Лог, "чтение АналитикаУчетаНаборов: ошибка " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// ============================= РЕЖИМ «СОСТАВ» ==============================

&НаСервере
Процедура ВывестиСоставВарианта(Объект, Лог)
	Попытка
		Для Каждого СтрокаСостава Из Объект.Товары Цикл
			Стр(Лог, "  " + СтрЗнач(СтрокаСостава.Номенклатура)
				+ " | кол " + Формат(СтрокаСостава.Количество, "ЧДЦ=3")
				+ " | доля " + Формат(СтрокаСостава.ДоляСтоимости, "ЧДЦ=2"));
		КонецЦикла;
	Исключение
		Стр(Лог, "состав не прочитан: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура РежимСостав(Задание, ИмяБазы, Лог)
	// правка состава варианта комплектации: стенд для ТК-14, где две продажи
	// одного набора должны получить разный состав

	Секция(Лог, "Правка состава варианта комплектации");
	Прогресс(ИмяБазы, "СОСТАВ", "старт");

	Если Не МетаданныеЕсть("Справочники", "ВариантыКомплектацииНоменклатуры") Тогда
		Стр(Лог, "справочника вариантов комплектации нет — режим только для УТ");
		Возврат;
	КонецЕсли;

	Набор = НайтиНаборПоНаименованию(Параметр(Задание, "набор", ""));
	Если Набор = Неопределено Тогда
		Стр(Лог, "набор не найден");
		Возврат;
	КонецЕсли;
	Стр(Лог, "набор: " + СтрЗнач(Набор));

	ИмяВарианта = Параметр(Задание, "вариант", "");
	Если Не ПустаяСтрока(ИмяВарианта) Тогда
		Вариант = НайтиПоНаименованиюВхождение("ВариантыКомплектацииНоменклатуры", ИмяВарианта);
	Иначе
		Вариант = ОсновнойВариантКомплектации(Набор, ПерваяХарактеристика(Набор), Лог);
	КонецЕсли;
	Если Вариант = Неопределено Тогда
		Стр(Лог, "вариант комплектации не найден");
		Возврат;
	КонецЕсли;
	Стр(Лог, "вариант: " + СтрЗнач(Вариант));

	Объект = Вариант.ПолучитьОбъект();
	Секция(Лог, "Состав до правки");
	ВывестиСоставВарианта(Объект, Лог);

	Для Каждого ИмяУдаляемое Из СтрРазделить(Параметр(Задание, "удалить", ""), ";", Ложь) Цикл
		ИмяУдаляемое = СокрЛП(ИмяУдаляемое);
		Если ПустаяСтрока(ИмяУдаляемое) Тогда
			Продолжить;
		КонецЕсли;
		Удаляемая = НайтиПоНаименованиюВхождение("Номенклатура", ИмяУдаляемое);
		// строки сначала собираем, удаляем после обхода: удалять элемент
		// коллекции внутри «Для каждого» нельзя
		СтрокиПодУдаление = Новый Массив;
		Для Каждого СтрокаСостава Из Объект.Товары Цикл
			Если Удаляемая <> Неопределено И СтрокаСостава.Номенклатура = Удаляемая Тогда
				СтрокиПодУдаление.Добавить(СтрокаСостава);
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Для Каждого СтрокаСостава Из СтрокиПодУдаление Цикл
			Объект.Товары.Удалить(СтрокаСостава);
		КонецЦикла;
		Нашлась = СтрокиПодУдаление.Количество() > 0;
		Если Нашлась Тогда
			Стр(Лог, "удалена строка: " + ИмяУдаляемое);
		КонецЕсли;
		Если Не Нашлась Тогда
			Стр(Лог, "строка для удаления не найдена: " + ИмяУдаляемое);
		КонецЕсли;
	КонецЦикла;

	Для Каждого Пара Из СтрРазделить(Параметр(Задание, "количество", ""), ";", Ложь) Цикл
		Части = СтрРазделить(Пара, "=", Ложь);
		Если Части.Количество() < 2 Тогда
			Стр(Лог, "пропущена пара количества: " + Пара);
			Продолжить;
		КонецЕсли;
		Ном = НайтиПоНаименованиюВхождение("Номенклатура", СокрЛП(Части[0]));
		НовоеКоличество = Число(СтрЗаменить(СокрЛП(Части[1]), ".", ","));
		Нашлась = Ложь;
		Для Каждого СтрокаСостава Из Объект.Товары Цикл
			Если Ном <> Неопределено И СтрокаСостава.Номенклатура = Ном Тогда
				Стр(Лог, "количество " + СтрЗнач(Ном) + ": "
					+ Формат(СтрокаСостава.Количество, "ЧДЦ=3") + " -> "
					+ Формат(НовоеКоличество, "ЧДЦ=3"));
				СтрокаСостава.Количество = НовоеКоличество;
				Нашлась = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не Нашлась Тогда
			Стр(Лог, "строка не найдена: " + СокрЛП(Части[0]));
		КонецЕсли;
	КонецЦикла;

	Попытка
		Объект.Записать();
		Стр(Лог, "вариант записан: " + СтрЗнач(Объект.Ссылка));
	Исключение
		Стр(Лог, "запись варианта: ошибка " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Секция(Лог, "Состав после правки");
	ВывестиСоставВарианта(Объект, Лог);

КонецПроцедуры

// ============================= РЕЖИМ «ПРИХОД» ==============================

&НаСервере
Функция НайтиТочноПоНаименованию(ИмяСправочника, Наименование)
	// поиск по вхождению путает «20%» и «20/120» — здесь нужно точное имя
	Попытка
		Возврат Справочники[ИмяСправочника].НайтиПоНаименованию(Наименование, Истина);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

&НаСервере
Функция ПроцентСтавкиНДС(Ставка)
	// «20%» -> 20, «10%» -> 10, «20/120» -> 20, «НДС 20%» (БП) -> 20.
	// В УТ ставка — элемент справочника, в БП — перечисление, поэтому имя
	// приходится разбирать, а не брать реквизит.
	Если Не ЗначениеЗаполнено(Ставка) Тогда
		Возврат 0;
	КонецЕсли;
	Текст = Строка(Ставка);
	Цифры = "";
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если Символ = "/" Тогда
			Прервать;
		КонецЕсли;
		Если Символ = "," Тогда
			Цифры = Цифры + ".";
		ИначеЕсли Символ >= "0" И Символ <= "9" Тогда
			Цифры = Цифры + Символ;
		КонецЕсли;
	КонецЦикла;
	Если ПустаяСтрока(Цифры) Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Возврат Число(Цифры);
	Исключение
		Возврат 0;
	КонецПопытки;
КонецФункции

&НаСервере
Функция ЕдиницаПоУмолчанию(Лог)
	// Первая непустая единица измерения из справочника номенклатуры: тип
	// реквизита зависит от конфигурации, поэтому не создаём ссылку вручную.
	Результат = Неопределено;
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 50
		|	Н.ЕдиницаИзмерения КАК Единица
		|ИЗ
		|	Справочник.Номенклатура КАК Н";
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если ЗначениеЗаполнено(Выборка.Единица) Тогда
				Результат = Выборка.Единица;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	Исключение
		Стр(Лог, "единица по умолчанию: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат Результат;
КонецФункции

&НаСервере
Процедура РежимЕдиницы(Задание, ИмяБазы, Лог)
	// Починка приходов, созданных до правки режима ПРИХОД: в строках нет
	// единицы измерения, и выгрузка БП падает с XDTO-ошибкой
	// «Value required for one of the following properties: ЕдиницаИзмерения».
	// Сообщение при этом не создаётся, а в лог обмена попадает только
	// «отказ: да» — причину видно лишь в журнале регистрации.

	Секция(Лог, "Заполнение единиц измерения в приходах");

	Если Не МетаданныеЕсть("Документы", "ОприходованиеТоваров") Тогда
		Стр(Лог, "документа ОприходованиеТоваров нет");
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ОприходованиеТоваров КАК Док
	|ГДЕ
	|	Док.Дата > ДАТАВРЕМЯ(2026, 10, 31)";
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Стр(Лог, "запрос: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	Пока Выборка.Следующий() Цикл
		Попытка
			Объект = Выборка.Ссылка.ПолучитьОбъект();
		Исключение
			Стр(Лог, "объект не получен: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Продолжить;
		КонецПопытки;

		Заполнено = 0;
		Для Каждого Строка Из Объект.Товары Цикл
			Требует = Ложь;
			Попытка
				Требует = Не ЗначениеЗаполнено(Строка.ЕдиницаИзмерения);
			Исключение
				Требует = Ложь;
			КонецПопытки;
			Если Требует Тогда
				Попытка
					Строка.ЕдиницаИзмерения = Строка.Номенклатура.ЕдиницаИзмерения;
				Исключение
				КонецПопытки;
				Попытка
					// у служебных позиций стенда единица не заполнена и в карточке
					Если Не ЗначениеЗаполнено(Строка.ЕдиницаИзмерения) Тогда
						Строка.ЕдиницаИзмерения = ЕдиницаПоУмолчанию(Лог);
					КонецЕсли;
					Если ЗначениеЗаполнено(Строка.ЕдиницаИзмерения) Тогда
						Заполнено = Заполнено + 1;
					КонецЕсли;
				Исключение
					Стр(Лог, "единица не заполнена: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;

		Стр(Лог, СтрЗнач(Выборка.Ссылка) + ": заполнено единиц " + Формат(Заполнено, "ЧГ=0"));
		Если Заполнено > 0 Тогда
			Попытка
				Объект.ОбменДанными.Загрузка = Ложь;
				Объект.Записать(РежимЗаписиДокумента.Проведение);
				Стр(Лог, "  записан и проведён");
			Исключение
				Попытка
					Объект.Записать(РежимЗаписиДокумента.Запись);
					Стр(Лог, "  записан без проведения: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
				Исключение
					Стр(Лог, "  запись не удалась: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
				КонецПопытки;
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура РежимПриход(Задание, ИмяБазы, Лог)
	// оприходование комплектующих в БП: нужно, чтобы сборка получила стоимость,
	// а продажа — ненулевую себестоимость

	Секция(Лог, "Оприходование комплектующих");
	Прогресс(ИмяБазы, "ПРИХОД", "старт");

	Если Не МетаданныеЕсть("Документы", "ОприходованиеТоваров") Тогда
		Стр(Лог, "документа ОприходованиеТоваров нет — режим для БП");
		Возврат;
	КонецЕсли;
	ИмяДокумента = "ОприходованиеТоваров";

	Орг = НайтиПоНаименованиюВхождение("Организации", Параметр(Задание, "организация", ""));
	Если Орг = Неопределено Тогда
		Орг = ПерваяОрганизация(Лог);
	КонецЕсли;
	Склад = НайтиПоНаименованиюВхождение("Склады", Параметр(Задание, "склад", "Основной склад"));
	Стр(Лог, "организация: " + СтрЗнач(Орг) + "; склад: " + СтрЗнач(Склад));
	Если Орг = Неопределено Или Склад = Неопределено Тогда
		Стр(Лог, "не найдены организация или склад");
		Возврат;
	КонецЕсли;

	Док = Документы[ИмяДокумента].СоздатьДокумент();
	Док.Дата = Дата(Параметр(Задание, "дата", "20261101090000"));
	Док.Организация = Орг;
	Док.Склад = Склад;
	Док.Комментарий = Параметр(Задание, "комментарий", "Приход комплектующих для проверки себестоимости");

	Счет41 = Неопределено;
	Попытка
		Если Метаданные.ПланыСчетов.Найти("Хозрасчетный") <> Неопределено Тогда
			Счет41 = ПланыСчетов["Хозрасчетный"].НайтиПоКоду("41.01");
		КонецЕсли;
	Исключение
	КонецПопытки;
	Стр(Лог, "счёт учёта: " + СтрЗнач(Счет41));

	СуммаДокумента = 0;
	// формат: «Номенклатура=Количество@Цена» через точку с запятой
	Для Каждого Пара Из СтрРазделить(Параметр(Задание, "товары", ""), ";", Ложь) Цикл
		Части = СтрРазделить(Пара, "=", Ложь);
		Если Части.Количество() < 2 Тогда
			Стр(Лог, "пропущена пара: " + Пара);
			Продолжить;
		КонецЕсли;
		Ном = НайтиПоНаименованиюВхождение("Номенклатура", СокрЛП(Части[0]));
		Если Ном = Неопределено Тогда
			Стр(Лог, "номенклатура не найдена: " + СокрЛП(Части[0]));
			Продолжить;
		КонецЕсли;
		ЦенаКоличество = СтрРазделить(Части[1], "@", Ложь);
		Количество = Число(СтрЗаменить(СокрЛП(ЦенаКоличество[0]), ".", ","));
		Цена = ?(ЦенаКоличество.Количество() > 1,
			Число(СтрЗаменить(СокрЛП(ЦенаКоличество[1]), ".", ",")), 0);
		НоваяСтрока = Док.Товары.Добавить();
		НоваяСтрока.Номенклатура = Ном;
		НоваяСтрока.Количество = Количество;
		НоваяСтрока.Цена = Цена;
		НоваяСтрока.Сумма = Количество * Цена;
		УстановитьРеквизитСтроки(НоваяСтрока, "СчетУчета", Счет41);
		// Без единицы измерения строка не проходит XDTO-проверку схемы
		// EnterpriseData: выгрузка БП падает на первом же таком приходе и
		// сообщение не создаётся вовсе. Ошибка видна только в журнале
		// регистрации («Value required … ЕдиницаИзмерения»).
		Единица = Неопределено;
		Попытка
			Единица = Ном.ЕдиницаИзмерения;
		Исключение
		КонецПопытки;
		Если Не ЗначениеЗаполнено(Единица) Тогда
			Единица = ЕдиницаПоУмолчанию(Лог);
		КонецЕсли;
		Если ЗначениеЗаполнено(Единица) Тогда
			УстановитьРеквизитСтроки(НоваяСтрока, "ЕдиницаИзмерения", Единица);
		Иначе
			Стр(Лог, "  единица измерения не найдена — строка не пройдёт выгрузку");
		КонецЕсли;
		СуммаДокумента = СуммаДокумента + НоваяСтрока.Сумма;
		Стр(Лог, "  " + СтрЗнач(Ном) + " | кол " + Формат(Количество, "ЧДЦ=3")
			+ " | цена " + Формат(Цена, "ЧДЦ=2")
			+ " | сумма " + Формат(НоваяСтрока.Сумма, "ЧДЦ=2"));
	КонецЦикла;

	Если Док.Товары.Количество() = 0 Тогда
		Стр(Лог, "строк нет — документ не создаю");
		Возврат;
	КонецЕсли;
	УстановитьРеквизитСтроки(Док, "СуммаДокумента", СуммаДокумента);
	Стр(Лог, "сумма документа: " + Формат(СуммаДокумента, "ЧДЦ=2"));

	Попытка
		Док.Записать(РежимЗаписиДокумента.Проведение);
		Стр(Лог, "проведён: " + СтрЗнач(Док.Ссылка));
	Исключение
		Стр(Лог, "проведение не удалось: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Попытка
			Док.ОбменДанными.Загрузка = Ложь;
			Док.Записать(РежимЗаписиДокумента.Запись);
			Стр(Лог, "документ записан без проведения");
		Исключение
			Стр(Лог, "запись не удалась: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецПопытки;

КонецПроцедуры

// ============================ РЕЖИМ «ПРОВЕСТИ» =============================

&НаСервере
Процедура РежимПровести(Задание, ИмяБазы, Лог)

	Секция(Лог, "Проведение полученных документов");

	ИмяИскомого = Параметр(Задание, "документ", "");
	Если ПустаяСтрока(ИмяИскомого) Тогда
		Если МетаданныеЕсть("Документы", "КомплектацияНоменклатуры") Тогда
			ИмяИскомого = "КомплектацияНоменклатуры";
		Иначе
			ИмяИскомого = "СборкаТоваров";
		КонецЕсли;
	КонецЕсли;
	Стр(Лог, "документ: " + ИмяИскомого);

	Если Не МетаданныеЕсть("Документы", ИмяИскомого) Тогда
		Стр(Лог, "документа нет в конфигурации");
		Возврат;
	КонецЕсли;

	// перепроведение конкретных документов по номерам: нужно после оприходования
	// комплектующих, чтобы сборки пересчитали стоимость
	Номера = Параметр(Задание, "номера", "");
	Если Не ПустаяСтрока(Номера) Тогда
		Для Каждого Номер Из СтрРазделить(Номера, ";", Ложь) Цикл
			ИскомыйНомер = СокрЛП(Номер);
			Если ПустаяСтрока(ИскомыйНомер) Тогда
				Продолжить;
			КонецЕсли;
			Попытка
				Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка КАК Ссылка ИЗ Документ." + ИмяИскомого
					+ " ГДЕ Номер = &Номер И Дата > ДАТАВРЕМЯ(2026, 10, 31)
					|УПОРЯДОЧИТЬ ПО Дата УБЫВ");
				Запрос.УстановитьПараметр("Номер", ИскомыйНомер);
				Выборка = Запрос.Выполнить().Выбрать();
				Если Не Выборка.Следующий() Тогда
					Стр(Лог, ИскомыйНомер + ": документ не найден");
					Продолжить;
				КонецЕсли;
				Ссылка = Выборка.Ссылка;
				Стр(Лог, "--- " + СтрЗнач(Ссылка));
				Объект = Ссылка.ПолучитьОбъект();
				Объект.Записать(РежимЗаписиДокумента.Проведение);
				Стр(Лог, "  проведён заново");
			Исключение
				Стр(Лог, ИскомыйНомер + ": ошибка проведения: " + ОписаниеОшибки());
				ВывестиСообщенияПользователю(Лог);
			КонецПопытки;
		КонецЦикла;
		Возврат;
	КонецЕсли;

	Попытка
		Отбор = Параметр(Задание, "отбор", "");
		Если Не ПустаяСтрока(Отбор) Тогда
			Отбор = " И (" + Отбор + ")";
		КонецЕсли;
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 10 Ссылка КАК Ссылка ИЗ Документ." + ИмяИскомого
			+ " ГДЕ НЕ Проведен" + Отбор + " УПОРЯДОЧИТЬ ПО Дата УБЫВ");
		Выборка = Запрос.Выполнить().Выбрать();
		Найдено = Новый Массив;
		Пока Выборка.Следующий() Цикл
			Найдено.Добавить(Выборка.Ссылка);
		КонецЦикла;
	Исключение
		Стр(Лог, "ошибка поиска непроведённых: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	Стр(Лог, "непроведённых найдено: " + Формат(Найдено.Количество(), "ЧГ=0"));
	Если Найдено.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Ссылка Из Найдено Цикл
		Стр(Лог, "--- " + СтрЗнач(Ссылка));
		Попытка
			Объект = Ссылка.ПолучитьОбъект();
			Объект.Записать(РежимЗаписиДокумента.Проведение);
			Стр(Лог, "  проведён");
		Исключение
			Стр(Лог, "  ошибка проведения: " + ОписаниеОшибки());
			ВывестиСообщенияПользователю(Лог);
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

// ============================== РЕЖИМ «СНИМОК» ==============================

&НаСервере
Процедура СнимокДокумента(Лог, ИмяДокумента, ПоляШапки, ИмяТаблицы, ПоляТаблицы, Предел = 5)

	Если Не МетаданныеЕсть("Документы", ИмяДокумента) Тогда
		Возврат;
	КонецЕсли;
	Стр(Лог, "документ " + ИмяДокумента + ":");

	СписокПолей = СтрРазделить(ПоляШапки, ",", Ложь);
	ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ " + Формат(Предел, "ЧГ=0") + " " + ПоляШапки
		+ " ИЗ Документ." + ИмяДокумента + " УПОРЯДОЧИТЬ ПО Дата УБЫВ";

	Попытка
		Запрос = Новый Запрос(ТекстЗапроса);
		Выборка = Запрос.Выполнить().Выбрать();
		Есть = Ложь;
		Пока Выборка.Следующий() Цикл
			Есть = Истина;
			Части = Новый Массив;
			Для Каждого Поле Из СписокПолей Цикл
				Части.Добавить(СокрЛП(Поле) + "=" + СтрЗнач(Выборка[СокрЛП(Поле)]));
			КонецЦикла;
			Стр(Лог, "  * " + СтрСоединить(Части, "; "));
			СнимокТабличнойЧасти(Лог, "Документ." + ИмяДокумента, Выборка.Ссылка, ИмяТаблицы, ПоляТаблицы);
		КонецЦикла;
		Если Не Есть Тогда
			Стр(Лог, "  <пусто>");
		КонецЕсли;
	Исключение
		Стр(Лог, "  ошибка чтения: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура СнимокТабличнойЧасти(Лог, ПолноеИмяОбъекта, Ссылка, ИмяТаблицы, ПоляТаблицы)
	Если ПустаяСтрока(ИмяТаблицы) Тогда
		Возврат;
	КонецЕсли;
	Попытка
		СписокПолей = СтрРазделить(ПоляТаблицы, ",", Ложь);
		Запрос = Новый Запрос("ВЫБРАТЬ " + ПоляТаблицы + " ИЗ " + ПолноеИмяОбъекта + "." + ИмяТаблицы
			+ " ГДЕ Ссылка = &Ссылка");
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Части = Новый Массив;
			Для Каждого Поле Из СписокПолей Цикл
				Части.Добавить(СокрЛП(Поле) + "=" + СтрЗнач(Выборка[СокрЛП(Поле)]));
			КонецЦикла;
			Стр(Лог, "      " + СтрСоединить(Части, "; "));
		КонецЦикла;
	Исключение
		Стр(Лог, "      ошибка чтения таблицы " + ИмяТаблицы + ": " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура СнимокСправочника(Лог, ИмяСправочника, Поля, ИмяТаблицы, ПоляТаблицы, Предел = 10)

	Если Не МетаданныеЕсть("Справочники", ИмяСправочника) Тогда
		Возврат;
	КонецЕсли;
	Стр(Лог, "справочник " + ИмяСправочника + ":");
	Попытка
		СписокПолей = СтрРазделить(Поля, ",", Ложь);
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ " + Формат(Предел, "ЧГ=0") + " " + Поля
			+ " ИЗ Справочник." + ИмяСправочника + " УПОРЯДОЧИТЬ ПО Наименование");
		Выборка = Запрос.Выполнить().Выбрать();
		Есть = Ложь;
		Пока Выборка.Следующий() Цикл
			Есть = Истина;
			Части = Новый Массив;
			Для Каждого Поле Из СписокПолей Цикл
				Части.Добавить(СокрЛП(Поле) + "=" + СтрЗнач(Выборка[СокрЛП(Поле)]));
			КонецЦикла;
			Стр(Лог, "  * " + СтрСоединить(Части, "; "));
			Если Не ПустаяСтрока(ИмяТаблицы) Тогда
				СнимокТабличнойЧасти(Лог, "Справочник." + ИмяСправочника, Выборка.Ссылка, ИмяТаблицы, ПоляТаблицы);
			КонецЕсли;
		КонецЦикла;
		Если Не Есть Тогда
			Стр(Лог, "  <пусто>");
		КонецЕсли;
	Исключение
		Стр(Лог, "  ошибка чтения: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура СнимокПроводок(Лог)

	Стр(Лог, "проводки РегистрБухгалтерии.Хозрасчетный:");
	Попытка
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 40
			|	Хозрасчетный.Регистратор КАК Регистратор,
			|	Хозрасчетный.СчетДт КАК СчетДт,
			|	Хозрасчетный.СчетКт КАК СчетКт,
			|	Хозрасчетный.СубконтоДт1 КАК СубконтоДт1,
			|	Хозрасчетный.СубконтоКт1 КАК СубконтоКт1,
			|	Хозрасчетный.Сумма КАК Сумма,
			|	Хозрасчетный.Количество КАК Количество,
			|	Хозрасчетный.Содержание КАК Содержание
			|ИЗ РегистрБухгалтерии.Хозрасчетный КАК Хозрасчетный
			|ГДЕ Хозрасчетный.Регистратор В (
			|		ВЫБРАТЬ ПЕРВЫЕ 10 Ссылка ИЗ Документ.КомплектацияНоменклатуры
			|			УПОРЯДОЧИТЬ ПО Дата УБЫВ)
			|	ИЛИ Хозрасчетный.Регистратор В (
			|		ВЫБРАТЬ ПЕРВЫЕ 10 Ссылка ИЗ Документ.ПоступлениеТоваровУслуг
			|			УПОРЯДОЧИТЬ ПО Дата УБЫВ)
			|УПОРЯДОЧИТЬ ПО Период УБЫВ");
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Стр(Лог, "  " + СтрЗнач(Выборка.Регистратор) + ": Дт " + СтрЗнач(Выборка.СчетДт)
				+ " [" + СтрЗнач(Выборка.СубконтоДт1) + "] Кт " + СтрЗнач(Выборка.СчетКт)
				+ " [" + СтрЗнач(Выборка.СубконтоКт1) + "] сумма " + СтрЗнач(Выборка.Сумма)
				+ " кол " + СтрЗнач(Выборка.Количество) + " (" + СтрЗнач(Выборка.Содержание) + ")");
		КонецЦикла;
	Исключение
		Стр(Лог, "  ошибка чтения проводок: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура РежимСнимок(Задание, ИмяБазы, Лог)

	Секция(Лог, "Узлы и состояние обмена");
	ИнфоУзлы(ИмяПланаОбмена(Задание), Задание, Лог);
	ИнфоСостояние(Задание, Лог);

	Секция(Лог, "Документы обмена");
	СнимокДокумента(Лог, "СборкаТоваров",
		"Ссылка, Дата, Номер, ХозяйственнаяОперация, Номенклатура, Количество, Склад, Организация, Проведен",
		"Товары", "Номенклатура, Количество, ДоляСтоимости, АналитикаУчетаНоменклатуры", 3);

	СнимокДокумента(Лог, "КомплектацияНоменклатуры",
		"Ссылка, Дата, Номер, ВидОперации, Номенклатура, Количество, Склад, Организация, Проведен",
		"Комплектующие",
		"Номенклатура, Количество, ДоляСтоимости, СчетУчета, Сумма, Себестоимость", 3);

	Секция(Лог, "Справочники");
	СнимокСправочника(Лог, "СпецификацииНоменклатуры", "Ссылка, Номенклатура, Количество",
		"ИсходныеКомплектующие", "Номенклатура, Количество", 5);

	СнимокСправочника(Лог, "ВариантыКомплектацииНоменклатуры", "Ссылка, Владелец, Количество, Основной",
		"Товары", "Номенклатура, Количество, ДоляСтоимости", 5);

	Секция(Лог, "Проводки");
	СнимокПроводок(Лог);

	Секция(Лог, "Файлы в каталоге обмена");
	Для Каждого Файл Из ФайлыОбмена(КаталогФайлов(Задание)) Цикл
		Стр(Лог, "  " + Файл);
	КонецЦикла;

	Секция(Лог, "Счётчики");
	Для Каждого Имя Из СтрРазделить("СборкаТоваров,КомплектацияНоменклатуры", ",") Цикл
		Если МетаданныеЕсть("Документы", Имя) Тогда
			Стр(Лог, "документ " + Имя + ": всего "
				+ КоличествоЗаписей("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего ИЗ Документ." + Имя));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура РежимЗапрос(Задание, ИмяБазы, Лог)

	Текст = Параметр(Задание, "код", "");
	Если ПустаяСтрока(Текст) Тогда
		Стр(Лог, "пустой текст запроса (параметр «код»)");
		Возврат;
	КонецЕсли;

	Секция(Лог, "Результат запроса");
	Попытка
		Запрос = Новый Запрос(Текст);
		// виртуальные таблицы требуют момент времени: параметр &Дата подставляем сами
		Если СтрНайти(ВРег(Текст), "&ДАТА") > 0 Тогда
			// срез по конец сегодняшнего дня; отдельного параметра даты в задании нет
			ДатаСреза = КонецДня(ТекущаяДатаСеанса());
			Запрос.УстановитьПараметр("Дата", ДатаСреза);
			Стр(Лог, "момент среза: " + Формат(ДатаСреза, "ДФ=yyyy-MM-dd HH:mm:ss"));
		КонецЕсли;
		Таблица = Запрос.Выполнить().Выгрузить();
	Исключение
		Стр(Лог, "ошибка запроса: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	Стр(Лог, "строк: " + Формат(Таблица.Количество(), "ЧГ=0"));
	Для Каждого СтрокаТЗ Из Таблица Цикл
		ТекстСтроки = "";
		Для Каждого Колонка Из Таблица.Колонки Цикл
			ТекстСтроки = ТекстСтроки + " | " + Колонка.Имя + "=" + СтрЗнач(СтрокаТЗ[Колонка.Имя]);
		КонецЦикла;
		Стр(Лог, " " + ТекстСтроки);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура РежимПолитика(Задание, ИмяБазы, Лог)

	Секция(Лог, "Учетная политика на 2026 год");

	ИмяОрг = Параметр(Задание, "организация", "");
	Орг = НайтиПоНаименованиюВхождение("Организации", ИмяОрг);
	Если Орг = Неопределено Тогда
		Стр(Лог, "организация «" + ИмяОрг + "» не найдена");
		Возврат;
	КонецЕсли;
	Стр(Лог, "организация: " + СтрЗнач(Орг));

	Период = Дата(2026, 1, 1);
	Есть = Ложь;
	Попытка
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 СпособОценкиМПЗ КАК Способ ИЗ РегистрСведений.УчетнаяПолитика
			|ГДЕ Период = &Период И Организация = &Орг");
		Запрос.УстановитьПараметр("Период", Период);
		Запрос.УстановитьПараметр("Орг", Орг);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Есть = ЗначениеЗаполнено(Выборка.Способ);
		КонецЕсли;
	Исключение
		Стр(Лог, "чтение политики: " + ОписаниеОшибки());
	КонецПопытки;
	Если Есть Тогда
		Стр(Лог, "политика на 01.01.2026 уже есть — ничего не меняю");
		Возврат;
	КонецЕсли;
	Стр(Лог, "политики на 01.01.2026 нет (или она пустая) — записываю");

	ИмяДонора = Параметр(Задание, "донор", "");
	Донор = Неопределено;
	Если Не ПустаяСтрока(ИмяДонора) Тогда
		Донор = НайтиПоНаименованиюВхождение("Организации", ИмяДонора);
	Иначе
		Попытка
			Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Организация КАК Организация
				|ИЗ РегистрСведений.УчетнаяПолитика
				|ГДЕ Период <= &Период И Организация <> &Орг
				|УПОРЯДОЧИТЬ ПО Период УБЫВ");
			Запрос.УстановитьПараметр("Период", Период);
			Запрос.УстановитьПараметр("Орг", Орг);
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Донор = Выборка.Организация;
			КонецЕсли;
		Исключение
			Стр(Лог, "поиск донора: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	Если Донор = Неопределено Тогда
		Стр(Лог, "нет организации-донора с заполненной политикой");
		Возврат;
	КонецЕсли;
	Стр(Лог, "донор: " + СтрЗнач(Донор));

	Попытка
		Запрос = Новый Запрос("ВЫБРАТЬ * ИЗ РегистрСведений.УчетнаяПолитика.СрезПоследних(&Период, Организация = &Орг)");
		Запрос.УстановитьПараметр("Период", Период);
		Запрос.УстановитьПараметр("Орг", Донор);
		ТаблицаДонора = Запрос.Выполнить().Выгрузить();
		Если ТаблицаДонора.Количество() = 0 Тогда
			Стр(Лог, "у донора нет записей на эту дату");
			Возврат;
		КонецЕсли;
		СтрокаДонора = ТаблицаДонора[0];
		Менеджер = РегистрыСведений.УчетнаяПолитика.СоздатьМенеджерЗаписи();
		Для Каждого Колонка Из ТаблицаДонора.Колонки Цикл
			Если Колонка.Имя = "Период" Или Колонка.Имя = "Организация" Тогда
				Продолжить;
			КонецЕсли;
			Попытка
				Менеджер[Колонка.Имя] = СтрокаДонора[Колонка.Имя];
			Исключение
			КонецПопытки;
		КонецЦикла;
		Менеджер.Период = Период;
		Менеджер.Организация = Орг;
		Менеджер.Записать();
		Стр(Лог, "записана политика на 01.01.2026: способ оценки МПЗ = " + СтрЗнач(Менеджер.СпособОценкиМПЗ));
	Исключение
		Стр(Лог, "запись политики: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// ============================ РЕЖИМ «ИЗМЕНИТЬ» =============================

&НаСервере
Функция КоличествоСтрокТоваров(Объект)

	Попытка
		Возврат Объект.Товары.Количество();
	Исключение
	КонецПопытки;
	Попытка
		Возврат Объект.Комплектующие.Количество();
	Исключение
	КонецПопытки;
	Возврат 0;

КонецФункции

&НаСервере
Процедура РежимИзменить(Задание, ИмяБазы, Лог)

	Секция(Лог, "Правка переданного документа");

	ИмяИскомого = Параметр(Задание, "документ", "СборкаТоваров");
	Если Не МетаданныеЕсть("Документы", ИмяИскомого) Тогда
		Стр(Лог, "документа " + ИмяИскомого + " в конфигурации нет");
		Возврат;
	КонецЕсли;

	НомерИскомый = Параметр(Задание, "номер", "");
	Если ПустаяСтрока(НомерИскомый) Тогда
		Стр(Лог, "не задан номер документа (параметр «номер»)");
		Возврат;
	КонецЕсли;

	Попытка
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка КАК Ссылка ИЗ Документ." + ИмяИскомого
			+ " ГДЕ Номер = &Номер И Дата > ДАТАВРЕМЯ(2026, 10, 31) УПОРЯДОЧИТЬ ПО Дата УБЫВ");
		Запрос.УстановитьПараметр("Номер", НомерИскомый);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Не Выборка.Следующий() Тогда
			Стр(Лог, "документ с номером " + НомерИскомый + " не найден");
			Возврат;
		КонецЕсли;
		Ссылка = Выборка.Ссылка;
	Исключение
		Стр(Лог, "поиск документа: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	Стр(Лог, "документ: " + СтрЗнач(Ссылка));

	Попытка
		Объект = Ссылка.ПолучитьОбъект();
	Исключение
		Стр(Лог, "получение объекта: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	Стр(Лог, "было: комментарий «" + СтрЗнач(Объект.Комментарий) + "», строк " 
		+ Формат(КоличествоСтрокТоваров(Объект), "ЧГ=0"));

	НовыйКомментарий = Параметр(Задание, "комментарий", "");
	Если Не ПустаяСтрока(НовыйКомментарий) Тогда
		Объект.Комментарий = НовыйКомментарий;
		Стр(Лог, "комментарий заменён");
	КонецЕсли;

	ИмяСклада = Параметр(Задание, "склад", "");
	Если Не ПустаяСтрока(ИмяСклада) Тогда
		Склад = НайтиПоНаименованиюВхождение("Склады", ИмяСклада);
		Если Склад <> Неопределено Тогда
			УстановитьРеквизит(Объект, "Склад", Склад);
			Стр(Лог, "склад заменён: " + СтрЗнач(Склад));
		Иначе
			Стр(Лог, "склад «" + ИмяСклада + "» не найден");
		КонецЕсли;
	КонецЕсли;

	// счёт учёта: в БП это ПланыСчетов.Хозрасчетный, в УТ такого плана нет
	КодСчета = Параметр(Задание, "счет", "");
	Если Не ПустаяСтрока(КодСчета) И Метаданные.ПланыСчетов.Найти("Хозрасчетный") <> Неопределено Тогда
		ПланСчетов = ПланыСчетов["Хозрасчетный"];
		Счет = ПланСчетов.НайтиПоКоду(КодСчета);
		Если ЗначениеЗаполнено(Счет) Тогда
			УстановитьРеквизит(Объект, "СчетУчета", Счет);
			Стр(Лог, "счёт учёта заменён: " + СтрЗнач(Счет));
		Иначе
			Стр(Лог, "счёт «" + КодСчета + "» не найден");
		КонецЕсли;
	КонецЕсли;

	НовоеКоличество = Параметр(Задание, "количество", "");
	Если Не ПустаяСтрока(НовоеКоличество) И КоличествоСтрокТоваров(Объект) > 0 Тогда
		СтрокаТоваров = Объект.Товары[0];
		Стр(Лог, "строка 1: " + СтрЗнач(СтрокаТоваров.Номенклатура)
			+ ", количество было " + Формат(СтрокаТоваров.Количество, "ЧДЦ=3"));
		СтрокаТоваров.Количество = Число(НовоеКоличество);
		Стр(Лог, "количество стало " + Формат(СтрокаТоваров.Количество, "ЧДЦ=3"));
	КонецЕсли;

	Проведен = Ложь;
	Попытка
		Объект.Записать(РежимЗаписиДокумента.Проведение);
		Проведен = Истина;
		Стр(Лог, "документ записан и проведён");
	Исключение
		СведенияОбОшибке = ИнформацияОбОшибке();
		Стр(Лог, "проведение не удалось: " + ПодробноеПредставлениеОшибки(СведенияОбОшибке));
		Попытка
			Объект.Записать(РежимЗаписиДокумента.Запись);
			Стр(Лог, "документ записан без проведения");
		Исключение
			Стр(Лог, "запись не удалась: " + ОписаниеОшибки());
			Возврат;
		КонецПопытки;
	КонецПопытки;

	Стр(Лог, "после записи: комментарий «" + СтрЗнач(Объект.Комментарий) + "»");

	Узел = УзелКорреспондента(Задание, Лог, Ложь);
	Если Узел = Неопределено Тогда
		Стр(Лог, "узел не найден — регистрация изменений не выполнена");
		Возврат;
	КонецЕсли;

	Попытка
		Ссылки = Новый Массив;
		Ссылки.Добавить(Объект.Ссылка);
		ПланыОбмена.ЗарегистрироватьИзменения(Узел, Ссылки);
		Стр(Лог, "изменения зарегистрированы для узла " + СтрЗнач(Узел));
	Исключение
		Стр(Лог, "регистрация изменений: ошибка " + ОписаниеОшибки());
	КонецПопытки;

	Стр(Лог, "проведён: " + ?(Проведен, "да", "нет"));

КонецПроцедуры

&НаСервере
Процедура РежимУдалить(Задание, ИмяБазы, Лог)

	Секция(Лог, "Удаление документа");

	ИмяИскомого = Параметр(Задание, "документ", "СборкаТоваров");
	НомерИскомый = Параметр(Задание, "номер", "");
	Если ПустаяСтрока(НомерИскомый) Тогда
		Стр(Лог, "не задан номер документа (параметр «номер»)");
		Возврат;
	КонецЕсли;

	// справочники удаляем по наименованию — нужно на стенде, чтобы снять
	// спецификации, оставшиеся от прогонов с другим форматом имени
	Если МетаданныеЕсть("Справочники", ИмяИскомого) Тогда
		Попытка
			Запрос = Новый Запрос("ВЫБРАТЬ Ссылка КАК Ссылка ИЗ Справочник." + ИмяИскомого
				+ " ГДЕ Наименование = &Имя");
			Запрос.УстановитьПараметр("Имя", НомерИскомый);
			Выборка = Запрос.Выполнить().Выбрать();
			Найдено = 0;
			Пока Выборка.Следующий() Цикл
				Найдено = Найдено + 1;
				Представление = СтрЗнач(Выборка.Ссылка);
				Попытка
					Выборка.Ссылка.ПолучитьОбъект().Удалить();
					Стр(Лог, "удалён: " + Представление);
				Исключение
					Стр(Лог, "не удалён " + Представление + ": " + ОписаниеОшибки());
				КонецПопытки;
			КонецЦикла;
			Если Найдено = 0 Тогда
				Стр(Лог, "элемент «" + НомерИскомый + "» не найден");
			КонецЕсли;
		Исключение
			Стр(Лог, "поиск в справочнике: ошибка " + ОписаниеОшибки());
		КонецПопытки;
		Возврат;
	КонецЕсли;

	Если Не МетаданныеЕсть("Документы", ИмяИскомого) Тогда
		Стр(Лог, "документа " + ИмяИскомого + " в конфигурации нет");
		Возврат;
	КонецЕсли;

	Попытка
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка КАК Ссылка ИЗ Документ." + ИмяИскомого
			+ " ГДЕ Номер = &Номер И Дата > ДАТАВРЕМЯ(2026, 10, 31) УПОРЯДОЧИТЬ ПО Дата УБЫВ");
		Запрос.УстановитьПараметр("Номер", НомерИскомый);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Не Выборка.Следующий() Тогда
			Стр(Лог, "документ с номером " + НомерИскомый + " не найден");
			Возврат;
		КонецЕсли;
		Ссылка = Выборка.Ссылка;
	Исключение
		Стр(Лог, "поиск документа: ошибка " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	Стр(Лог, "документ: " + СтрЗнач(Ссылка));

	Узел = УзелКорреспондента(Задание, Лог, Ложь);
	Если Узел <> Неопределено Тогда
		Попытка
			Ссылки = Новый Массив;
			Ссылки.Добавить(Ссылка);
			ПланыОбмена.УдалитьРегистрациюИзменений(Узел, Ссылки);
			Стр(Лог, "регистрация изменений снята");
		Исключение
			Стр(Лог, "снятие регистрации: ошибка " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;

	Попытка
		Объект = Ссылка.ПолучитьОбъект();
		Объект.Удалить();
		Стр(Лог, "документ удалён");
	Исключение
		Стр(Лог, "удаление: ошибка " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// ========================= РЕЖИМ «КОМПЛЕКТ» (БП) ============================
// Создаёт в БП номенклатуру-комплект, спецификацию (версию) и документ
// «Комплектация номенклатуры» (сборка) из перечисленных комплектующих.

&НаСервере
Функция СчетПоКоду(Код)
	Попытка
		Если Метаданные.ПланыСчетов.Найти("Хозрасчетный") = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат ПланыСчетов["Хозрасчетный"].НайтиПоКоду(Код);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

&НаСервере
Функция КомплектующиеИзСтроки(Текст, Лог)
	// формат: «Номенклатура=Количество;Номенклатура=Количество»
	Результат = Новый Массив;
	Для Каждого Часть Из СтрРазделить(Текст, ";", Ложь) Цикл
		Часть = СокрЛП(Часть);
		Если ПустаяСтрока(Часть) Тогда
			Продолжить;
		КонецЕсли;
		Пара = СтрРазделить(Часть, "=", Ложь);
		Если Пара.Количество() < 2 Тогда
			Стр(Лог, "не разобрана комплектующая: " + Часть);
			Продолжить;
		КонецЕсли;
		Номенклатура = НайтиПоНаименованиюВхождение("Номенклатура", СокрЛП(Пара[0]));
		Если Номенклатура = Неопределено Тогда
			Стр(Лог, "комплектующая не найдена: " + СокрЛП(Пара[0]));
			Продолжить;
		КонецЕсли;
		Строка = Новый Структура("Номенклатура, Количество");
		Строка.Номенклатура = Номенклатура;
		Строка.Количество = Число(СтрЗаменить(СокрЛП(Пара[1]), ",", "."));
		Результат.Добавить(Строка);
		Стр(Лог, "  комплектующая: " + СтрЗнач(Номенклатура)
			+ ", количество " + Формат(Строка.Количество, "ЧДЦ=3"));
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаСервере
Функция ДокументПоНомеру(ИмяДокумента, Номер, Лог)
	Попытка
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка КАК Ссылка ИЗ Документ." + ИмяДокумента
			+ " ГДЕ Номер = &Номер И Дата > ДАТАВРЕМЯ(2026, 10, 31) УПОРЯДОЧИТЬ ПО Дата УБЫВ");
		Запрос.УстановитьПараметр("Номер", Номер);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	Исключение
		Стр(Лог, "поиск документа " + ИмяДокумента + ": ошибка " + ОписаниеОшибки());
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

&НаСервере
Процедура ВывестиПроводки(Лог, Регистратор)
	Секция(Лог, "Проводки документа");
	Попытка
		Запрос = Новый Запрос("ВЫБРАТЬ
			|	СчетДт КАК СчетДт,
			|	СчетКт КАК СчетКт,
			|	Сумма КАК Сумма,
			|	СубконтоДт1 КАК СубконтоДт1,
			|	СубконтоКт1 КАК СубконтоКт1
			|ИЗ РегистрБухгалтерии.Хозрасчетный.ДвиженияССубконто(&Начало, &Конец, Регистратор = &Регистратор)
			|УПОРЯДОЧИТЬ ПО СчетДт, СчетКт, Сумма");
		Запрос.УстановитьПараметр("Начало", Дата(1, 1, 1));
		Запрос.УстановитьПараметр("Конец", Дата(3999, 12, 31));
		Запрос.УстановитьПараметр("Регистратор", Регистратор);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Стр(Лог, "  Дт " + Выборка.СчетДт + " Кт " + Выборка.СчетКт
				+ " | " + Формат(Выборка.Сумма, "ЧДЦ=2")
				+ " | " + СтрЗнач(Выборка.СубконтоДт1)
				+ " | " + СтрЗнач(Выборка.СубконтоКт1));
		КонецЦикла;
	Исключение
		Стр(Лог, "проводки: ошибка " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаСервере
Функция ОбъектВСоставеПлана(Узел, МетаОбъект)
	// Узел — ссылка на план обмена. УдалитьРегистрациюИзменений падает
	// с «Invalid parameter value», если объект не входит в состав плана,
	// поэтому состав проверяем заранее. В составе лежат не объекты метаданных,
	// а элементы состава плана (ЭлементСоставаПланаОбмена), у каждого свой
	// реквизит «Метаданные».
	План = Узел.Метаданные();
	Если План = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	ОписаниеПлана = Метаданные.ПланыОбмена.Найти(План.Имя);
	Если ОписаниеПлана = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Элемент Из ОписаниеПлана.Состав Цикл
		Если Элемент.Метаданные = МетаОбъект Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

&НаСервере
Функция ЗаписатьИПровести(Док, Задание, Лог)
	// Запись с проведением. Режим загрузки данных для проведения не годится
	// («This action cannot be performed during data loading»), поэтому пишем
	// обычной записью, а затем снимаем регистрацию изменений, чтобы документ
	// не ушёл обратно в УТ.

	Проведен = Ложь;
	Попытка
		Док.Записать(РежимЗаписиДокумента.Проведение);
		Проведен = Истина;
	Исключение
		Стр(Лог, "проведение не удалось: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Попытка
			Док.Записать(РежимЗаписиДокумента.Запись);
			Стр(Лог, "документ записан без проведения");
		Исключение
			Стр(Лог, "запись не удалась: " + ОписаниеОшибки());
		КонецПопытки;
	КонецПопытки;

	Если Не ПустаяСтрока(Параметр(Задание, "код", "")) Тогда
		Узел = УзелКорреспондента(Задание, Лог, Ложь);
		Если Узел <> Неопределено Тогда
			Если ОбъектВСоставеПлана(Узел, Док.Метаданные()) Тогда
				Попытка
					Ссылки = Новый Массив;
					Ссылки.Добавить(Док.Ссылка);
					ПланыОбмена.УдалитьРегистрациюИзменений(Узел, Ссылки);
					Стр(Лог, "регистрация изменений снята (обратно не уйдёт)");
				Исключение
					Стр(Лог, "снятие регистрации: ошибка " + ОписаниеОшибки());
				КонецПопытки;
			Иначе
				Стр(Лог, "снятие регистрации не требуется: " + Док.Метаданные().Имя
					+ " не входит в состав плана обмена");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Возврат Проведен;
КонецФункции

&НаСервере
Процедура РежимКомплект(Задание, ИмяБазы, Лог)

	Секция(Лог, "Создание комплекта, спецификации и сборки (БП)");

	Если Не МетаданныеЕсть("Документы", "КомплектацияНоменклатуры")
		Или Не МетаданныеЕсть("Справочники", "СпецификацииНоменклатуры") Тогда
		Стр(Лог, "нет КомплектацияНоменклатуры/СпецификацииНоменклатуры — режим только для БП");
		Возврат;
	КонецЕсли;

	ИмяКомплекта = Параметр(Задание, "комплект", "");
	Если ПустаяСтрока(ИмяКомплекта) Тогда
		Стр(Лог, "не задано имя комплекта (параметр «комплект»)");
		Возврат;
	КонецЕсли;

	// --- 1. номенклатура-комплект
	Комплект = НайтиПоНаименованиюВхождение("Номенклатура", ИмяКомплекта);
	Если Комплект = Неопределено Тогда
		Элемент = Справочники["Номенклатура"].СоздатьЭлемент();
		Элемент.Наименование = ИмяКомплекта;
		Элемент.ВидНоменклатуры = НайтиПоНаименованиюВхождение("ВидыНоменклатуры", "Товары");
		Элемент.ЕдиницаИзмерения = НайтиПоНаименованиюВхождение("КлассификаторЕдиницИзмерения", "шт");
		УстановитьРеквизит(Элемент, "Услуга", Ложь);
		Элемент.Записать();
		Комплект = Элемент.Ссылка;
		Стр(Лог, "создана номенклатура: " + СтрЗнач(Комплект));
	Иначе
		Стр(Лог, "номенклатура уже есть: " + СтрЗнач(Комплект));
	КонецЕсли;

	Комплектующие = КомплектующиеИзСтроки(Параметр(Задание, "комплектующие", ""), Лог);
	Если Комплектующие.Количество() = 0 Тогда
		Стр(Лог, "комплектующие не заданы — создавать нечего");
		Возврат;
	КонецЕсли;

	// --- 2. спецификация (версия)
	ИмяВерсии = Параметр(Задание, "версия", "Основная");
	Спецификация = Неопределено;
	Попытка
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка КАК Ссылка ИЗ Справочник.СпецификацииНоменклатуры
			|ГДЕ Владелец = &Владелец И Наименование = &Наименование
			|УПОРЯДОЧИТЬ ПО Наименование");
		Запрос.УстановитьПараметр("Владелец", Комплект);
		Запрос.УстановитьПараметр("Наименование", ИмяВерсии);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Спецификация = Выборка.Ссылка;
		КонецЕсли;
	Исключение
		Стр(Лог, "поиск спецификации: ошибка " + ОписаниеОшибки());
	КонецПопытки;

	Если Спецификация = Неопределено Тогда
		Элемент = Справочники["СпецификацииНоменклатуры"].СоздатьЭлемент();
		Элемент.Владелец = Комплект;
		Элемент.Наименование = ИмяВерсии;
		Элемент.Количество = 1;
		Для Каждого Комплектующая Из Комплектующие Цикл
			Строка = Элемент.ИсходныеКомплектующие.Добавить();
			Строка.Номенклатура = Комплектующая.Номенклатура;
			Строка.Количество = Комплектующая.Количество;
		КонецЦикла;
		Элемент.Записать();
		Спецификация = Элемент.Ссылка;
		Стр(Лог, "создана спецификация: " + СтрЗнач(Спецификация) + " («" + ИмяВерсии + "»)");
	Иначе
		Стр(Лог, "спецификация уже есть: " + СтрЗнач(Спецификация));
	КонецЕсли;

	Попытка
		ОбъектКомплекта = Комплект.ПолучитьОбъект();
		ОбъектКомплекта.ОсновнаяСпецификацияНоменклатуры = Спецификация;
		ОбъектКомплекта.Записать();
	Исключение
		Стр(Лог, "основная спецификация: ошибка " + ОписаниеОшибки());
	КонецПопытки;

	// --- 3. документ сборки
	// дата сборки: если задан номер продажи — на секунду раньше неё,
	// организацию и склад берём из самой продажи (если заполнены)
	ДатаСборки = НачалоДня(ТекущаяДатаСеанса());
	НомерПродажи = Параметр(Задание, "номер", "");
	Продажа = Неопределено;
	Если Не ПустаяСтрока(НомерПродажи) Тогда
		Продажа = ДокументПоНомеру("РеализацияТоваровУслуг", НомерПродажи, Лог);
		Если ЗначениеЗаполнено(Продажа) Тогда
			ДатаСборки = Продажа.Дата - 1;
			Стр(Лог, "дата сборки — на секунду раньше продажи: "
				+ Формат(ДатаСборки, "ДФ=yyyy-MM-dd HH:mm:ss"));
		КонецЕсли;
	КонецЕсли;

	Склад = Неопределено;
	Организация = Неопределено;
	Если ЗначениеЗаполнено(Продажа) Тогда
		Если ЗначениеЗаполнено(Продажа.Склад) Тогда
			Склад = Продажа.Склад;
		КонецЕсли;
		Если ЗначениеЗаполнено(Продажа.Организация) Тогда
			Организация = Продажа.Организация;
		КонецЕсли;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Склад) Тогда
		Склад = НайтиПоНаименованиюВхождение("Склады", Параметр(Задание, "склад", "Основной склад"));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Организация = НайтиПоНаименованиюВхождение("Организации", Параметр(Задание, "организация", ""));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Организация = ПерваяОрганизация(Лог);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Склад) Тогда
		Стр(Лог, "склад не найден");
		Возврат;
	КонецЕсли;
	Стр(Лог, "склад: " + СтрЗнач(Склад) + "; организация: " + СтрЗнач(Организация));

	Док = Документы["КомплектацияНоменклатуры"].СоздатьДокумент();
	Док.Дата = ДатаСборки;
	Попытка
		Док.УстановитьНовыйНомер();
	Исключение
		Стр(Лог, "номер документа не установлен: " + ОписаниеОшибки());
	КонецПопытки;
	Док.ВидОперации = Перечисления["ВидыОперацийКомплектацияНоменклатуры"]["Комплектация"];
	Док.Организация = Организация;
	Док.Склад = Склад;
	Док.Номенклатура = Комплект;
	Док.Количество = 1;
	Док.Комментарий = "Живой прогон: сборка комплекта " + ИмяКомплекта;
	Счет41 = СчетПоКоду("41.01");
	Док.СчетУчета = Счет41;
	Доля = Окр(100 / Комплектующие.Количество(), 2);
	Для Каждого Комплектующая Из Комплектующие Цикл
		Строка = Док.Комплектующие.Добавить();
		Строка.Номенклатура = Комплектующая.Номенклатура;
		Строка.Количество = Комплектующая.Количество;
		Строка.ДоляСтоимости = Доля;
		Строка.СчетУчета = Счет41;
	КонецЦикла;

	Проведен = ЗаписатьИПровести(Док, Задание, Лог);

	// после проведения перечитываем: суммы по строкам и себестоимость
	// платформа заполняет в базе, а не в объекте, который писали
	Попытка
		Док = Док.Ссылка.ПолучитьОбъект();
	Исключение
		Стр(Лог, "перечитывание документа: ошибка " + ОписаниеОшибки());
	КонецПопытки;

	Стр(Лог, "документ сборки: " + СтрЗнач(Док.Ссылка) + ", проведён: " + ?(Проведен, "да", "нет"));
	Стр(Лог, "сумма документа: " + Формат(Док.СуммаДокумента, "ЧДЦ=2"));
	Для Каждого Строка Из Док.Комплектующие Цикл
		Стр(Лог, "  " + СтрЗнач(Строка.Номенклатура)
			+ " | кол-во " + Формат(Строка.Количество, "ЧДЦ=3")
			+ " | доля " + Формат(Строка.ДоляСтоимости, "ЧДЦ=2")
			+ " | сумма " + Формат(Строка.Сумма, "ЧДЦ=2")
			+ " | себестоимость " + Формат(Строка.Себестоимость, "ЧДЦ=2"));
	КонецЦикла;

	ВывестиПроводки(Лог, Док.Ссылка);

КонецПроцедуры

// ========================== РЕЖИМ «ЗАМЕНА» (БП) =============================
// Заменяет товарные строки загруженной реализации одной строкой комплекта,
// сохраняя суммы и НДС. Услуги (ТЧ «Услуги») не трогает. Запись — в режиме
// загрузки, чтобы изменённый документ не ушёл обратно в УТ.

&НаСервере
Процедура РежимЗамена(Задание, ИмяБазы, Лог)

	Секция(Лог, "Замена товарных строк реализации строкой комплекта (БП)");

	Если Не МетаданныеЕсть("Документы", "РеализацияТоваровУслуг") Тогда
		Стр(Лог, "нет документа РеализацияТоваровУслуг");
		Возврат;
	КонецЕсли;

	Номер = Параметр(Задание, "номер", "");
	Если ПустаяСтрока(Номер) Тогда
		Стр(Лог, "не задан номер документа (параметр «номер»)");
		Возврат;
	КонецЕсли;
	ИмяКомплекта = Параметр(Задание, "комплект", "");
	Комплект = НайтиПоНаименованиюВхождение("Номенклатура", ИмяКомплекта);
	Если Комплект = Неопределено Тогда
		Стр(Лог, "комплект «" + ИмяКомплекта + "» не найден");
		Возврат;
	КонецЕсли;

	Ссылка = ДокументПоНомеру("РеализацияТоваровУслуг", Номер, Лог);
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Стр(Лог, "документ с номером " + Номер + " не найден");
		Возврат;
	КонецЕсли;
	Объект = Ссылка.ПолучитьОбъект();
	Стр(Лог, "документ: " + СтрЗнач(Ссылка));
	Стр(Лог, "было: строк товаров " + Формат(Объект.Товары.Количество(), "ЧГ=0")
		+ ", строк услуг " + Формат(Объект.Услуги.Количество(), "ЧГ=0")
		+ ", сумма документа " + Формат(Объект.СуммаДокумента, "ЧДЦ=2"));

	Если Объект.Товары.Количество() = 0 Тогда
		Стр(Лог, "товарных строк нет — заменять нечего");
		Возврат;
	КонецЕсли;

	Первая = Объект.Товары[0];
	СчетУчета = Первая.СчетУчета;
	СчетДоходов = Первая.СчетДоходов;
	СчетРасходов = Первая.СчетРасходов;
	СчетНДС = Первая.СчетУчетаНДСПоРеализации;
	Субконто = Первая.Субконто;
	СтавкаНДС = Первая.СтавкаНДС;
	ЕдиницаИзмерения = Первая.ЕдиницаИзмерения;
	Коэффициент = Первая.Коэффициент;

	ИтогоСумма = 0;
	ИтогоНДС = 0;
	Для Каждого Строка Из Объект.Товары Цикл
		ИтогоСумма = ИтогоСумма + Строка.Сумма;
		ИтогоНДС = ИтогоНДС + Строка.СуммаНДС;
	КонецЦикла;
	Стр(Лог, "итого по товарам: сумма " + Формат(ИтогоСумма, "ЧДЦ=2")
		+ ", НДС " + Формат(ИтогоНДС, "ЧДЦ=2"));

	Объект.Товары.Очистить();
	Новая = Объект.Товары.Добавить();
	Новая.Номенклатура = Комплект;
	Новая.Количество = Число(Параметр(Задание, "количество", "1"));
	Новая.Цена = Окр(ИтогоСумма / Новая.Количество, 2);
	Новая.Сумма = ИтогоСумма;
	Новая.СуммаНДС = ИтогоНДС;
	Новая.СтавкаНДС = СтавкаНДС;
	УстановитьРеквизитСтроки(Новая, "СчетУчета", СчетУчета);
	УстановитьРеквизитСтроки(Новая, "СчетДоходов", СчетДоходов);
	УстановитьРеквизитСтроки(Новая, "СчетРасходов", СчетРасходов);
	УстановитьРеквизитСтроки(Новая, "СчетУчетаНДСПоРеализации", СчетНДС);
	УстановитьРеквизитСтроки(Новая, "Субконто", Субконто);
	УстановитьРеквизитСтроки(Новая, "ЕдиницаИзмерения", ЕдиницаИзмерения);
	УстановитьРеквизитСтроки(Новая, "Коэффициент", Коэффициент);
	УстановитьРеквизитСтроки(Новая, "ИдентификаторСтроки", Новый УникальныйИдентификатор);

	Объект.СуммаДокумента = ИтогоСумма;
	Если Не ЗначениеЗаполнено(Объект.Склад) Тогда
		Склад = НайтиПоНаименованиюВхождение("Склады", Параметр(Задание, "склад", "Основной склад"));
		Если ЗначениеЗаполнено(Склад) Тогда
			Объект.Склад = Склад;
			Стр(Лог, "склад заполнен: " + СтрЗнач(Склад));
		КонецЕсли;
	КонецЕсли;

	Стр(Лог, "стало: строка «" + СтрЗнач(Новая.Номенклатура)
		+ "», количество " + Формат(Новая.Количество, "ЧДЦ=3")
		+ ", цена " + Формат(Новая.Цена, "ЧДЦ=2")
		+ ", сумма " + Формат(Новая.Сумма, "ЧДЦ=2")
		+ ", НДС " + Формат(Новая.СуммаНДС, "ЧДЦ=2")
		+ ", ставка " + СтрЗнач(Новая.СтавкаНДС));

	Проведен = ЗаписатьИПровести(Объект, Задание, Лог);
	Стр(Лог, "проведён: " + ?(Проведен, "да", "нет"));

	Стр(Лог, "после: строк товаров " + Формат(Объект.Товары.Количество(), "ЧГ=0")
		+ ", строк услуг " + Формат(Объект.Услуги.Количество(), "ЧГ=0")
		+ ", сумма документа " + Формат(Объект.СуммаДокумента, "ЧДЦ=2"));
	ВывестиПроводки(Лог, Объект.Ссылка);

КонецПроцедуры

// ============================ РЕЖИМ «ВЕРСИЯ» ================================
// Что такое «версия объекта» на практике: есть ли ВерсияДанных() у ссылки,
// меняется ли она при записи самого объекта и при правке состава, который
// лежит в отдельном справочнике вариантов комплектации.

&НаСервере
Процедура РежимВерсия(Задание, ИмяБазы, Лог)

	Секция(Лог, "Версии объекта и состава");

	Имя = Параметр(Задание, "номенклатура", "");
	Если ПустаяСтрока(Имя) Тогда
		Стр(Лог, "не задано имя номенклатуры");
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Ссылка КАК Ссылка, Наименование КАК Наименование,"
		+ " Код КАК Код, Артикул КАК Артикул, ТипНоменклатуры КАК Тип"
		+ " ИЗ Справочник.Номенклатура"
		+ " ГДЕ Наименование ПОДОБНО &Шаблон УПОРЯДОЧИТЬ ПО Наименование";
	Запрос.УстановитьПараметр("Шаблон", "%" + Имя + "%");
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Ссылка = Выборка.Ссылка;
		Стр(Лог, "--- " + СтрЗнач(Ссылка) + " (" + Строка(Выборка.Тип) + ", код "
			+ Строка(Выборка.Код) + ", артикул " + Строка(Выборка.Артикул) + ")");
		Стр(Лог, "  ВерсияДанных(): " + ВерсияСсылки(Ссылка));

		Варианты = Новый Запрос;
		Варианты.Текст = "ВЫБРАТЬ Ссылка КАК Ссылка, Наименование КАК Наименование"
			+ " ИЗ Справочник.ВариантыКомплектацииНоменклатуры"
			+ " ГДЕ Владелец = &Владелец УПОРЯДОЧИТЬ ПО Наименование";
		Варианты.УстановитьПараметр("Владелец", Ссылка);
		ВыборкаВариантов = Варианты.Выполнить().Выбрать();
		Пока ВыборкаВариантов.Следующий() Цикл
			Вариант = ВыборкаВариантов.Ссылка;
			Стр(Лог, "  вариант: " + СтрЗнач(Вариант)
				+ " | ВерсияДанных(): " + ВерсияСсылки(Вариант));
			Состав = СоставВарианта(Вариант);
			Стр(Лог, "    состав: " + Состав.Текст);
			Стр(Лог, "    подпись состава: " + ПодписьСостава(Состав.Текст));
		КонецЦикла;
	КонецЦикла;

	ПроверкаСпособовВерсии(Задание, Лог);

	// Проверка, меняется ли версия при записи. Параметр «перезаписать = да».
	Если ВРег(Параметр(Задание, "перезаписать", "нет")) = "ДА" Тогда
		Стр(Лог, "");
		Стр(Лог, "=== Перезапись объектов ===");
		Запрос.Выполнить().Выбрать();
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Ссылка = Выборка.Ссылка;
			До = ВерсияСсылки(Ссылка);
			Объект = Ссылка.ПолучитьОбъект();
			Объект.Записать();
			После = ВерсияСсылки(Ссылка);
			Стр(Лог, "номенклатура " + СтрЗнач(Ссылка) + ": до " + До + ", после " + После
				+ " | изменилась: " + ?(До <> После, "да", "нет"));
		КонецЕсли;

		Варианты = Новый Запрос;
		Варианты.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка КАК Ссылка"
			+ " ИЗ Справочник.ВариантыКомплектацииНоменклатуры"
			+ " ГДЕ Владелец.Наименование ПОДОБНО &Шаблон";
		Варианты.УстановитьПараметр("Шаблон", "%" + Имя + "%");
		ВыборкаВариантов = Варианты.Выполнить().Выбрать();
		Если ВыборкаВариантов.Следующий() Тогда
			Вариант = ВыборкаВариантов.Ссылка;
			До = ВерсияСсылки(Вариант);
			Объект = Вариант.ПолучитьОбъект();
			Объект.Записать();
			После = ВерсияСсылки(Вариант);
			Стр(Лог, "вариант " + СтрЗнач(Вариант) + ": до " + До + ", после " + После
				+ " | изменилась: " + ?(До <> После, "да", "нет"));
			Если ЗначениеЗаполнено(Объект.Владелец) Тогда
				Стр(Лог, "версия набора после записи варианта: " + ВерсияСсылки(Объект.Владелец));
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ВерсияСсылки(Ссылка)
	Попытка
		Возврат Строка(Ссылка.ВерсияДанных);
	Исключение
		Возврат "нет свойства: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

&НаСервере
Функция СоставВарианта(Вариант)
	Результат = Новый Структура("Текст, Строк", "", 0);
	Попытка
		Объект = Вариант.ПолучитьОбъект();
		Если Объект.Метаданные().ТабличныеЧасти.Найти("Товары") = Неопределено Тогда
			Результат.Текст = "нет ТЧ Товары";
			Возврат Результат;
		КонецЕсли;
		Части = Новый Массив;
		Для Каждого СтрокаТЧ Из Объект.Товары Цикл
			Части.Добавить(Строка(СтрокаТЧ.Номенклатура) + " x "
				+ Формат(СтрокаТЧ.Количество, "ЧДЦ=3"));
		КонецЦикла;
		Результат.Строк = Объект.Товары.Количество();
		Результат.Текст = СтрСоединить(Части, " + ");
	Исключение
		Результат.Текст = "ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат Результат;
КонецФункции

&НаСервере
Функция ПодписьСостава(Текст)
	Хеш = Новый ХешированиеДанных(ХешФункция.MD5);
	Хеш.Добавить(Текст);
	Возврат Base64Строка(Хеш.ХешСумма);
КонецФункции

&НаСервере
Процедура ПроверкаСпособовВерсии(Задание, Лог)

	Стр(Лог, "");
	Секция(Лог, "Способы получить версию средствами платформы");

	Номенклатура = НайтиПоНаименованиюВхождение("Номенклатура", Параметр(Задание, "номенклатура", "Артон"));
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Стр(Лог, "номенклатура не найдена");
		Возврат;
	КонецЕсли;
	Стр(Лог, "объект: " + СтрЗнач(Номенклатура));

	// 1. Версия как свойство ссылки.
	Попытка
		Стр(Лог, "1) Ссылка.ВерсияДанных (свойство): " + Строка(Номенклатура.ВерсияДанных));
	Исключение
		Стр(Лог, "1) Ссылка.ВерсияДанных (свойство): нет — "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	// 2. Версия как поле запроса.
	Попытка
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 ВерсияДанных КАК Версия ИЗ Справочник.Номенклатура ГДЕ Ссылка = &Ссылка");
		Запрос.УстановитьПараметр("Ссылка", Номенклатура);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Стр(Лог, "2) поле запроса ВерсияДанных: есть, значение " + Строка(Выборка.Версия));
		Иначе
			Стр(Лог, "2) поле запроса ВерсияДанных: есть, строк нет");
		КонецЕсли;
	Исключение
		Стр(Лог, "2) поле запроса ВерсияДанных: нет — "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	// 3. История данных (механизм «версии объектов» платформы, 8.3.11+).
	Попытка
		Настройки = ИсторияДанных.ПолучитьНастройки(Метаданные.Справочники.Номенклатура);
		Стр(Лог, "3) ИсторияДанных.ПолучитьНастройки(Номенклатура): "
			+ ?(Настройки = Неопределено, "не настроена", "настроена (вариант "
				+ Строка(Настройки.Вариант) + ")"));
	Исключение
		Стр(Лог, "3) ИсторияДанных: нет — " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	// 4. Обмен данными: что платформа знает про версии в плане обмена.
	Попытка
		Стр(Лог, "4) Объект.ОбменДанными.Получатели: " + Строка(Номенклатура.ПолучитьОбъект().ОбменДанными.Получатели));
	Исключение
		Стр(Лог, "4) ОбменДанными: нет — " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// ================== РЕЖИМ «ПОСТОБРАБОТКА» (БП) ==============================
// Постановка 03.11.2026: карточка комплекта одна на набор, а на каждую продажу
// создаются своя спецификация (состав этой продажи) и своя сборка. Строка
// реализации заменяется одной строкой комплекта, цена и сумма берутся из
// документа. Проверка: продали «компьютер с мощным процессором» за 1000 и
// «компьютер со слабым» за 300 — две сборки с разным составом, одна карточка.

&НаСервере
Процедура РежимПостобработка(Задание, ИмяБазы, Лог)

	Секция(Лог, "Спецификация и сборка на каждую продажу, замена строк");

	Если Не МетаданныеЕсть("Документы", "РеализацияТоваровУслуг")
		Или Не МетаданныеЕсть("Документы", "КомплектацияНоменклатуры")
		Или Не МетаданныеЕсть("Справочники", "СпецификацииНоменклатуры") Тогда
		Стр(Лог, "нет нужных объектов — режим только для БП");
		Возврат;
	КонецЕсли;

	Ссылка = ДокументПоНомеру("РеализацияТоваровУслуг", Параметр(Задание, "номер", ""), Лог);
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Стр(Лог, "реализация не найдена");
		Возврат;
	КонецЕсли;
	Объект = Ссылка.ПолучитьОбъект();
	Если Объект.Товары.Количество() = 0 Тогда
		Стр(Лог, "товарных строк нет — заменять нечего");
		Возврат;
	КонецЕсли;

	// 1. Карточка комплекта: одна на набор, наименование — название набора.
	Комплект = СоздатьИлиНайтиКомплект(Параметр(Задание, "комплект", ""), Лог);
	Если Комплект = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// защита от повторного запуска без перезагрузки: состав уже заменён одной
	// строкой комплекта, восстанавливать его нечем
	Если Объект.Товары.Количество() = 1 И Объект.Товары[0].Номенклатура = Комплект Тогда
		Стр(Лог, "документ уже обработан: в товарах одна строка комплекта — повторно не обрабатываю");
		Возврат;
	КонецЕсли;

	// Сколько наборов продано в одном документе. Из УТ это не приезжает: в БП
	// видны только комплектующие, а их количество уже умножено на число наборов.
	// Поэтому число наборов задаёт оператор; сборка и спецификация обязаны
	// описывать ровно столько комплектов, сколько стоит в строке продажи.
	КоличествоНаборов = Число(Параметр(Задание, "количество", "1"));
	Если КоличествоНаборов <= 0 Тогда
		Стр(Лог, "количество наборов должно быть больше нуля");
		Возврат;
	КонецЕсли;
	Стр(Лог, "наборов в продаже: " + Формат(КоличествоНаборов, "ЧДЦ=3"));

	// 2. Состав = товарные строки реализации, как они приехали из УТ.
	//    Это исторический факт: набор развернулся в торговле, а не в бухгалтерии.
	Состав = Новый Массив;
	ИтогоСумма = 0;
	ИтогоНДС = 0;
	Для Каждого Строка Из Объект.Товары Цикл
		ИтогоСумма = ИтогоСумма + Строка.Сумма;
		// СуммаНДС у только что загруженного документа пустая: БП считает её
		// при проведении. Если документ не проведён (нет остатков и т. п.),
		// считаем НДС сами по ставке строки — иначе комплект получит НДС 0.
		СуммаНДС = Строка.СуммаНДС;
		Если Не ЗначениеЗаполнено(СуммаНДС) Тогда
			Процент = ПроцентСтавкиНДС(Строка.СтавкаНДС);
			СуммаНДС = Окр(Строка.Сумма * Процент / (100 + Процент), 2);
			Стр(Лог, "  НДС строки «" + СтрЗнач(Строка.Номенклатура) + "» посчитан по ставке "
				+ СтрЗнач(Строка.СтавкаНДС) + ": " + Формат(СуммаНДС, "ЧДЦ=2"));
		КонецЕсли;
		ИтогоНДС = ИтогоНДС + СуммаНДС;
		Элемент = Новый Структура("Номенклатура, Количество");
		Элемент.Номенклатура = Строка.Номенклатура;
		Элемент.Количество = Строка.Количество;
		Состав.Добавить(Элемент);
	КонецЦикла;
	Стр(Лог, "документ " + СтрЗнач(Объект.Ссылка) + ": товарных строк "
		+ Формат(Состав.Количество(), "ЧГ=0")
		+ ", сумма " + Формат(ИтогоСумма, "ЧДЦ=2")
		+ ", НДС " + Формат(ИтогоНДС, "ЧДЦ=2"));

	// 3. Спецификация этой продажи.
	ИмяСпецификации = "Реализация " + Объект.Номер + " от "
		+ ДатаКлюч(Объект.Дата);
	// повторная загрузка той же продажи возвращает исходные строки: прежнюю
	// спецификацию и сборку убираем, иначе комплектующие спишутся дважды
	УдалитьПрежнююОбработку(Комплект, ИмяСпецификации, Объект, Лог);
	Спецификация = СоздатьСпецификацию(Комплект, ИмяСпецификации, Состав, КоличествоНаборов, Лог);

	// 4. Сборка на секунду раньше продажи: организация и склад — из продажи.
	//    Собирается столько комплектов, сколько наборов в продаже.
	Сборка = СоздатьСборку(Комплект, Состав, Объект.Дата - 1, Объект, Задание, КоличествоНаборов, Лог);
	Если Не ЗначениеЗаполнено(Сборка) Тогда
		Стр(Лог, "сборка не создана — строки не меняем");
		Возврат;
	КонецЕсли;

	// 5. Замена товарных строк и проведение продажи.
	ЗаменитьТоварныеСтроки(Объект, Комплект, ИтогоСумма, ИтогоНДС, КоличествоНаборов, Задание, Лог);

	Стр(Лог, "итог: комплект «" + СтрЗнач(Комплект) + "», спецификация «"
		+ ИмяСпецификации + "» (" + СтрЗнач(Спецификация) + "), сборка "
		+ СтрЗнач(Сборка));

КонецПроцедуры

&НаСервере
Функция СоздатьИлиНайтиКомплект(ИмяКомплекта, Лог)
	Если ПустаяСтрока(ИмяКомплекта) Тогда
		Стр(Лог, "не задано имя комплекта (параметр «комплект»)");
		Возврат Неопределено;
	КонецЕсли;
	Комплект = НайтиПоНаименованиюВхождение("Номенклатура", ИмяКомплекта);
	Если ЗначениеЗаполнено(Комплект) Тогда
		Стр(Лог, "карточка комплекта уже есть: " + СтрЗнач(Комплект));
		Возврат Комплект;
	КонецЕсли;
	Элемент = Справочники["Номенклатура"].СоздатьЭлемент();
	Элемент.Наименование = ИмяКомплекта;
	Элемент.ВидНоменклатуры = НайтиПоНаименованиюВхождение("ВидыНоменклатуры", "Товары");
	Элемент.ЕдиницаИзмерения = НайтиПоНаименованиюВхождение("КлассификаторЕдиницИзмерения", "шт");
	УстановитьРеквизит(Элемент, "Услуга", Ложь);
	Элемент.Записать();
	Стр(Лог, "создана карточка комплекта: " + СтрЗнач(Элемент.Ссылка));
	Возврат Элемент.Ссылка;
КонецФункции

&НаСервере
Процедура УдалитьПрежнююОбработку(Комплект, ИмяСпецификации, Продажа, Лог)
	// снимает следы прежнего прогона постобработки этой же продажи

	Попытка
		Запрос = Новый Запрос("ВЫБРАТЬ Ссылка КАК Ссылка ИЗ Справочник.СпецификацииНоменклатуры
			|ГДЕ Владелец = &Владелец И Наименование = &Имя");
		Запрос.УстановитьПараметр("Владелец", Комплект);
		Запрос.УстановитьПараметр("Имя", ИмяСпецификации);
		Для Каждого СтрокаТаблицы Из Запрос.Выполнить().Выгрузить() Цикл
			Попытка
				Представление = Строка(СтрокаТаблицы.Ссылка);
				СтрокаТаблицы.Ссылка.ПолучитьОбъект().Удалить();
				Стр(Лог, "удалена прежняя спецификация: " + Представление);
			Исключение
				Стр(Лог, "прежняя спецификация не удалена: " + ОписаниеОшибки());
			КонецПопытки;
		КонецЦикла;
	Исключение
		Стр(Лог, "поиск прежней спецификации: " + ОписаниеОшибки());
	КонецПопытки;

	КомментарийСборки = "Сборка под продажу " + Продажа.Номер + " от "
		+ ДатаКлюч(Продажа.Дата);
	// комментарий у документа неограниченной длины, сравнение в запросе платформа
	// не разрешает — отбираем по комплекту и дате, комментарий проверяем в коде
	Попытка
		Запрос = Новый Запрос("ВЫБРАТЬ Ссылка КАК Ссылка ИЗ Документ.КомплектацияНоменклатуры
			|ГДЕ Номенклатура = &Номенклатура И Дата = &Дата");
		Запрос.УстановитьПараметр("Номенклатура", Комплект);
		Запрос.УстановитьПараметр("Дата", Продажа.Дата - 1);
		Для Каждого СтрокаТаблицы Из Запрос.Выполнить().Выгрузить() Цикл
			Попытка
				ОбъектСборки = СтрокаТаблицы.Ссылка.ПолучитьОбъект();
				Если СтрНайти(ОбъектСборки.Комментарий, КомментарийСборки) = 0 Тогда
					Продолжить;
				КонецЕсли;
				Если ОбъектСборки.Проведен Тогда
					ОбъектСборки.Записать(РежимЗаписиДокумента.ОтменаПроведения);
				КонецЕсли;
				Представление = Строка(СтрокаТаблицы.Ссылка);
				ОбъектСборки.Удалить();
				Стр(Лог, "удалена прежняя сборка: " + Представление);
			Исключение
				Стр(Лог, "прежняя сборка не удалена: " + ОписаниеОшибки());
			КонецПопытки;
		КонецЦикла;
	Исключение
		Стр(Лог, "поиск прежней сборки: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаСервере
Функция СоздатьСпецификацию(Комплект, ИмяСпецификации, Состав, КоличествоНаборов, Лог)
	Элемент = Справочники["СпецификацииНоменклатуры"].СоздатьЭлемент();
	Элемент.Владелец = Комплект;
	Элемент.Наименование = ИмяСпецификации;
	// количество — на сколько комплектов рассчитан состав: состав приехал уже
	// умноженным на число наборов в продаже
	Элемент.Количество = КоличествоНаборов;
	Для Каждого Комплектующая Из Состав Цикл
		Строка = Элемент.ИсходныеКомплектующие.Добавить();
		Строка.Номенклатура = Комплектующая.Номенклатура;
		Строка.Количество = Комплектующая.Количество;
	КонецЦикла;
	Элемент.Записать();
	Стр(Лог, "создана спецификация: " + СтрЗнач(Элемент.Ссылка)
		+ ", строк " + Формат(Состав.Количество(), "ЧГ=0")
		+ ", на " + Формат(КоличествоНаборов, "ЧДЦ=3") + " набор(ов)");

	// «Основную спецификацию» карточки не трогаем: в этой модели основной
	// спецификации нет — у каждой продажи своя.

	Возврат Элемент.Ссылка;
КонецФункции

&НаСервере
Функция СоздатьСборку(Комплект, Состав, ДатаСборки, Продажа, Задание, КоличествоНаборов, Лог)

	Склад = Неопределено;
	Организация = Неопределено;
	Если ЗначениеЗаполнено(Продажа.Склад) Тогда
		Склад = Продажа.Склад;
	КонецЕсли;
	Если ЗначениеЗаполнено(Продажа.Организация) Тогда
		Организация = Продажа.Организация;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Склад) Тогда
		Склад = НайтиПоНаименованиюВхождение("Склады", Параметр(Задание, "склад", "Основной склад"));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Организация = ПерваяОрганизация(Лог);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Склад) Тогда
		Стр(Лог, "склад не найден — сборка не создана");
		Возврат Неопределено;
	КонецЕсли;

	Док = Документы["КомплектацияНоменклатуры"].СоздатьДокумент();
	Док.Дата = ДатаСборки;
	Попытка
		Док.УстановитьНовыйНомер();
	Исключение
		Стр(Лог, "номер документа не установлен: " + ОписаниеОшибки());
	КонецПопытки;
	Док.ВидОперации = Перечисления["ВидыОперацийКомплектацияНоменклатуры"]["Комплектация"];
	Док.Организация = Организация;
	Док.Склад = Склад;
	Док.Номенклатура = Комплект;
	// собирается столько комплектов, сколько наборов в продаже; иначе
	// удвоенный состав уйдёт в себестоимость одного комплекта
	Док.Количество = КоличествоНаборов;
	Док.Комментарий = "Сборка под продажу " + Продажа.Номер + " от "
		+ ДатаКлюч(Продажа.Дата);
	Счет41 = СчетПоКоду("41.01");
	Док.СчетУчета = Счет41;
	Доля = Окр(100 / Состав.Количество(), 2);
	Для Каждого Комплектующая Из Состав Цикл
		Строка = Док.Комплектующие.Добавить();
		Строка.Номенклатура = Комплектующая.Номенклатура;
		Строка.Количество = Комплектующая.Количество;
		Строка.ДоляСтоимости = Доля;
		Строка.СчетУчета = Счет41;
	КонецЦикла;

	Проведен = ЗаписатьИПровести(Док, Задание, Лог);
	Стр(Лог, "сборка " + СтрЗнач(Док.Ссылка) + " от "
		+ ДатаКлюч(ДатаСборки)
		+ ", комплектов " + Формат(КоличествоНаборов, "ЧДЦ=3")
		+ ", проведена: " + ?(Проведен, "да", "нет")
		+ ", склад: " + СтрЗнач(Склад));
	ВывестиПроводки(Лог, Док.Ссылка);
	Возврат Док.Ссылка;

КонецФункции

&НаСервере
Функция СуммаУслуг(Объект)
	// В БП услуги лежат в отдельной ТЧ и заменой товарных строк не трогаются,
	// но в сумму документа входят.
	Попытка
		Сумма = 0;
		Для Каждого Строка Из Объект.Услуги Цикл
			Сумма = Сумма + Строка.Сумма;
		КонецЦикла;
		Возврат Сумма;
	Исключение
		Возврат 0;
	КонецПопытки;
КонецФункции

&НаСервере
Процедура ЗаменитьТоварныеСтроки(Объект, Комплект, ИтогоСумма, ИтогоНДС, КоличествоНаборов, Задание, Лог)

	Первая = Объект.Товары[0];
	СчетУчета = Первая.СчетУчета;
	СчетДоходов = Первая.СчетДоходов;
	СчетРасходов = Первая.СчетРасходов;
	СчетНДС = Первая.СчетУчетаНДСПоРеализации;
	Субконто = Первая.Субконто;
	СтавкаНДС = Первая.СтавкаНДС;
	ЕдиницаИзмерения = Первая.ЕдиницаИзмерения;
	Коэффициент = Первая.Коэффициент;

	Объект.Товары.Очистить();
	Новая = Объект.Товары.Добавить();
	Новая.Номенклатура = Комплект;
	Новая.Количество = КоличествоНаборов;
	Новая.Цена = Окр(ИтогоСумма / Новая.Количество, 2);
	Новая.Сумма = ИтогоСумма;
	Новая.СуммаНДС = ИтогоНДС;
	Новая.СтавкаНДС = СтавкаНДС;
	УстановитьРеквизитСтроки(Новая, "СчетУчета", СчетУчета);
	УстановитьРеквизитСтроки(Новая, "СчетДоходов", СчетДоходов);
	УстановитьРеквизитСтроки(Новая, "СчетРасходов", СчетРасходов);
	УстановитьРеквизитСтроки(Новая, "СчетУчетаНДСПоРеализации", СчетНДС);
	УстановитьРеквизитСтроки(Новая, "Субконто", Субконто);
	УстановитьРеквизитСтроки(Новая, "ЕдиницаИзмерения", ЕдиницаИзмерения);
	УстановитьРеквизитСтроки(Новая, "Коэффициент", Коэффициент);
	УстановитьРеквизитСтроки(Новая, "ИдентификаторСтроки", Новый УникальныйИдентификатор);

	Объект.СуммаДокумента = ИтогоСумма + СуммаУслуг(Объект);
	Стр(Лог, "стало: строка «" + СтрЗнач(Новая.Номенклатура)
		+ "», количество " + Формат(Новая.Количество, "ЧДЦ=3")
		+ ", цена " + Формат(Новая.Цена, "ЧДЦ=2")
		+ ", сумма " + Формат(Новая.Сумма, "ЧДЦ=2")
		+ ", НДС " + Формат(Новая.СуммаНДС, "ЧДЦ=2"));

	Проведен = ЗаписатьИПровести(Объект, Задание, Лог);
	Стр(Лог, "продажа проведена: " + ?(Проведен, "да", "нет")
		+ ", строк товаров " + Формат(Объект.Товары.Количество(), "ЧГ=0")
		+ ", строк услуг " + Формат(Объект.Услуги.Количество(), "ЧГ=0")
		+ ", сумма документа " + Формат(Объект.СуммаДокумента, "ЧДЦ=2"));
	ВывестиПроводки(Лог, Объект.Ссылка);

КонецПроцедуры

// ================== РЕЖИМ «УБОРКА» (стенд, БП) ==============================
// Удаляет следы прежних подходов у карточки комплекта: сборки, созданные не
// постобработкой (комментарий не «Сборка под продажу…»), и спецификации,
// названные не «Реализация…». Нужен, чтобы на стенде осталась ровно одна
// карточка, по одной спецификации и сборке на продажу.

&НаСервере
Процедура РежимУборка(Задание, ИмяБазы, Лог)

	Секция(Лог, "Уборка следов прежних прогонов");

	ИмяКомплекта = Параметр(Задание, "комплект", "");
	Комплект = НайтиПоНаименованиюВхождение("Номенклатура", ИмяКомплекта);
	Если Не ЗначениеЗаполнено(Комплект) Тогда
		Стр(Лог, "комплект «" + ИмяКомплекта + "» не найден");
		Возврат;
	КонецЕсли;
	Стр(Лог, "комплект: " + СтрЗнач(Комплект));

	// «все=да» — снести у карточки всё, включая спецификации и сборки,
	// созданные постобработкой (перед чистым повторным прогоном).
	Все = Флаг(Задание, "все", Ложь);
	Стр(Лог, "режим уборки: " + ?(Все, "все объекты карточки", "только следы прежних подходов"));

	// --- сборки
	Попытка
		ТекстЗапроса = "ВЫБРАТЬ Ссылка КАК Ссылка ИЗ Документ.КомплектацияНоменклатуры ГДЕ Номенклатура = &Комплект";
		Если Не Все Тогда
			ТекстЗапроса = ТекстЗапроса + " И НЕ Комментарий ПОДОБНО ""Сборка под продажу%""";
		КонецЕсли;
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("Комплект", Комплект);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Попытка
				Выборка.Ссылка.ПолучитьОбъект().Удалить();
				Стр(Лог, "удалена сборка: " + СтрЗнач(Выборка.Ссылка));
			Исключение
				Стр(Лог, "сборка " + СтрЗнач(Выборка.Ссылка) + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
		КонецЦикла;
	Исключение
		Стр(Лог, "поиск сборок: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	// --- спецификации
	Удалённые = Новый Массив;
	Попытка
		ТекстЗапроса = "ВЫБРАТЬ Ссылка КАК Ссылка ИЗ Справочник.СпецификацииНоменклатуры ГДЕ Владелец = &Комплект";
		Если Не Все Тогда
			ТекстЗапроса = ТекстЗапроса + " И НЕ Наименование ПОДОБНО ""Реализация%""";
		КонецЕсли;
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("Комплект", Комплект);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Попытка
				Выборка.Ссылка.ПолучитьОбъект().Удалить();
				Удалённые.Добавить(Выборка.Ссылка);
				Стр(Лог, "удалена спецификация: " + СтрЗнач(Выборка.Ссылка));
			Исключение
				Стр(Лог, "спецификация " + СтрЗнач(Выборка.Ссылка) + ": "
					+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
		КонецЦикла;
	Исключение
		Стр(Лог, "поиск спецификаций: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	// --- указатель «основная спецификация» в карточке
	Попытка
		ОбъектКомплекта = Комплект.ПолучитьОбъект();
		Основная = ОбъектКомплекта.ОсновнаяСпецификацияНоменклатуры;
		Если ЗначениеЗаполнено(Основная) Тогда
			Запрос = Новый Запрос(
				"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка КАК Ссылка ИЗ Справочник.СпецификацииНоменклатуры ГДЕ Ссылка = &Ссылка");
			Запрос.УстановитьПараметр("Ссылка", Основная);
			Если Запрос.Выполнить().Пустой() Тогда
				ОбъектКомплекта.ОсновнаяСпецификацияНоменклатуры = Справочники["СпецификацииНоменклатуры"].ПустаяСсылка();
				ОбъектКомплекта.Записать();
				Стр(Лог, "основная спецификация карточки очищена (указывала на удалённую)");
			Иначе
				Стр(Лог, "основная спецификация карточки: " + СтрЗнач(Основная) + " — оставлена");
			КонецЕсли;
		КонецЕсли;
	Исключение
		Стр(Лог, "основная спецификация: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	// --- что осталось
	Попытка
		Запрос = Новый Запрос(
			"ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего ИЗ Справочник.СпецификацииНоменклатуры ГДЕ Владелец = &Комплект");
		Запрос.УстановитьПараметр("Комплект", Комплект);
		Счёт = Запрос.Выполнить().Выбрать();
		Счёт.Следующий();
		Стр(Лог, "спецификаций у карточки осталось: " + Формат(Счёт.Всего, "ЧГ=0"));
		Запрос = Новый Запрос(
			"ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего ИЗ Документ.КомплектацияНоменклатуры ГДЕ Номенклатура = &Комплект");
		Запрос.УстановитьПараметр("Комплект", Комплект);
		Счёт = Запрос.Выполнить().Выбрать();
		Счёт.Следующий();
		Стр(Лог, "сборок у карточки осталось: " + Формат(Счёт.Всего, "ЧГ=0"));
	Исключение
		Стр(Лог, "итоговый подсчёт: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

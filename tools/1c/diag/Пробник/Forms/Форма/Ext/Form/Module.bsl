// Диагностика базы для книги «Комплекты и наборы в УТ 11.5 → БП 3.0».
// Конфигуранезависима: объекты ищутся по подстроке имени, а не по жёсткому
// списку, поэтому один и тот же файл работает и в УТ, и в БП.
// Пишет JSON в /tmp/opencode и сам завершает сеанс (клиентский ПриОткрытии).
//
// Сборка и прогон — см. tools/1c/diag/README.md

// Прогресс-лог: если диагностика зависнет, по последней строке видно, где.
&НаСервере
Процедура Прогресс(ТекстШага)
	Попытка
		ДобавитьВТекстФайл("/tmp/opencode/diag_progress.txt",
			Формат(ТекущаяДатаСеанса(), "ДФ=ss") + " " + ТекстШага);
	Исключение
	КонецПопытки;
КонецПроцедуры

&НаСервере
Функция СтрТип(ЗначениеТипа)
	Попытка
		Возврат Строка(ЗначениеТипа);
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

&НаСервере
Функция СтрЗнач(Значение)
	Попытка
		Если Значение = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		Текст = Строка(Значение);
		Если СтрДлина(Текст) > 200 Тогда
			Текст = Лев(Текст, 200) + "…";
		КонецЕсли;
		Возврат Текст;
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

&НаСервере
Функция СтрСиноним(ОбъектМетаданных)
	Попытка
		Хранилище = ОбъектМетаданных.Синоним;
		Если Хранилище = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		Возврат СтрЗнач(Хранилище.Получить());
	Исключение
		Возврат "";
	КонецПопытка;
КонецФункции

&НаСервере
Функция КлючевыеСлова()
	Список = Новый Массив;
	Список.Добавить("Комплект");
	Список.Добавить("Разукомпл");
	Список.Добавить("Набор");
	Список.Добавить("Сборка");
	Список.Добавить("Разборка");
	Список.Добавить("Спецификац");
	Возврат Список;
КонецФункции

&НаСервере
Функция Подходит(Имя, СписокСлов)
	Для Каждого Слово Из СписокСлов Цикл
		Если Найти(ВРег(Имя), ВРег(Слово)) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

&НаСервере
Функция РеквизитыМетаданных(МетаОбъект)
	Результат = Новый Массив;
	Попытка
		Для Каждого Реквизит Из МетаОбъект.Реквизиты Цикл
			Результат.Добавить(Новый Структура("имя,тип,обязательный",
				Реквизит.Имя, СтрТип(Реквизит.Тип), Реквизит.ОбязательноеЗаполнение));
		КонецЦикла;
	Исключение
		Возврат Результат;
	КонецПопытки;
	Возврат Результат;
КонецФункции

&НаСервере
Функция ТабличныеЧастиМетаданных(МетаОбъект)
	Результат = Новый Массив;
	Попытка
		Для Каждого ТЧ Из МетаОбъект.ТабличныеЧасти Цикл
			Колонки = Новый Массив;
			Для Каждого Колонка Из ТЧ.Реквизиты Цикл
				Колонки.Добавить(Новый Структура("имя,тип", Колонка.Имя, СтрТип(Колонка.Тип)));
			КонецЦикла;
			Результат.Добавить(Новый Структура("имя,колонок,колонки",
				ТЧ.Имя, ТЧ.Реквизиты.Количество(), Колонки));
		КонецЦикла;
	Исключение
		Возврат Результат;
	КонецПопытки;
	Возврат Результат;
КонецФункции

&НаСервере
Функция ВидРегистра(ИмяРегистра)
	Попытка
		Если Метаданные.РегистрыНакопления.Найти(ИмяРегистра) <> Неопределено Тогда
			Возврат "накопления";
		ИначеЕсли Метаданные.РегистрыБухгалтерии.Найти(ИмяРегистра) <> Неопределено Тогда
			Возврат "бухгалтерии";
		ИначеЕсли Метаданные.РегистрыСведений.Найти(ИмяРегистра) <> Неопределено Тогда
			Возврат "сведений";
		ИначеЕсли Метаданные.РегистрыРасчетов.Найти(ИмяРегистра) <> Неопределено Тогда
			Возврат "расчетов";
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат "";
КонецФункции

&НаСервере
Функция НаборыДвижений(МетаОбъект)
	// [ {регистр, вид} ] — куда документ умеет писать движения.
	Результат = Новый Массив;
	Попытка
		Для Каждого Набор Из МетаОбъект.Движения Цикл
			Результат.Добавить(Новый Структура("регистр,вид", Набор.Имя, ВидРегистра(Набор.Имя)));
		КонецЦикла;
	Исключение
		Возврат Результат;
	КонецПопытки;
	Возврат Результат;
КонецФункции

&НаСервере
Функция ЕстьПроводки(МетаОбъект)
	Попытка
		СчетДт = Неопределено;
		Возврат МетаОбъект.Проводки.Свойство("СчетДт", СчетДт);
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

&НаСервере
Функция ИсточникДвижений(ИмяРегистра, Вид)
	Если Вид = "накопления" Тогда
		Возврат "РегистрНакопления." + ИмяРегистра + ".Движения";
	ИначеЕсли Вид = "бухгалтерии" Тогда
		Возврат "РегистрБухгалтерии." + ИмяРегистра + ".Движения";
	ИначеЕсли Вид = "сведений" Тогда
		Возврат "РегистрСведений." + ИмяРегистра + ".Движения";
	ИначеЕсли Вид = "расчетов" Тогда
		Возврат "РегистрРасчетов." + ИмяРегистра + ".Движения";
	КонецЕсли;
	Возврат "";
КонецФункции

&НаСервере
Функция ПроводкиДокумента(Ссылка, Ошибки)
	Результат = Новый Структура("есть,всего,строки", Ложь, 0, Новый Массив);
	Попытка
		Объект = Ссылка.ПолучитьОбъект();
		Проводки = Объект.Проводки;
		Результат.есть = Истина;
		Для Каждого Проводка Из Проводки Цикл
			Результат.всего = Результат.всего + 1;
			Если Результат.строки.Количество() >= 60 Тогда
				Продолжить;
			КонецЕсли;
			СтрокаП = Новый Структура;
			СтрокаП.Вставить("регистратор", СтрЗнач(Проводка.Регистратор));
			СтрокаП.Вставить("счетДт", СтрЗнач(Проводка.СчетДт));
			СтрокаП.Вставить("субконтоДт",
				СтрЗнач(Проводка.СубконтоДт[1]) + " | " + СтрЗнач(Проводка.СубконтоДт[2]) + " | " + СтрЗнач(Проводка.СубконтоДт[3]));
			СтрокаП.Вставить("счетКт", СтрЗнач(Проводка.СчетКт));
			СтрокаП.Вставить("субконтоКт",
				СтрЗнач(Проводка.СубконтоКт[1]) + " | " + СтрЗнач(Проводка.СубконтоКт[2]) + " | " + СтрЗнач(Проводка.СубконтоКт[3]));
			СтрокаП.Вставить("сумма", СтрЗнач(Проводка.Сумма));
			СтрокаП.Вставить("количествоДт", СтрЗнач(Проводка.КоличествоДт));
			СтрокаП.Вставить("количествоКт", СтрЗнач(Проводка.КоличествоКт));
			СтрокаП.Вставить("содержание", СтрЗнач(Проводка.Содержание));
			Результат.строки.Добавить(СтрокаП);
		КонецЦикла;
	Исключение
		Результат.есть = Истина;
		Ошибки.Добавить("проводки " + СтрЗнач(Ссылка) + ": " + ОписаниеОшибки());
	КонецПопытки;
	Возврат Результат;
КонецФункции

&НаСервере
Функция ТаблицаЗапросаСтруктурой(Запрос, МаксимумСтрок, Ошибки, ТегОшибки)
	// Универсальное {коллонки, строк, строки} без знания состава колонок.
	Результат = Новый Структура("колонок,колонки,строк,строки", 0, "", 0, Новый Массив);
	Попытка
		Таблица = Запрос.Выполнить().Выгрузить();
		Для Каждого Колонка Из Таблица.Колонки Цикл
			Результат.колонок = Результат.колонок + 1;
			Результат.колонки = ?(Результат.колонки = "", Колонка.Имя, Результат.колонки + "," + Колонка.Имя);
		КонецЦикла;
		Для Каждого СтрокаТаб Из Таблица Цикл
			Если Результат.строк >= МаксимумСтрок Тогда
				Продолжить;
			КонецЕсли;
			Результат.строк = Результат.строк + 1;
			Значения = Новый Структура;
			Для Каждого Колонка Из Таблица.Колонки Цикл
				Значения.Вставить(Колонка.Имя, СтрЗнач(СтрокаТаб[Колонка.Имя]));
			КонецЦикла;
			Результат.строки.Добавить(Значения);
		КонецЦикла;
	Исключение
		Ошибки.Добавить(ТегОшибки + ": " + ОписаниеОшибки());
	КонецПопытки;
	Возврат Результат;
КонецФункции

&НаСервере
Функция ДвиженияПоРегистрам(Ссылка, МетаОбъект, Ошибки)
	// Для регистра, который этот документ реально движет: колонки и до 8 строк.
	Результат = Новый Массив;
	Для Каждого Набор Из НаборыДвижений(МетаОбъект) Цикл
		Источник = ИсточникДвижений(Набор.регистр, Набор.вид);
		Если Источник = "" Тогда
			Продолжить;
		КонецЕсли;
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 8 *
		|ИЗ " + Источник + " КАК Движения
		|ГДЕ Движения.Регистратор = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		Данные = ТаблицаЗапросаСтруктурой(Запрос, 8, Ошибки, "движения " + Набор.регистр + " " + СтрЗнач(Ссылка));
		Если Данные.строк > 0 Тогда
			Результат.Добавить(Новый Структура("регистр,вид,строк,колонки,строки",
				Набор.регистр, Набор.вид, Данные.строк, Данные.колонки, Данные.строки));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаСервере
Функция ЗначенияРеквизитов(Объект, МетаОбъект)
	Рекв = Новый Структура;
	Для Каждого Реквизит Из МетаОбъект.Реквизиты Цикл
		Попытка
			Рекв.Вставить(Реквизит.Имя, СтрЗнач(Объект[Реквизит.Имя]));
		Исключение
		КонецПопытки;
	КонецЦикла;
	Возврат Рекв;
КонецФункции

&НаСервере
Функция ЗначенияТабличныхЧастей(Объект, МетаОбъект)
	ТЧ = Новый Структура;
	Для Каждого ОписаниеТЧ Из МетаОбъект.ТабличныеЧасти Цикл
		Строки = Новый Массив;
		Попытка
			Для Каждого СтрокаТЧ Из Объект[ОписаниеТЧ.Имя] Цикл
				Если Строки.Количество() >= 25 Тогда
					Продолжить;
				КонецЕсли;
				Значения = Новый Структура;
				Для Каждого Колонка Из ОписаниеТЧ.Реквизиты Цикл
					Попытка
						Значения.Вставить(Колонка.Имя, СтрЗнач(СтрокаТЧ[Колонка.Имя]));
					Исключение
					КонецПопытки;
				КонецЦикла;
				Строки.Добавить(Значения);
			КонецЦикла;
		Исключение
		КонецПопытки;
		ТЧ.Вставить(ОписаниеТЧ.Имя, Строки);
	КонецЦикла;
	Возврат ТЧ;
КонецФункции

&НаСервере
Функция СколькоДокументов(ИмяДокумента, Ошибки)
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(Ссылка) КАК Количество ИЗ Документ." + ИмяДокумента;
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Количество;
		КонецЕсли;
	Исключение
		Ошибки.Добавить("подсчёт " + ИмяДокумента + ": " + ОписаниеОшибки());
	КонецПопытки;
	Возврат -1;
КонецФункции

&НаСервере
Функция ДанныеДокументов(МетаОбъект, Количество, Ошибки)
	Результат = Новый Структура("всего,документы", СколькоДокументов(МетаОбъект.Имя, Ошибки), Новый Массив);
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ " + Формат(Количество, "ЧН=0") + "
		|	Документ." + МетаОбъект.Имя + ".Ссылка КАК Ссылка,
		|	Документ." + МетаОбъект.Имя + ".Проведён КАК Проведён,
		|	Документ." + МетаОбъект.Имя + ".Дата КАК Дата
		|ИЗ Документ." + МетаОбъект.Имя + " КАК Документ
		|УПОРЯДОЧИТЬ ПО Дата УБЫВ";
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Ссылка = Выборка.Ссылка;
			Док = Новый Структура;
			Док.Вставить("документ", СтрЗнач(Ссылка));
			Док.Вставить("проведен", Выборка.Проведён);
			Док.Вставить("дата", Формат(Выборка.Дата, "ДФ=yyyy-MM-dd HH:mm:ss"));
			Попытка
				Объект = Ссылка.ПолучитьОбъект();
				Док.Вставить("реквизиты", ЗначенияРеквизитов(Объект, МетаОбъект));
				Док.Вставить("табличныеЧасти", ЗначенияТабличныхЧастей(Объект, МетаОбъект));
			Исключение
				Ошибки.Добавить("объект " + МетаОбъект.Имя + ": " + ОписаниеОшибки());
			КонецПопытки;
			Если ЕстьПроводки(МетаОбъект) Тогда
				Док.Вставить("проводки", ПроводкиДокумента(Ссылка, Ошибки));
			КонецЕсли;
			Док.Вставить("движения", ДвиженияПоРегистрам(Ссылка, МетаОбъект, Ошибки));
			Результат.документы.Добавить(Док);
		КонецЦикла;
	Исключение
		Ошибки.Добавить("выборка " + МетаОбъект.Имя + ": " + ОписаниеОшибки());
	КонецПопытки;
	Возврат Результат;
КонецФункции

&НаСервере
Функция ОбзорОбмена(СловаОбмена, Ошибки)
	ЧтоЕсть = Новый Массив;
	Попытка
		Для Каждого Обр Из Метаданные.Обработки Цикл
			Если Подходит(Обр.Имя, СловаОбмена) Тогда
				ЧтоЕсть.Добавить(Новый Структура("вид,имя", "обработка", Обр.Имя));
			КонецЕсли;
		КонецЦикла;
		Для Каждого Отч Из Метаданные.Отчеты Цикл
			Если Подходит(Отч.Имя, СловаОбмена) Тогда
				ЧтоЕсть.Добавить(Новый Структура("вид,имя", "отчет", Отч.Имя));
			КонецЕсли;
		КонецЦикла;
		Для Каждого Мод Из Метаданные.ОбщиеМодули Цикл
			Если Подходит(Мод.Имя, СловаОбмена) Тогда
				ЧтоЕсть.Добавить(Новый Структура("вид,имя", "общийМодуль", Мод.Имя));
			КонецЕсли;
		КонецЦикла;
		Для Каждого Под Из Метаданные.Подсистемы Цикл
			Если Подходит(Под.Имя, СловаОбмена) Тогда
				ЧтоЕсть.Добавить(Новый Структура("вид,имя", "подсистема", Под.Имя));
			КонецЕсли;
		КонецЦикла;
	Исключение
		Ошибки.Добавить("обзор обмена: " + ОписаниеОшибки());
	КонецПопытки;
	Возврат ЧтоЕсть;
КонецФункции

&НаСервере
Функция ОбзорПлановОбмена(Ошибки)
	Планы = Новый Массив;
	Попытка
		Для Каждого План Из Метаданные.ПланыОбмена Цикл
			Запись = Новый Структура("имя,синоним,разделятьДанные,узлы",
				План.Имя, СтрСиноним(План), "", "");
			Попытка
				Запись.разделятьДанные = Строка(План.РазделятьДанные);
			Исключение
			КонецПопытки;
			Попытка
				Запрос = Новый Запрос;
				Запрос.Текст =
				"ВЫБРАТЬ Узлы.Ссылка КАК Ссылка, Узлы.Наименование КАК Наименование
				|ИЗ ПланОбмена." + План.Имя + " КАК Узлы";
				Выборка = Запрос.Выполнить().Выбрать();
				Пока Выборка.Следующий() Цикл
					Запись.узлы = Запись.узлы + ?(Запись.узлы = "", "", "; ") + СтрЗнач(Выборка.Наименование);
				КонецЦикла;
			Исключение
				Запись.узлы = "таблица узлов недоступна";
			КонецПопытки;
			Планы.Добавить(Запись);
		КонецЦикла;
	Исключение
		Ошибки.Добавить("планы обмена: " + ОписаниеОшибки());
	КонецПопытки;
	Возврат Планы;
КонецФункции

&НаСервере
Функция ОбзорНоменклатуры(Ошибки)
	Результат = Новый Структура;
	Спр = Метаданные.Справочники.Найти("Номенклатура");
	Если Спр = Неопределено Тогда
		Результат.Вставить("есть", Ложь);
		Возврат Результат;
	КонецЕсли;
	Результат.Вставить("есть", Истина);
	Результат.Вставить("реквизиты", РеквизитыМетаданных(Спр));
	Элементы = Новый Массив;
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 15
		|	Номенклатура.Ссылка КАК Ссылка,
		|	Номенклатура.Наименование КАК Наименование,
		|	Номенклатура.ПометкаУчета КАК ПометкаУчета
		|ИЗ Справочник.Номенклатура КАК Номенклатура
		|ГДЕ ВРЕГ(Номенклатура.Наименование) ПОДОБНО &Шаблон";
		Запрос.УстановитьПараметр("Шаблон", "%НАБОР%");
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Элементы.Добавить(Новый Структура("ссылка,наименование",
				СтрЗнач(Выборка.Ссылка), Выборка.Наименование));
		КонецЦикла;
	Исключение
		Ошибки.Добавить("номенклатура: " + ОписаниеОшибки());
	КонецПопытки;
	Результат.Вставить("элементыСоСловомНабор", Элементы);
	Возврат Результат;
КонецФункции

&НаСервере
Функция Обзоры(Ошибки)
	Прогресс("обзор: начало");
	СписокСлов = КлючевыеСлова();
	Обзор = Новый Структура;

	Найденные = Новый Массив;
	Попытка
		Для Каждого Док Из Метаданные.Документы Цикл
			Если Подходит(Док.Имя, СписокСлов) Тогда
				Найденные.Добавить(Док);
			КонецЕсли;
		КонецЦикла;
	Исключение
		Ошибки.Добавить("перебор документов: " + ОписаниеОшибки());
	КонецПопытки;

	СписокДокументов = Новый Массив;
	Для Каждого Док Из Найденные Цикл
		СписокДокументов.Добавить(Новый Структура("имя,синоним,проводки,движений",
			Док.Имя, СтрСиноним(Док), ЕстьПроводки(Док), Док.Движения.Количество()));
	КонецЦикла;
	Обзор.Вставить("документыПоКлючевымСловам", СписокДокументов);

	Подробно = Новый Массив;
	Для Каждого Док Из Найденные Цикл
		Прогресс("разбор документа: " + Док.Имя);
		Разбор = Новый Структура;
		Разбор.Вставить("имя", Док.Имя);
		Разбор.Вставить("синоним", СтрСиноним(Док));
		Разбор.Вставить("реквизиты", РеквизитыМетаданных(Док));
		Разбор.Вставить("табличныеЧасти", ТабличныеЧастиМетаданных(Док));
		Разбор.Вставить("движения", НаборыДвижений(Док));
		Разбор.Вставить("естьПроводки", ЕстьПроводки(Док));
		Разбор.Вставить("данные", ДанныеДокументов(Док, 4, Ошибки));
		Подробно.Добавить(Разбор);
	КонецЦикла;
	Обзор.Вставить("разборДокументов", Подробно);

	ПоСправочникам = Новый Массив;
	Попытка
		Для Каждого Спр Из Метаданные.Справочники Цикл
			Если Подходит(Спр.Имя, СписокСлов) Тогда
				ПоСправочникам.Добавить(Новый Структура("имя,синоним", Спр.Имя, СтрСиноним(Спр)));
			КонецЕсли;
		КонецЦикла;
	Исключение
		Ошибки.Добавить("перебор справочников: " + ОписаниеОшибки());
	КонецПопытки;
	Обзор.Вставить("справочники", ПоСправочникам);

	ПоРегистрам = Новый Массив;
	Попытка
		Для Каждого Рег Из Метаданные.РегистрыСведений Цикл
			Если Подходит(Рег.Имя, СписокСлов) Тогда
				ПоРегистрам.Добавить(Новый Структура("имя,вид", Рег.Имя, "сведений"));
			КонецЕсли;
		КонецЦикла;
		Для Каждого Рег Из Метаданные.РегистрыНакопления Цикл
			Если Подходит(Рег.Имя, СписокСлов) Тогда
				ПоРегистрам.Добавить(Новый Структура("имя,вид", Рег.Имя, "накопления"));
			КонецЕсли;
		КонецЦикла;
	Исключение
		Ошибки.Добавить("перебор регистров: " + ОписаниеОшибки());
	КонецПопытки;
	Обзор.Вставить("регистры", ПоРегистрам);

	ПоПеречислениям = Новый Массив;
	Попытка
		Для Каждого Пер Из Метаданные.Перечисления Цикл
			Если Подходит(Пер.Имя, СписокСлов) Тогда
				Значения = Новый Массив;
				Для Каждого ЗначениеПер Из Пер.Значения Цикл
					Значения.Добавить(ЗначениеПер.Имя);
				КонецЦикла;
				ПоПеречислениям.Добавить(Новый Структура("имя,значения", Пер.Имя, Значения));
			КонецЕсли;
		КонецЦикла;
	Исключение
		Ошибки.Добавить("перебор перечислений: " + ОписаниеОшибки());
	КонецПопытки;
	Обзор.Вставить("перечисления", ПоПеречислениям);

	Прогресс("планы обмена");
	Обзор.Вставить("планыОбмена", ОбзорПлановОбмена(Ошибки));

	СловаОбмена = Новый Массив;
	СловаОбмена.Добавить("Обмен");
	СловаОбмена.Добавить("Конверт");
	СловаОбмена.Добавить("EnterpriseData");
	СловаОбмена.Добавить("Синхронизац");
	СловаОбмена.Добавить("Взаимодейств");
	Обзор.Вставить("обменСредства", ОбзорОбмена(СловаОбмена, Ошибки));

	Прогресс("номенклатура");
	Обзор.Вставить("номенклатура", ОбзорНоменклатуры(Ошибки));

	Возврат Обзор;
КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяСсылка)

	Ошибки = Новый Массив;
	Данные = Новый Структура;
	Путь = "/tmp/opencode/diag_" + Метаданные.Имя + ".json";

	Попытка
		Данные.Вставить("диагностика", "комплекты и наборы, снимок живой базы");
		Данные.Вставить("момент", Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd HH:mm:ss"));
		Данные.Вставить("конфигурация", Метаданные.Имя);
		Данные.Вставить("версияКонфигурации", Метаданные.Версия);
		Данные.Вставить("префикс", Метаданные.ПрефиксИмени);
		Данные.Вставить("документовВМетаданных", Метаданные.Документы.Количество());
		Данные.Вставить("обзор", Обзоры(Ошибки));
		Данные.Вставить("ошибки", Ошибки);
	Исключение
		// любая незащищённая ошибка иначе вешает сеанс молча — пишем crash-файл
		Попытка
			Т = Новый ЗаписьТекста(Путь + ".crash.txt", КодировкаТекста.UTF8, "", Истина);
			Т.Записать("незакрытое исключение: " + ОписаниеОшибки(Истина));
			Т.Закрыть();
		Исключение
		КонецПопытки;
	КонецПопытки;

	Попытка
		Текст = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8, "", Истина);
		Запись = Новый ЗаписьJSON;
		Запись.Установить(Текст, Новый НастройкиСериализацииJSON, ФлагКонтроляЦиклическихСсылок.Контролировать);
		ЗаписатьJSON(Запись, Данные);
		Запись.Закрыть();
		Текст.Закрыть();
	Исключение
		Попытка
			Текст = Новый ЗаписьТекста(Путь + ".error.txt", КодировкаТекста.UTF8, "", Истина);
			Текст.Записать(Путь + " не записан: " + ОписаниеОшибки() + " | " + Строка(Ошибки));
			Текст.Закрыть();
		Исключение
		КонецПопытки;
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры

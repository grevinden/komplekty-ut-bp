&НаСервере
Функция НоменклатураТест(Наименование, Ошибки)
	// Идемпотентно: если позиция уже есть — берём её.
	Спр = Справочники.Номенклатура.НайтиПоНаименованию(Наименование, Истина);
	// Не «<> Неопределено»: при пустом справочнике метод отдаёт пустую ссылку,
	// и проверка на Неопределено пропускает её как готовую позицию.
	Если Спр <> Неопределено И ЗначениеЗаполнено(Спр) Тогда
		Возврат Спр;
	КонецЕсли;
	Вид = Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Товары", Истина);
	Если Вид = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Вид) Тогда
		Ошибки.Добавить("нет вида номенклатуры ""Товары""");
		Возврат Неопределено;
	КонецЕсли;
	Элемент = Справочники.Номенклатура.СоздатьЭлемент();
	Элемент.Наименование = Наименование;
	Элемент.ВидНоменклатуры = Вид;
	Попытка
		Элемент.Записать();
	Исключение
		Ошибки.Добавить("номенклатура " + Наименование + ": " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
	Возврат Элемент.Ссылка;

	Итог = Новый Массив;
	Коды = "41.01,41.02,43,10.01,10.21.1,20.01,45.01";
	Для Каждого Код Из СтрРазделить(Коды, ",") Цикл
		Попытка
			Счет = ПланыСчетов.Хозрасчетный.НайтиПоКоду(СокрЛП(Код));
			Запись = Новый Структура("счет,виды", СокрЛП(Код), "");
			Если Счет <> Неопределено Тогда
				Виды = ВидыСубконтоСчета(Счет, Ошибки);
				Для Каждого Вид Из Виды Цикл
					Запись.виды = Запись.виды + ?(Запись.виды = "", "", ", ") + ЗначениеСтрокой(Вид);
				КонецЦикла;
			Иначе
				Запись.виды = "счёта нет";
			КонецЕсли;
			Итог.Добавить(Запись);
		Исключение
			Ошибки.Добавить("субконто счёта " + Код + ": " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
	Возврат Итог;
КонецФункции

&НаСервере
Функция КоличествоНоменклатуры(Ошибки)
	// У справочника нет метода «Количество()» — считаем запросом.
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего ИЗ Справочник.Номенклатура КАК Ном";
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат СтрЗнач(Выборка.Всего);
		КонецЕсли;
	Исключение
		Ошибки.Добавить("количество номенклатуры: " + ОписаниеОшибки());
	КонецПопытки;
	Возврат "-";
КонецФункции

&НаСервере
Функция ПроверкаНоменклатурыБазой(Ошибки)
	// Что вообще лежит в справочнике: если наименования пустые и в запросе,
	// дело не в способе чтения, а в данных базы.
	Результат = Новый Структура("всего,строк,строки", "", 0, Новый Массив);
	Результат.всего = КоличествоНоменклатуры(Ошибки);
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 8
		|	Ном.Ссылка КАК Ссылка,
		|	ВЫРАЗИТЬ(Ном.Наименование КАК СТРОКА(100)) КАК Наименование,
		|	Ном.Код КАК Код,
		|	Ном.ЭтоГруппа КАК ЭтоГруппа,
		|	Ном.ПометкаУдаления КАК ПометкаУдаления,
		|	Ном.ВидНоменклатуры КАК ВидНоменклатуры,
		|	Ном.НаименованиеПолное КАК НаименованиеПолное
		|ИЗ Справочник.Номенклатура КАК Ном
		|УПОРЯДОЧИТЬ ПО Ном.Наименование";
		Для Каждого Стр Из Запрос.Выполнить().Выгрузить() Цикл
			Запись = Новый Структура;
			Запись.Вставить("наименование", ПолеСтрокой(Стр, "Наименование"));
			Запись.Вставить("код", ПолеСтрокой(Стр, "Код"));
			Запись.Вставить("группа", ПолеСтрокой(Стр, "ЭтоГруппа"));
			Запись.Вставить("пометка", ПолеСтрокой(Стр, "ПометкаУдаления"));
			Запись.Вставить("вид", ПолеСтрокой(Стр, "ВидНоменклатуры"));
			Запись.Вставить("полное", ПолеСтрокой(Стр, "НаименованиеПолное"));
			Запись.Вставить("ссылка", ЗначениеСтрокой(Стр.Ссылка));
			Результат.строки.Добавить(Запись);
		КонецЦикла;
		Результат.строк = Результат.строки.Количество();
	Исключение
		Ошибки.Добавить("проверка номенклатуры: " + ОписаниеОшибки());
	КонецПопытки;
	Возврат Результат;
КонецФункции

&НаСервере
Функция МикроТестНоменклатуры(Ошибки)
	// Почему создание номенклатуры даёт пустую ссылку — проверяем по шагам.
	Итог = Новый Структура;
	Попытка
		Итог.Вставить("было", КоличествоНоменклатуры(Ошибки));
		Вид = Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Товары", Истина);
		Итог.Вставить("вид", ЗначениеСтрокой(Вид));
		Найденное = Справочники.Номенклатура.НайтиПоНаименованию("Такого нет", Истина);
		Итог.Вставить("поискОтсутствующего", "тип=" + Строка(ТипЗнч(Найденное)) + ", заполнено=" + Строка(ЗначениеЗаполнено(Найденное)));
		Итог.Вставить("поискОтсутствующегоСтрокой", ЗначениеСтрокой(Найденное));
		Эл = Справочники.Номенклатура.СоздатьЭлемент();
		Эл.Наименование = "МикроТест " + Формат(ТекущаяДата(), "ДФ=HHmmss");
		Если Вид <> Неопределено Тогда
			Эл.ВидНоменклатуры = Вид;
		КонецЕсли;
		Попытка
			Эл.Записать();
			Итог.Вставить("запись", "ок");
		Исключение
			Итог.Вставить("запись", "ошибка: " + ОписаниеОшибки());
		КонецПопытки;
		Итог.Вставить("ссылкаЗаполнена", СтрЗнач(ЗначениеЗаполнено(Эл.Ссылка)));
		Итог.Вставить("наименованиеЭлемента", СтрЗнач(Эл.Наименование));
		Итог.Вставить("стало", КоличествоНоменклатуры(Ошибки));
		Итог.Вставить("нашлиПослеЗаписи", ЗначениеСтрокой(Справочники.Номенклатура.НайтиПоНаименованию(Эл.Наименование, Истина)));
		Три = "";
		Для Н = 1 По 3 Цикл
			Эл2 = Справочники.Номенклатура.СоздатьЭлемент();
			Эл2.Наименование = "Цикл " + Формат(Н, "ЧГ=0");
			Если Вид <> Неопределено И ЗначениеЗаполнено(Вид) Тогда
				Эл2.ВидНоменклатуры = Вид;
			КонецЕсли;
			Попытка
				Эл2.Записать();
				Три = Три + "; " + Формат(Н, "ЧГ=0") + ": записан, заполнено=" + Строка(ЗначениеЗаполнено(Эл2.Ссылка)) + ", в базе=" + КоличествоНоменклатуры(Ошибки);
			Исключение
				Три = Три + "; " + Формат(Н, "ЧГ=0") + ": ошибка записи: " + ОписаниеОшибки();
			КонецПопытки;
		КонецЦикла;
		Итог.Вставить("триПодряд", Три);
	Исключение
		Итог.Вставить("общаяОшибка", ОписаниеОшибки());
	КонецПопытки;
	Возврат Итог;
КонецФункции

&НаСервере
Функция ПроверкаСубконто(Ошибки)
	// Как в этой базе устроены субконто: есть ли поля в таблице регистра, какая
	// виртуальная таблица отдаёт проводки с субконто и как называются колонки.
	Итог = Новый Структура;
	Попытка
		Итог.Вставить("максСубконто", СтрЗнач(Метаданные.РегистрыБухгалтерии.Хозрасчетный.МаксКоличествоСубконто));
	Исключение
		Ошибки.Добавить("максСубконто: " + ОписаниеОшибки());
		Итог.Вставить("максСубконто", "-");
	КонецПопытки;

	Попытки = Новый Структура;
	Попытки.Вставить("движенияССубконто",
		"ВЫБРАТЬ ПЕРВЫЕ 1 * ИЗ РегистрБухгалтерии.Хозрасчетный.ДвиженияССубконто");
	Попытки.Вставить("таблицаСубконто",
		"ВЫБРАТЬ ПЕРВЫЕ 1 * ИЗ РегистрБухгалтерии.Хозрасчетный.Субконто");
	Попытки.Вставить("основнаяТаблица",
		"ВЫБРАТЬ ПЕРВЫЕ 1 * ИЗ РегистрБухгалтерии.Хозрасчетный");
	Попытки.Вставить("тчПланаСчетов",
		"ВЫБРАТЬ ПЕРВЫЕ 1 * ИЗ ПланСчетов.Хозрасчетный.ВидыСубконто");

	Для Каждого Эл Из Попытки Цикл
		Имя = ИмяИзПары(Эл);
		Попытка
			Запрос = Новый Запрос;
			Запрос.Текст = СодержаниеИзПары(Эл);
			Таблица = Запрос.Выполнить().Выгрузить();
			Колонки = "";
			Для Каждого Колонка Из Таблица.Колонки Цикл
				Колонки = Колонки + ?(Колонки = "", "", ",") + Колонка.Имя;
			КонецЦикла;
			Итог.Вставить(Имя, "ок: " + Колонки);
		Исключение
			Итог.Вставить(Имя, "ошибка: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

	ТЧ = "";
	Попытка
		Для Каждого ТаблицаЧ Из Метаданные.ПланыСчетов.Хозрасчетный.ТабличныеЧасти Цикл
			ТЧ = ТЧ + ?(ТЧ = "", "", ",") + ТаблицаЧ.Имя;
		КонецЦикла;
	Исключение
		ТЧ = "ошибка: " + ОписаниеОшибки();
	КонецПопытки;
	Итог.Вставить("тчПланаСчетовМетаданные", ТЧ);
	Возврат Итог;
КонецФункции

&НаСервере
Процедура УдалитьПрежниеТесты(Ошибки)
	// Каждый прогон создаёт документы заново. Чтобы остатки и суммы не копились,
	// снимаем проведение у документов, помеченных нашим комментарием.
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Док.Ссылка КАК Ссылка
		|ИЗ Документ.КомплектацияНоменклатуры КАК Док
		|ГДЕ ВЫРАЗИТЬ(Док.Комментарий КАК СТРОКА(100)) = ВЫРАЗИТЬ(&Комментарий КАК СТРОКА(100))
		|ОБЪЕДИНИТЬ ВСЕ
		|ВЫБРАТЬ
		|	Док.Ссылка
		|ИЗ Документ.ОприходованиеТоваров КАК Док
		|ГДЕ ВЫРАЗИТЬ(Док.Комментарий КАК СТРОКА(100)) = ВЫРАЗИТЬ(&Комментарий КАК СТРОКА(100))";
		Запрос.УстановитьПараметр("Комментарий", "ТЕСТ КОМПЛЕКТЫ (Пробник)");
		Удалено = 0;
		Для Каждого Стр Из Запрос.Выполнить().Выгрузить() Цикл
			Об = Стр.Ссылка.ПолучитьОбъект();
			Если Об <> Неопределено Тогда
				Об.Записать(РежимЗаписиДокумента.ОтменаПроведения);
				Удалено = Удалено + 1;
			КонецЕсли;
		КонецЦикла;
		Прогресс("снято с проведения прежних тестовых документов: " + Формат(Удалено, "ЧГ=0"));
	Исключение
		Ошибки.Добавить("очистка прежних тестов: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаСервере
Функция ТестБП(Ошибки)
	// Живой тест БП: оприходование комплектующих → комплектация → разукомплектация.
	// Всё пишется в базу (она тестовая) и снимается по проводкам и остаткам.
	Результат = Новый Структура;
	Счет41 = ПланыСчетов.Хозрасчетный.НайтиПоКоду("41.01");
	Орг = ПервыйЭлемент(Справочники.Организации);
	Склад = ПервыйЭлемент(Справочники.Склады);
	Результат.Вставить("организация", СтрЗнач(Орг));
	Результат.Вставить("склад", СтрЗнач(Склад));
	Если Орг = Неопределено ИЛИ Склад = Неопределено Тогда
		Ошибки.Добавить("нет организации или склада");
		Возврат Результат;
	КонецЕсли;

	Готовые = НоменклатураИзБазы(Ошибки);
	Если Готовые.Количество() >= 3 Тогда
		Комплект = Готовые[0];
		Комп1 = Готовые[1];
		Комп2 = Готовые[2];
	Иначе
		Ошибки.Добавить("в базе меньше трёх товаров, создаю позиции программно");
		Комплект = НоменклатураТест("Тест Комплект", Ошибки);
		Комп1 = НоменклатураТест("Тест Комплектующая 1", Ошибки);
		Комп2 = НоменклатураТест("Тест Комплектующая 2", Ошибки);
	КонецЕсли;
	Результат.Вставить("проверкаСубконто", ПроверкаСубконто(Ошибки));
	Результат.Вставить("субконтоСчетов", СубконтоСчетов(Ошибки));
	Результат.Вставить("микроТестНоменклатуры", МикроТестНоменклатуры(Ошибки));
	Результат.Вставить("проверкаНоменклатурыБазой", ПроверкаНоменклатурыБазой(Ошибки));
	Результат.Вставить("номенклатура", ЗначениеСтрокой(Комплект) + " | " + ЗначениеСтрокой(Комп1) + " | " + ЗначениеСтрокой(Комп2));
	Результат.Вставить("типыНоменклатуры", СтрЗнач(ТипЗнч(Комплект)) + " | " + СтрЗнач(ТипЗнч(Комп1)));
	Результат.Вставить("диагностикаНоменклатуры", ДиагностикаСсылки(Комплект));
	Если Комплект = Неопределено ИЛИ Комп1 = Неопределено ИЛИ Комп2 = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	УдалитьПрежниеТесты(Ошибки);

	// 1. Приход комплектующих: 10 × 100 и 10 × 200.
	Оприходование = Документы.ОприходованиеТоваров.СоздатьДокумент();
	Оприходование.Дата = '20261001090000';
	Оприходование.Комментарий = "ТЕСТ КОМПЛЕКТЫ (Пробник)";
	Оприходование.Организация = Орг;
	Оприходование.Склад = Склад;
	Строка = Оприходование.Товары.Добавить();
	Строка.Номенклатура = Комп1;
	Строка.Количество = 10;
	Строка.Цена = 100;
	Строка.Сумма = 1000;
	Строка.СчетУчета = Счет41;
	Строка = Оприходование.Товары.Добавить();
	Строка.Номенклатура = Комп2;
	Строка.Количество = 10;
	Строка.Цена = 200;
	Строка.Сумма = 2000;
	Строка.СчетУчета = Счет41;
	Попытка
		Оприходование.Записать(РежимЗаписиДокумента.Проведение);
		Результат.Вставить("оприходование", СтрЗнач(Оприходование.Ссылка));
	Исключение
		Ошибки.Добавить("оприходование: " + ОписаниеОшибки());
		Результат.Вставить("оприходование", "ошибка");
	КонецПопытки;
	Результат.Вставить("остаткиПослеПрихода", Остатки4101(Ошибки));
	Если Результат.оприходование = "ошибка" Тогда
		Возврат Результат;
	КонецЕсли;
	Результат.Вставить("проводкиПрихода", ПроводкиДвижения(Оприходование, Ошибки));

	// 2. Комплектация: 1 комплект из 1+1.
	Сборка = Документы.КомплектацияНоменклатуры.СоздатьДокумент();
	Сборка.Дата = '20261002090000';
	Сборка.Комментарий = "ТЕСТ КОМПЛЕКТЫ (Пробник)";
	Сборка.ВидОперации = Перечисления.ВидыОперацийКомплектацияНоменклатуры.Комплектация;
	Сборка.Организация = Орг;
	Сборка.Склад = Склад;
	Сборка.Номенклатура = Комплект;
	Сборка.Количество = 1;
	Сборка.СчетУчета = Счет41;
	Строка = Сборка.Комплектующие.Добавить();
	Строка.Номенклатура = Комп1;
	Строка.Количество = 1;
	Строка.ДоляСтоимости = 0;
	Строка.СчетУчета = Счет41;
	Строка = Сборка.Комплектующие.Добавить();
	Строка.Номенклатура = Комп2;
	Строка.Количество = 1;
	Строка.ДоляСтоимости = 0;
	Строка.СчетУчета = Счет41;
	Попытка
		Сборка.Записать(РежимЗаписиДокумента.Проведение);
		Результат.Вставить("комплектация", СтрЗнач(Сборка.Ссылка));
		Результат.Вставить("суммаКомплектации", СтрЗнач(Сборка.СуммаДокумента));
	Исключение
		Ошибки.Добавить("комплектация: " + ОписаниеОшибки());
		Результат.Вставить("комплектация", "ошибка");
	КонецПопытки;
	Результат.Вставить("остаткиПослеКомплектации", Остатки4101(Ошибки));
	Если Результат.комплектация = "ошибка" Тогда
		Возврат Результат;
	КонецЕсли;
	Результат.Вставить("проводкиКомплектации", ПроводкиДвижения(Сборка, Ошибки));

	// 3. Разукомплектация: комплект обратно в две комплектующие, доли 50/50.
	Разборка = Документы.КомплектацияНоменклатуры.СоздатьДокумент();
	Разборка.Дата = '20261003090000';
	Разборка.Комментарий = "ТЕСТ КОМПЛЕКТЫ (Пробник)";
	Разборка.ВидОперации = Перечисления.ВидыОперацийКомплектацияНоменклатуры.Разукомплектация;
	Разборка.Организация = Орг;
	Разборка.Склад = Склад;
	Разборка.Номенклатура = Комплект;
	Разборка.Количество = 1;
	Разборка.СчетУчета = Счет41;
	Строка = Разборка.Комплектующие.Добавить();
	Строка.Номенклатура = Комп1;
	Строка.Количество = 1;
	Строка.ДоляСтоимости = 30;
	Строка.СчетУчета = Счет41;
	Строка = Разборка.Комплектующие.Добавить();
	Строка.Номенклатура = Комп2;
	Строка.Количество = 1;
	Строка.ДоляСтоимости = 70;
	Строка.СчетУчета = Счет41;
	Попытка
		Разборка.Записать(РежимЗаписиДокумента.Проведение);
		Результат.Вставить("разукомплектация", СтрЗнач(Разборка.Ссылка));
		Результат.Вставить("суммаРазукомплектации", СтрЗнач(Разборка.СуммаДокумента));
	Исключение
		Ошибки.Добавить("разукомплектация: " + ОписаниеОшибки());
		Результат.Вставить("разукомплектация", "ошибка");
	КонецПопытки;
	Результат.Вставить("остаткиПослеРазборки", Остатки4101(Ошибки));
	Если Результат.разукомплектация <> "ошибка" Тогда
		Результат.Вставить("проводкиРазукомплектации", ПроводкиДвижения(Разборка, Ошибки));
	КонецЕсли;

	Возврат Результат;
КонецФункции

&НаСервере
Функция РазведкаБП(Ошибки)
	// Первый шаг живой проверки БП: чем заполнена база и из чего можно собрать
	// документ «Комплектация номенклатуры» (остатки, счета, виды номенклатуры).
	Разведка = Новый Структура;

	Тексты = Новый Структура;
	Тексты.Вставить("организации",
		"ВЫБРАТЬ ПЕРВЫЕ 5
		|	Орг.Ссылка КАК Организация,
		|	Орг.Наименование КАК Наименование,
		|	Орг.ИНН КАК ИНН
		|ИЗ Справочник.Организации КАК Орг");
	Тексты.Вставить("склады",
		"ВЫБРАТЬ ПЕРВЫЕ 5
		|	Скл.Ссылка КАК Склад,
		|	Скл.Наименование КАК Наименование
		|ИЗ Справочник.Склады КАК Скл");
	Тексты.Вставить("видыНоменклатуры",
		"ВЫБРАТЬ
		|	Вид.Наименование КАК Вид,
		|	Вид.Комплектуем КАК Комплектуем
		|ИЗ Справочник.ВидыНоменклатуры КАК Вид
		|УПОРЯДОЧИТЬ ПО Наименование");
	Тексты.Вставить("номенклатураКомплекты",
		"ВЫБРАТЬ ПЕРВЫЕ 10
		|	Ном.Ссылка КАК Номенклатура,
		|	Ном.Наименование КАК Наименование,
		|	Ном.ВидНоменклатуры КАК Вид
		|ИЗ Справочник.Номенклатура КАК Ном
		|ГДЕ Ном.Наименование ПОДОБНО ""%омплект%"" ИЛИ Ном.Наименование ПОДОБНО ""%абор%""
		|УПОРЯДОЧИТЬ ПО Наименование");
	Тексты.Вставить("последниеДвижения",
		"ВЫБРАТЬ ПЕРВЫЕ 5
		|	Дв.Период КАК Период,
		|	Дв.Регистратор КАК Регистратор,
		|	Дв.СчетДт КАК СчетДт,
		|	Дв.СчетКт КАК СчетКт,
		|	Дв.Сумма КАК Сумма
		|ИЗ РегистрБухгалтерии.Хозрасчетный КАК Дв
		|УПОРЯДОЧИТЬ ПО Период УБЫВ");

	Для Каждого Эл Из Тексты Цикл
		ИмяРаздела = ИмяИзПары(Эл);
		Попытка
			Запрос = Новый Запрос;
			Запрос.Текст = СодержаниеИзПары(Эл);
			Разведка.Вставить(ИмяРаздела, ТаблицаЗапросаСтруктурой(Запрос, 20, Ошибки, "разведка: " + ИмяРаздела));
		Исключение
			Ошибки.Добавить("разведка " + ИмяРаздела + ": " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

	Попытка
		Счет41 = ПланыСчетов.Хозрасчетный.НайтиПоКоду("41.01");
		Разведка.Вставить("счет4101", СтрЗнач(Счет41));
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 12
		|	Остатки.Субконто1 КАК Номенклатура,
		|	Остатки.Субконто2 КАК Склад,
		|	Остатки.КоличествоОстаток КАК Количество,
		|	Остатки.СуммаОстаток КАК Сумма
		|ИЗ РегистрБухгалтерии.Хозрасчетный.Остатки(&Дата, Счет В ИЕРАРХИИ (&Счет), , ) КАК Остатки
		|ГДЕ Остатки.СуммаОстаток <> 0
		|УПОРЯДОЧИТЬ ПО СуммаОстаток УБЫВ";
		Запрос.УстановитьПараметр("Дата", ТекущаяДата());
		Запрос.УстановитьПараметр("Счет", Счет41);
		Разведка.Вставить("остатки4101", ТаблицаЗапросаСтруктурой(Запрос, 12, Ошибки, "остатки 41.01"));
	Исключение
		Ошибки.Добавить("остатки 41.01: " + ОписаниеОшибки());
	КонецПопытки;

	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 5
		|	СУН.Номенклатура КАК Номенклатура,
		|	СУН.СчетУчета КАК СчетУчета,
		|	СУН.Склад КАК Склад,
		|	СУН.Организация КАК Организация
		|ИЗ РегистрСведений.СчетаУчетаНоменклатуры КАК СУН";
		Разведка.Вставить("счетаУчетаНоменклатуры", ТаблицаЗапросаСтруктурой(Запрос, 5, Ошибки, "счета учёта номенклатуры"));
	Исключение
		Ошибки.Добавить("счета учёта номенклатуры: " + ОписаниеОшибки());
	КонецПопытки;

	Возврат Разведка;
КонецФункции

&НаСервере
Функция Обзоры(Ошибки)
	Прогресс("обзор: начало");
	СписокСлов = КлючевыеСлова();
	Обзор = Новый Структура;

	Найденные = Новый Массив;
	Попытка
		Для Каждого Док Из Метаданные.Документы Цикл
			Если Подходит(Док.Имя, СписокСлов) Тогда
				Найденные.Добавить(Док);
			КонецЕсли;
		КонецЦикла;
	Исключение
		Ошибки.Добавить("перебор документов: " + ОписаниеОшибки());
	КонецПопытки;

	СписокДокументов = Новый Массив;
	Для Каждого Док Из Найденные Цикл
		СписокДокументов.Добавить(Новый Структура("имя,синоним,проводки,движений",
			Док.Имя, СтрСиноним(Док), ЕстьПроводки(Док), Док.Движения.Количество()));
	КонецЦикла;
	Обзор.Вставить("документыПоКлючевымСловам", СписокДокументов);

	Подробно = Новый Массив;
	Для Каждого Док Из Найденные Цикл
		Прогресс("разбор документа: " + Док.Имя);
		Разбор = Новый Структура;
		Разбор.Вставить("имя", Док.Имя);
		Разбор.Вставить("синоним", СтрСиноним(Док));
		Разбор.Вставить("реквизиты", РеквизитыМетаданных(Док));
		Разбор.Вставить("табличныеЧасти", ТабличныеЧастиМетаданных(Док));
		Разбор.Вставить("движения", НаборыДвижений(Док));
		Разбор.Вставить("естьПроводки", ЕстьПроводки(Док));
		Разбор.Вставить("данные", ДанныеДокументов(Док, 4, Ошибки));
		Подробно.Добавить(Разбор);
	КонецЦикла;
	Обзор.Вставить("разборДокументов", Подробно);

	ПоСправочникам = Новый Массив;
	Попытка
		Для Каждого Спр Из Метаданные.Справочники Цикл
			Если Подходит(Спр.Имя, СписокСлов) Тогда
				ПоСправочникам.Добавить(Новый Структура("имя,синоним", Спр.Имя, СтрСиноним(Спр)));
			КонецЕсли;
		КонецЦикла;
	Исключение
		Ошибки.Добавить("перебор справочников: " + ОписаниеОшибки());
	КонецПопытки;
	Обзор.Вставить("справочники", ПоСправочникам);

	ПоРегистрам = Новый Массив;
	Попытка
		Для Каждого Рег Из Метаданные.РегистрыСведений Цикл
			Если Подходит(Рег.Имя, СписокСлов) Тогда
				ПоРегистрам.Добавить(Новый Структура("имя,вид", Рег.Имя, "сведений"));
			КонецЕсли;
		КонецЦикла;
		Для Каждого Рег Из Метаданные.РегистрыНакопления Цикл
			Если Подходит(Рег.Имя, СписокСлов) Тогда
				ПоРегистрам.Добавить(Новый Структура("имя,вид", Рег.Имя, "накопления"));
			КонецЕсли;
		КонецЦикла;
	Исключение
		Ошибки.Добавить("перебор регистров: " + ОписаниеОшибки());
	КонецПопытки;
	Обзор.Вставить("регистры", ПоРегистрам);

	ПоПеречислениям = Новый Массив;
	Попытка
		Для Каждого Пер Из Метаданные.Перечисления Цикл
			Если Подходит(Пер.Имя, СписокСлов) Тогда
				Значения = Новый Массив;
				Для Каждого ЗначениеПер Из Пер.ЗначенияПеречисления Цикл
					Значения.Добавить(ЗначениеПер.Имя);
				КонецЦикла;
				ПоПеречислениям.Добавить(Новый Структура("имя,значения", Пер.Имя, Значения));
			КонецЕсли;
		КонецЦикла;
	Исключение
		Ошибки.Добавить("перебор перечислений: " + ОписаниеОшибки());
	КонецПопытки;
	Обзор.Вставить("перечисления", ПоПеречислениям);

	Прогресс("планы обмена");
	Обзор.Вставить("планыОбмена", ОбзорПлановОбмена(Ошибки));

	СловаОбмена = Новый Массив;
	СловаОбмена.Добавить("Обмен");
	СловаОбмена.Добавить("Конверт");
	СловаОбмена.Добавить("EnterpriseData");
	СловаОбмена.Добавить("Синхронизац");
	СловаОбмена.Добавить("Взаимодейств");
	Обзор.Вставить("обменСредства", ОбзорОбмена(СловаОбмена, Ошибки));

	Прогресс("номенклатура");
	Обзор.Вставить("номенклатура", ОбзорНоменклатуры(Ошибки));

	Возврат Обзор;
КонецФункции

// Печатник дерева Структура/Массив в обычный текст.
// JSON на этой сборке недоступен: у ЗаписьJSON нет метода Установить,
// глобальный ЗаписатьJSON(ИмяФайла, Значение) тоже падает.
// Доступ к полям пары КлючИЗначение: в этой сборке платформы итератор
// структуры отдаёт объект с АНГЛИЙСКИМИ полями (Key/Value), пробуем и русское,
// и английское имя — поля разрешаются в рантайме, компилятор не мешает.
&НаСервере
Функция ИмяИзПары(Пара)
	Попытка
		Возврат Пара.Имя;
	Исключение
		Попытка
			Возврат Пара.Key;
		Исключение
			Возврат "?";
		КонецПопытки;
	КонецПопытки;
КонецФункции

&НаСервере
Функция СодержаниеИзПары(Пара)
	Попытка
		Возврат Пара.Значение;
	Исключение
		Попытка
			Возврат Пара.Value;
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	КонецПопытки;
КонецФункции

&НаСервере
Процедура НапечататьУзел(Текст, Ключ, Дерево, Отступ)

	Попытка
		Если ТипЗнч(Дерево) = Тип("Структура") Тогда
			Текст.ЗаписатьСтроку(Отступ + Ключ + ":");
			Для Каждого Эл Из Дерево Цикл
				НапечататьУзел(Текст, ИмяИзПары(Эл), СодержаниеИзПары(Эл), Отступ + "  ");
			КонецЦикла;
		ИначеЕсли ТипЗнч(Дерево) = Тип("Массив") Тогда
			Текст.ЗаписатьСтроку(Отступ + Ключ + " (" + Формат(Дерево.Количество(), "ЧГ=0") + "):");
			Для Каждого Эл Из Дерево Цикл
				НапечататьУзел(Текст, "-", Эл, Отступ + "  ");
			КонецЦикла;
		Иначе
			Текст.ЗаписатьСтроку(Отступ + Ключ + ": " + СтрЗнач(Дерево));
		КонецЕсли;
	Исключение
		Прогресс("печать упала [" + Ключ + "]: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяСсылка)

	Ошибки = Новый Массив;
	Данные = Новый Структура;
	Путь = "/tmp/opencode/diag_" + Метаданные.Имя + ".txt";

	Попытка
		Данные.Вставить("диагностика", "комплекты и наборы, снимок живой базы");
		Данные.Вставить("момент", Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd HH:mm:ss"));
		Данные.Вставить("конфигурация", Метаданные.Имя);
		Данные.Вставить("версияКонфигурации", Метаданные.Версия);
		Данные.Вставить("документовВМетаданных", Метаданные.Документы.Количество());
		Данные.Вставить("обзор", Обзоры(Ошибки));
		Если Метаданные.Имя = "БухгалтерияПредприятия" Тогда
			Прогресс("разведка БП");
			Данные.Вставить("разведкаБП", РазведкаБП(Ошибки));
			Если ФлагФайл("/tmp/opencode/run_bp_test.txt") Тогда
				Прогресс("тест БП: начало");
				Данные.Вставить("тестБП", ТестБП(Ошибки));
			КонецЕсли;
		КонецЕсли;
		Данные.Вставить("ошибки", Ошибки);
	Исключение
		// любая незащищённая ошибка иначе вешает сеанс молча — пишем crash-файл
		Попытка
			Т = Новый ЗаписьТекста(Путь + ".crash.txt", КодировкаТекста.UTF8, Символы.ПС, Истина);
			Т.ЗаписатьСтроку("незакрытое исключение: " + ОписаниеОшибки());
			Т.Закрыть();
		Исключение
		КонецПопытки;
	КонецПопытки;

	Попытка
		Текст = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8, Символы.ПС, Истина);
		НапечататьУзел(Текст, "корень", Данные, "");
		Текст.Закрыть();
	Исключение
		Попытка
			Текст = Новый ЗаписьТекста(Путь + ".error.txt", КодировкаТекста.UTF8, Символы.ПС, Истина);
			Текст.ЗаписатьСтроку(Путь + " не записан: " + ОписаниеОшибки() + " | " + Строка(Ошибки));
			Текст.Закрыть();
		Исключение
		КонецПопытки;
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры

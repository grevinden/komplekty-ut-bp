// Модуль объекта внешней обработки.
// Нужен как запасной путь запуска: если форма по умолчанию не открылась,
// платформа вызывает экспортный Выполнить — оттуда открываем форму сами.

&НаКлиенте
Экспорт Процедура Выполнить(ПараметрЗапуска = Неопределено)

	Попытка
		ОткрытьФорму("ВнешняяОбработка.Пробник.Форма.Форма");
	Исключение
		ЗавершитьРаботуСистемы(Ложь);
	КонецПопытки;

КонецПроцедуры

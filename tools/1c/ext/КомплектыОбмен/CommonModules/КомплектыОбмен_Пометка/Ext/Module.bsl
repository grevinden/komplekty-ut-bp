#Область ПрограммныйИнтерфейс

// Прочитать пометку наборов из табличной части «Товары» полученного документа.
//
// Ищет в строках реквизиты, добавленные расширением «КомплектыБП»:
//   «КомплектыБП_НаборУИД» — УИД набора (строка, стабильный ключ группы);
//   «КомплектыБП_Набор» — наименование набора (строка, опционально);
//   «КомплектыБП_КоличествоНаборов» — количество проданных наборов (число).
//
// Группирует строки по УИД набора. Строки без пометки не возвращаются.
// Если ни у одной строки пометки нет — возвращает пустой массив.
//
// Параметры:
//   ПолученныеДанные - ДокументОбъект - документ, собранный из сообщения,
//                      но ещё не записанный в базу.
//
// Возвращаемое значение:
//   Массив из Структура - группы строк со свойствами:
//     * КлючГруппы        - Строка - УИД набора (стабильный ключ группы);
//     * Набор             - Строка - наименование набора или пусто;
//     * КоличествоНаборов - Число  - количество наборов (минимум 1);
//     * Строки            - Массив(Число) - индексы строк документа в исходной ТЧ.
//
Функция ПрочитатьГруппы(ПолученныеДанные) Экспорт

	Группы = Новый Массив;
	Карта = Новый Соответствие; // КлючГруппы → Структура группы

	Попытка
		Товары = ПолученныеДанные["Товары"];
	Исключение
		Возврат Группы;
	КонецПопытки;

	Если Товары = Неопределено Или Товары.Количество() = 0 Тогда
		Возврат Группы;
	КонецЕсли;

	// Определяем, какие реквизиты пометки есть в метаданных строки
	МетаТовары = ПолученныеДанные.Метаданные().ТабличныеЧасти.Найти("Товары");
	Если МетаТовары = Неопределено Тогда
		Возврат Группы;
	КонецЕсли;

	ИменаРеквизитов = Новый Массив;
	Для Каждого Рекв Из МетаТовары.Реквизиты Цикл
		ИменаРеквизитов.Добавить(ВРег(Рекв.Имя));
	КонецЦикла;

	ЕстьУИД = ИменаРеквизитов.Найти(ВРег("КомплектыБП_НаборУИД")) <> Неопределено;
	ЕстьКол = ИменаРеквизитов.Найти(ВРег("КомплектыБП_КоличествоНаборов")) <> Неопределено;
	ЕстьНабор = ИменаРеквизитов.Найти(ВРег("КомплектыБП_Набор")) <> Неопределено;

	Если Не ЕстьУИД И Не ЕстьКол Тогда
		// Нет реквизитов пометки — работаем по старым документам без пометки
		Возврат Группы;
	КонецЕсли;

	Для Индекс = 0 По Товары.Количество() - 1 Цикл
		СтрокаТовара = Товары[Индекс];
		УИД = "";
		Кол = 1;
		Набор = "";

		Попытка
			Если ЕстьУИД Тогда
				УИД = СокрЛП(СтрокаТовара["КомплектыБП_НаборУИД"]);
			КонецЕсли;
		Исключение
		КонецПопытки;

		Если ПустаяСтрока(УИД) Тогда
			Продолжить; // строка без пометки — обычный товар, пропускаем
		КонецЕсли;

		Попытка
			Если ЕстьКол Тогда
				Кол = СтрокаТовара["КомплектыБП_КоличествоНаборов"];
			КонецЕсли;
		Исключение
		КонецПопытки;

		Если Кол < 1 Тогда
			Кол = 1;
		КонецЕсли;

		Попытка
			Если ЕстьНабор Тогда
				Набор = СокрЛП(СтрокаТовара["КомплектыБП_Набор"]);
			КонецЕсли;
		Исключение
		КонецПопытки;

		Группа = Карта.Получить(УИД);
		Если Группа = Неопределено Тогда
			Группа = Новый Структура("КлючГруппы, Набор, КоличествоНаборов, Строки");
			Группа.КлючГруппы = УИД;
			Группа.Набор = Набор;
			Группа.КоличествоНаборов = Кол;
			Группа.Строки = Новый Массив;
			Карта.Вставить(УИД, Группа);
			Группы.Добавить(Группа);
		КонецЕсли;

		Группа.Строки.Добавить(Индекс);

	КонецЦикла;

	Возврат Группы;

КонецФункции

#КонецОбласти
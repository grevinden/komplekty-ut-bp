#Область ПрограммныйИнтерфейс

// URI пространства имён расширяющего XDTO-пакета (расширение формата EnterpriseData).
//
// Одна константа для ядра и всех адаптеров: пакет объявлен в расширении
// «КомплектыОбмен», а адаптеры УТ и БП регистрируют тот же URI в правилах
// конвертации. Имена свойств пометки едины — «КомплектыОбмен_*».
//
// Возвращаемое значение:
//   Строка - URI расширения формата.
//
Функция ПространствоИменРасширения() Экспорт

	Возврат "http://v8.1c.ru/edi/edi_stnd_ext_enterprisedata/EnterpriseData/1.20";

КонецФункции

// Прочитать пометку наборов из табличной части «Товары» полученного документа.
//
// Ищет в строках реквизиты пометки «КомплектыОбмен_*», которые переносит
// адаптер приёмника:
//   «КомплектыОбмен_НаборУИД» — УИД набора (строка, стабильный ключ группы);
//   «КомплектыОбмен_Набор» — наименование набора (строка, опционально);
//   «КомплектыОбмен_ХарактеристикаНабора» — характеристика набора (строка, опционально);
//   «КомплектыОбмен_КоличествоНаборов» — количество проданных наборов (число).
//
// Группирует строки по ключу «УИД набора + характеристика». Характеристика
// входит в ключ, потому что в УТ учёт набора ведётся в разрезе характеристики:
// два варианта одного набора в одном документе — разные группы. Если
// характеристики нет, ключ остаётся равным УИД (совместимо с прежними данными).
//
// Параметры:
//   ПолученныеДанные - ДокументОбъект - документ, собранный из сообщения,
//                      но ещё не записанный в базу.
//
// Возвращаемое значение:
//   Массив из Структура - группы строк со свойствами:
//     * КлючГруппы        - Строка - «УИД» либо «УИД|Х:<характеристика>»;
//     * Набор             - Строка - наименование набора или пусто;
//     * Характеристика    - Строка - наименование характеристики или пусто;
//     * КоличествоНаборов - Число  - количество наборов (минимум 1);
//     * Строки            - Массив(Число) - индексы строк документа в исходной ТЧ.
//
Функция ПрочитатьГруппы(ПолученныеДанные) Экспорт

	Группы = Новый Массив;
	Карта = Новый Соответствие; // КлючГруппы → Структура группы

	Попытка
		Товары = ПолученныеДанные["Товары"];
	Исключение
		Возврат Группы;
	КонецПопытки;

	Если Товары = Неопределено Или Товары.Количество() = 0 Тогда
		Возврат Группы;
	КонецЕсли;

	// Определяем, какие реквизиты пометки есть в метаданных строки
	МетаТовары = ПолученныеДанные.Метаданные().ТабличныеЧасти.Найти("Товары");
	Если МетаТовары = Неопределено Тогда
		Возврат Группы;
	КонецЕсли;

	ИменаРеквизитов = Новый Массив;
	Для Каждого Рекв Из МетаТовары.Реквизиты Цикл
		ИменаРеквизитов.Добавить(ВРег(Рекв.Имя));
	КонецЦикла;

	ЕстьУИД = ИменаРеквизитов.Найти(ВРег("КомплектыОбмен_НаборУИД")) <> Неопределено;
	ЕстьКол = ИменаРеквизитов.Найти(ВРег("КомплектыОбмен_КоличествоНаборов")) <> Неопределено;
	ЕстьНабор = ИменаРеквизитов.Найти(ВРег("КомплектыОбмен_Набор")) <> Неопределено;
	ЕстьХарактеристика = ИменаРеквизитов.Найти(
		ВРег("КомплектыОбмен_ХарактеристикаНабора")) <> Неопределено;

	Если Не ЕстьУИД И Не ЕстьКол Тогда
		// Нет реквизитов пометки — работаем по старым документам без пометки
		Возврат Группы;
	КонецЕсли;

	Для Индекс = 0 По Товары.Количество() - 1 Цикл
		СтрокаТовара = Товары[Индекс];
		УИД = "";
		Кол = 1;
		Набор = "";
		Характеристика = "";

		Попытка
			Если ЕстьУИД Тогда
				УИД = СокрЛП(СтрокаТовара["КомплектыОбмен_НаборУИД"]);
			КонецЕсли;
		Исключение
			// Реквизит объявлен, но значение не читается (Null/чужая
			// конфигурация). Строка остаётся без пометки — это безопаснее,
			// чем уронить приём документа.
			ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Информация,
				"КомплектыОбмен: УИД набора в строке не прочитан — " + ОписаниеОшибки());
		КонецПопытки;

		Если ПустаяСтрока(УИД) Тогда
			Продолжить; // строка без пометки — обычный товар, пропускаем
		КонецЕсли;

		Попытка
			Если ЕстьКол Тогда
				Кол = НормализоватьКоличество(СтрокаТовара["КомплектыОбмен_КоличествоНаборов"]);
			КонецЕсли;
		Исключение
			// Количество наборов не прочитано — остаётся 1 (значение по
			// умолчанию), документ принимается.
			ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Информация,
				"КомплектыОбмен: количество наборов в строке не прочитано, принято 1 — "
				+ ОписаниеОшибки());
		КонецПопытки;

		Попытка
			Если ЕстьНабор Тогда
				Набор = СокрЛП(СтрокаТовара["КомплектыОбмен_Набор"]);
			КонецЕсли;
		Исключение
			// Имя набора нужно только для имени карточки: без него карточка
			// получит имя по УИД.
			ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Информация,
				"КомплектыОбмен: имя набора в строке не прочитано — " + ОписаниеОшибки());
		КонецПопытки;

		Попытка
			Если ЕстьХарактеристика Тогда
				Характеристика = СокрЛП(СтрокаТовара["КомплектыОбмен_ХарактеристикаНабора"]);
			КонецЕсли;
		Исключение
			ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Информация,
				"КомплектыОбмен: характеристика набора в строке не прочитана — " + ОписаниеОшибки());
		КонецПопытки;

		КлючГруппы = КлючГруппыПометки(УИД, Характеристика);

		Группа = Карта.Получить(КлючГруппы);
		Если Группа = Неопределено Тогда
			Группа = Новый Структура("КлючГруппы, Набор, Характеристика, КоличествоНаборов, Строки");
			Группа.КлючГруппы = КлючГруппы;
			Группа.Набор = Набор;
			Группа.Характеристика = Характеристика;
			Группа.КоличествоНаборов = Кол;
			Группа.Строки = Новый Массив;
			Карта.Вставить(КлючГруппы, Группа);
			Группы.Добавить(Группа);
		КонецЕсли;

		Группа.Строки.Добавить(Индекс);

	КонецЦикла;

	Возврат Группы;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедуры

// Ключ группы: УИД набора плюс характеристика, если она есть.
//
// Параметры:
//   УИД            - Строка - УИД набора;
//   Характеристика - Строка - наименование характеристики или пусто.
//
// Возвращаемое значение:
//   Строка - ключ группы.
//
Функция КлючГруппыПометки(УИД, Характеристика)

	Если ПустаяСтрока(Характеристика) Тогда
		Возврат УИД;
	КонецЕсли;

	Возврат УИД + "|Х:" + Характеристика;

КонецФункции

// Приводит прочитанное из сообщения количество наборов к числу >= 1.
//
// Из XDTO значение может прийти строкой или Null, а не числом. Прямое
// присваивание в таком случае дало бы 0 или исключение приведения, поэтому
// тип проверяется явно: нечисловое значение заменяется на 1 с предупреждением.
//
// Параметры:
//   Значение - Произвольный - значение реквизита пометки.
//
// Возвращаемое значение:
//   Число - количество наборов, не меньше 1.
//
Функция НормализоватьКоличество(Значение)

	Если Значение = Неопределено Или Значение = NULL Тогда
		Возврат 1;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Если Значение < 1 Тогда
			Возврат 1;
		КонецЕсли;
		Возврат Значение;
	КонецЕсли;

	Попытка
		Число = Число(СокрЛП(Строка(Значение)));
	Исключение
		ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Предупреждение,
			"КомплектыОбмен: количество наборов имеет тип " + Строка(ТипЗнч(Значение))
			+ " и не приводится к числу, принято 1");
		Возврат 1;
	КонецПопытки;

	Если Число < 1 Тогда
		Возврат 1;
	КонецЕсли;

	Возврат Число;

КонецФункции

// Пишет сообщение прикладного журнала регистрации по проблемам чтения пометки.
//
// Параметры:
//   Уровень - УровеньЖурналаРегистрации - важность сообщения.
//   Текст   - Строка - описание проблемы.
//
Процедура ЗаписатьВЖурнал(Уровень, Текст)

	ЗаписьЖурналаРегистрации("КомплектыОбмен.Обмен", Уровень, , , Текст);

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Прочитать настройки контура из регистра «КомплектыОбмен_Настройки».
//
// Возвращаемое значение:
//   Структура - ключи:
//     * Включен           - Булево - контур активен;
//     * СоздаватьКарточки - Булево - создавать карточки комплектов автоматически;
//     * ДатаЗапрета       - Дата   - документы ранее этой даты не трогаем;
//     * Склад             - СправочникСсылка.Склады - склад по умолчанию или Неопределено.
//
Функция ПрочитатьНастройки() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Включен", Истина);
	Результат.Вставить("СоздаватьКарточки", Истина);
	Результат.Вставить("ДатаЗапрета", Дата("00010101"));
	Результат.Вставить("Склад", Неопределено);

	Попытка
		Менеджер = РегистрыСведений["КомплектыОбмен_Настройки"];
	Исключение
		Возврат Результат;
	КонецПопытки;

	Отбор = Новый Структура;
	НаборЗаписей = Менеджер.СоздатьНаборЗаписей();
	НаборЗаписей.Прочитать(Отбор);
	Если НаборЗаписей.Количество() > 0 Тогда
		Строка = НаборЗаписей[0];
		Результат.Включен = Строка.Включен;
		Результат.СоздаватьКарточки = Строка.СоздаватьКарточки;
		Результат.ДатаЗапрета = Строка.ДатаЗапрета;
		Результат.Склад = Строка.Склад;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Проверить, можно ли обрабатывать документ с указанной датой.
//
// Параметры:
//   ДатаДокумента - Дата - дата проверяемого документа.
//   Настройки     - Структура - результат ПрочитатьНастройки().
//
// Возвращаемое значение:
//   Булево - Истина, если дата документа >= ДатаЗапрета (обработка разрешена).
//
Функция РазрешеноПоДате(ДатаДокумента, Настройки) Экспорт

	Если Настройки.ДатаЗапрета = Дата("00010101") Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат ДатаДокумента >= Настройки.ДатаЗапрета;

КонецФункции

#КонецОбласти
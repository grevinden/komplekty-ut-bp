// Общее расширение «КомплектыОбмен».
// Ставится в обе базы пары УТ 11.5 ↔ БП 3.0. Заимствованных объектов здесь нет:
// всё, что зависит от конкретной конфигурации, живёт в «КомплектыУТ» и «КомплектыБП».
//
// Назначение модуля — фасад контура.

#Область ПрограммныйИнтерфейс

// Версия общего расширения. Используется адаптерами для проверки совместимости.
//
// Возвращаемое значение:
//   Строка - версия в формате «1.1.0.0».
//
Функция Версия() Экспорт

	Возврат "1.1.0.0";

КонецФункции

// Дата в виде строки, не зависящей от локали сеанса: «ГГГГ-ММ-ДД ЧЧ:ММ:СС».
//
// Нужна для ключей идемпотентности (имя спецификации, комментарий сборки):
// Формат(Дата, "ДЛФ=Д") и «ДФ» зависят от региональных установок и при смене
// локали дают другую строку, из-за чего повторная загрузка создаёт дубли.
// Здесь дата собирается из числовых частей, поэтому от локали не зависит.
//
// Параметры:
//   Дата - Дата - значение для преобразования.
//
// Возвращаемое значение:
//   Строка - «ГГГГ-ММ-ДД ЧЧ:ММ:СС»; для пустой даты — «0000-00-00 00:00:00».
//
Функция ДатаКлюч(Дата) Экспорт

	Если Не ЗначениеЗаполнено(Дата) Тогда
		Возврат "0000-00-00 00:00:00";
	КонецЕсли;

	Возврат Формат(Год(Дата), "ЧГ=0")
		+ "-" + ДвузначноеЧисло(Месяц(Дата))
		+ "-" + ДвузначноеЧисло(День(Дата))
		+ " " + ДвузначноеЧисло(Час(Дата))
		+ ":" + ДвузначноеЧисло(Минута(Дата))
		+ ":" + ДвузначноеЧисло(Секунда(Дата));

КонецФункции

// Сведения о контуре, в который установлено расширение.
// Нужны адаптерам, чтобы не угадывать конфигурацию по имени базы.
//
// Возвращаемое значение:
//   Структура - ключи:
//     * Версия               - Строка - версия расширения;
//     * Конфигурация         - Строка - имя конфигурации (Метаданные.Имя);
//     * Синоним              - Строка - синоним конфигурации;
//     * ЕстьКомплектация     - Булево - есть документ «КомплектацияНоменклатуры»;
//     * ЕстьВариантыКомплектации - Булево - есть справочник «ВариантыКомплектацииНоменклатуры».
//
Функция СведенияОКонтуре() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Версия", Версия());
	Результат.Вставить("Конфигурация", Метаданные.Имя);
	Результат.Вставить("Синоним", Метаданные.Синоним);
	Результат.Вставить("ЕстьКомплектация",
		Метаданные.Документы.Найти("КомплектацияНоменклатуры") <> Неопределено);
	Результат.Вставить("ЕстьВариантыКомплектации",
		Метаданные.Справочники.Найти("ВариантыКомплектацииНоменклатуры") <> Неопределено);

	Возврат Результат;

КонецФункции

// Точка входа для адаптера БП: выполнить свёртку набора в комплект
// в полученном из обмена документе.
//
// Параметры:
//   ПолученныеДанные - ДокументОбъект - документ, собранный из сообщения,
//                      ещё не записанный. Изменяется in-place.
//   ГруппыПометки    - Массив из Структура, Неопределено - уже прочитанные
//                      группы пометки (см. КомплектыОбмен_Пометка.ПрочитатьГруппы).
//                      Неопределено — прочитать внутри.
//
// Возвращаемое значение:
//   Структура - результат обработки (см. КомплектыОбмен_Свертка.ОбработатьДокумент),
//   дополненный ключами:
//     * Пропуск        - Булево - документ с пометкой не обработан по настройкам;
//     * ПричинаПропуска - Строка - почему пропущен (пусто, если не пропуск).
//
Функция ОбработатьПолученныйДокумент(ПолученныеДанные, ГруппыПометки = Неопределено) Экспорт

	Результат = Новый Структура("Обработано, Группы, Ошибки, Пропуск, ПричинаПропуска");
	Результат.Обработано = Ложь;
	Результат.Группы = Новый Массив;
	Результат.Ошибки = Новый Массив;
	Результат.Пропуск = Ложь;
	Результат.ПричинаПропуска = "";

	// 1. Пометка. Читаем до проверки настроек: пропуск документа С пометкой
	// должен быть виден в журнале (состояние «Пропущен»), а документ без
	// пометки не журналируется вообще — типовой обмен не трогаем.
	Если ГруппыПометки = Неопределено Тогда
		Попытка
			ГруппыПометки = КомплектыОбмен_Пометка.ПрочитатьГруппы(ПолученныеДанные);
		Исключение
			ГруппыПометки = Неопределено;
		КонецПопытки;
	КонецЕсли;

	Если ГруппыПометки = Неопределено Или ГруппыПометки.Количество() = 0 Тогда
		ГруппыПометки = Новый Массив;
	КонецЕсли;

	Если ГруппыПометки.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	// 2. Настройки
	Настройки = КомплектыОбмен_Настройки.ПрочитатьНастройки();
	Если Не Настройки.Включен Тогда
		Результат.Пропуск = Истина;
		Результат.ПричинаПропуска = "Контур выключен настройкой «Включен»";
		ВернутьПропуск(Результат, ГруппыПометки, Настройки);
		Возврат Результат;
	КонецЕсли;

	// 3. Дата запрета
	Попытка
		ДатаДок = ПолученныеДанные["Дата"];
	Исключение
		// Дата не прочитана — обрабатывать документ вслепую нельзя: сборка
		// и спецификация получат неверный ключ идемпотентности. Пишем ошибку
		// в журнал регистрации, документ остаётся как пришёл.
		ЗаписьЖурналаРегистрации("КомплектыОбмен.Обмен",
			УровеньЖурналаРегистрации.Ошибка, , ,
			"КомплектыОбмен: дата полученного документа не прочитана — свёртка не выполнена: "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Результат.Пропуск = Истина;
		Результат.ПричинаПропуска = "Дата документа не прочитана";
		ВернутьПропуск(Результат, ГруппыПометки, Настройки);
		Возврат Результат;
	КонецПопытки;

	Если Не КомплектыОбмен_Настройки.РазрешеноПоДате(ДатаДок, Настройки) Тогда
		Результат.Пропуск = Истина;
		Результат.ПричинаПропуска = "Дата документа " + ДатаКлюч(ДатаДок)
			+ " раньше даты запрета " + ДатаКлюч(Настройки.ДатаЗапрета);
		ВернутьПропуск(Результат, ГруппыПометки, Настройки);
		Возврат Результат;
	КонецЕсли;

	// 4. Выполнить свёртку
	Результат.Обработано = Истина;
	Результат = КомплектыОбмен_Свертка.ОбработатьДокумент(ПолученныеДанные, Настройки, ГруппыПометки);
	Результат.Вставить("Пропуск", Ложь);
	Результат.Вставить("ПричинаПропуска", "");

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедуры

// Двузначное представление числа 0…99 без зависимости от локали.
//
// Параметры:
//   Число - Число - часть даты (месяц, день, час, минута, секунда).
//
// Возвращаемое значение:
//   Строка - две цифры с ведущим нулём.
//
Функция ДвузначноеЧисло(Число)

	Возврат Прав("0" + Формат(Число, "ЧГ=0"), 2);

КонецФункции

// Заполняет результат одной записью «Пропущен» на каждую группу пометки.
//
// Параметры:
//   Результат    - Структура - результат обработки (изменяется).
//   ГруппыПометки - Массив из Структура - прочитанные группы.
//   Настройки    - Структура - настройки контура.
//
Процедура ВернутьПропуск(Результат, ГруппыПометки, Настройки)

	Результат.Обработано = Истина;

	Для Каждого Группа Из ГруппыПометки Цикл
		Рез = Новый Структура("КлючГруппы, Успех, Сообщение, Карточка, Спецификация, Сборка, КоличествоНаборов, Пропуск");
		Рез.КлючГруппы = Группа.КлючГруппы;
		Рез.Успех = Ложь;
		Рез.Пропуск = Истина;
		Рез.Сообщение = "Пропущено: " + Результат.ПричинаПропуска;
		Рез.Карточка = Неопределено;
		Рез.Спецификация = Неопределено;
		Рез.Сборка = Неопределено;
		Рез.КоличествоНаборов = Группа.КоличествоНаборов;
		Результат.Группы.Добавить(Рез);
	КонецЦикла;

	ЗаписьЖурналаРегистрации("КомплектыОбмен.Обмен",
		УровеньЖурналаРегистрации.Информация, , ,
		"КомплектыОбмен: документ с пометкой наборов не обработан — " + Результат.ПричинаПропуска);

КонецПроцедуры

#КонецОбласти

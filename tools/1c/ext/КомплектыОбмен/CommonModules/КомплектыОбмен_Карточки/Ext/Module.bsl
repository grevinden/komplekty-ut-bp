#Область ПрограммныйИнтерфейс

// Найти карточку комплекта по УИД набора в регистре соответствия.
//
// Параметры:
//   УИДНабора - Строка - УИД набора из сообщения.
//
// Возвращаемое значение:
//   СправочникСсылка.Номенклатура - найденная карточка или пустая ссылка.
//
Функция НайтиКарточкуПоУИД(УИДНабора) Экспорт

	Если ПустаяСтрока(УИДНабора) Тогда
		Возврат Справочники["Номенклатура"].ПустаяСсылка();
	КонецЕсли;

	Попытка
		// У набора записей регистра сведений нет метода Прочитать(Отбор) —
		// вызов падает с «Too many actual parameters» (проверено 05.11.2026
		// на 8.3.27.2342), а ошибка глушилась и карточка создавалась заново.
		// Читаем запросом по измерению регистра.
		Запрос = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 1 Карточка
			|ИЗ РегистрСведений.КомплектыОбмен_СоответствиеНаборов
			|ГДЕ НаборУИД = &НаборУИД");
		Запрос.УстановитьПараметр("НаборУИД", УИДНабора);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.Карточка) Тогда
			Возврат Выборка.Карточка;
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("КомплектыОбмен.Обмен",
			УровеньЖурналаРегистрации.Ошибка, , ,
			"КомплектыОбмен: не удалось прочитать соответствие набора «" + УИДНабора
			+ "» — карточка будет создана заново: "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат Справочники["Номенклатура"].ПустаяСсылка();

КонецФункции

// Создать карточку комплекта (элемент справочника «Номенклатура»).
//
// Параметры:
//   Наименование - Строка - имя набора (станет наименованием карточки);
//   Настройки    - Структура - настройки контура (резерв, могут понадобиться).
//
// Возвращаемое значение:
//   СправочникСсылка.Номенклатура - созданная карточка.
//
Функция СоздатьКарточку(Наименование, Настройки) Экспорт

	Элемент = Справочники["Номенклатура"].СоздатьЭлемент();
	Элемент.Наименование = Наименование;

	// Вид номенклатуры — «Товары» (находим по вхождению в наименование)
	Попытка
		Вид = НайтиПервыйПоНаименованию("ВидыНоменклатуры", "Товары");
		Если ЗначениеЗаполнено(Вид) Тогда
			Элемент.ВидНоменклатуры = Вид;
		КонецЕсли;
	Исключение
		ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Информация,
			"КомплектыОбмен: вид номенклатуры «Товары» не найден — карточка создана без вида: "
			+ ОписаниеОшибки());
	КонецПопытки;

	// Единица измерения — «шт»
	Попытка
		Шт = НайтиПервыйПоНаименованию("КлассификаторЕдиницИзмерения", "шт");
		Если ЗначениеЗаполнено(Шт) Тогда
			Элемент.ЕдиницаИзмерения = Шт;
		КонецЕсли;
	Исключение
		ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Информация,
			"КомплектыОбмен: единица измерения «шт» не найдена — карточка создана без неё: "
			+ ОписаниеОшибки());
	КонецПопытки;

	// Признак «Комплектуем» (есть в БП)
	Попытка
		Элемент["Комплектуем"] = Истина;
	Исключение
		// Реквизита нет в этой конфигурации (например, в УТ) — признак не нужен.
		ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Информация,
			"КомплектыОбмен: реквизита «Комплектуем» нет в конфигурации — признак не установлен");
	КонецПопытки;

	Попытка
		Элемент["Услуга"] = Ложь;
	Исключение
		// Реквизита нет в этой конфигурации — признак не нужен.
		ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Информация,
			"КомплектыОбмен: реквизита «Услуга» нет в конфигурации — признак не установлен");
	КонецПопытки;

	Элемент.Записать();

	Возврат Элемент.Ссылка;

КонецФункции

// Записать соответствие набора и карточки в регистр.
//
// Параметры:
//   УИДНабора        - Строка - УИД набора из сообщения;
//   НаименованиеНабора - Строка - наименование набора;
//   Карточка         - СправочникСсылка - созданная или найденная карточка комплекта.
//
Процедура ЗаписатьСоответствие(УИДНабора, НаименованиеНабора, Карточка) Экспорт

	Попытка
		Менеджер = РегистрыСведений["КомплектыОбмен_СоответствиеНаборов"];
		// Менеджер записи, а не набор записей: у независимого регистра набор
		// без отбора при Записать() заменяет ВСЮ таблицу, то есть стирает
		// соответствия прежних наборов (проверено 06.11.2026 на копии БП).
		Запись = Менеджер.СоздатьМенеджерЗаписи();
		Запись.НаборУИД = УИДНабора;
		Запись.НаборНаименование = НаименованиеНабора;
		Запись.Карточка = Карточка;
		Запись.Создана = ТекущаяДатаСеанса();
		Запись.Записать();
	Исключение
		// Без соответствия повторная загрузка набора создаст вторую карточку,
		// поэтому это ошибка, а не необязательный шаг.
		ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Ошибка,
			"КомплектыОбмен: не записано соответствие набора «" + УИДНабора
			+ "» и карточки — " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Создать спецификацию набора для продажи.
//
// Спецификация описывает состав ОДНОГО набора: реквизит «Количество» равен 1,
// а нормы строк — количество комплектующей на один набор. Иначе норма
// занижается в N раз: при продаже двух наборов спецификация «на 2» содержала
// бы 1+1+2+1 вместо 2+2+4+2 (дефект N1, план 08.11.2026).
//
// Параметры:
//   Карточка           - СправочникСсылка.Номенклатура - комплект (владелец спецификации);
//   ИмяСпецификации    - Строка - уникальное имя (номер продажи + дата);
//   СоставОдногоНабора - Массив из Структура {Номенклатура, Количество} - нормы на 1 набор.
//
// Возвращаемое значение:
//   СправочникСсылка.СпецификацииНоменклатуры - созданная спецификация.
//
Функция СоздатьСпецификацию(Карточка, ИмяСпецификации, СоставОдногоНабора) Экспорт

	Элемент = Справочники["СпецификацииНоменклатуры"].СоздатьЭлемент();
	Элемент.Владелец = Карточка;
	Элемент.Наименование = ИмяСпецификации;

	Попытка
		// Состав ниже — норма на один набор, поэтому и количество равно 1.
		Элемент.Количество = 1;
	Исключение
		ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Информация,
			"КомплектыОбмен: у спецификации нет реквизита «Количество» — норма не записана");
	КонецПопытки;

	Для Каждого Компл Из СоставОдногоНабора Цикл
		Строка = Элемент.ИсходныеКомплектующие.Добавить();
		Строка.Номенклатура = Компл.Номенклатура;
		Строка.Количество = Компл.Количество;
	КонецЦикла;

	Элемент.Записать();

	Возврат Элемент.Ссылка;

КонецФункции

// Определить склад для сборки: склад продажи, иначе склад из настроек.
//
// Параметры:
//   Продажа   - ДокументОбъект - документ продажи (может не иметь реквизита «Склад»);
//   Настройки - Структура - настройки (поле «Склад» может отсутствовать).
//
// Возвращаемое значение:
//   СправочникСсылка.Склады, Неопределено - склад или Неопределено, если не задан.
//
Функция ОпределитьСкладДляСборки(Продажа, Настройки) Экспорт

	Склад = Неопределено;

	Попытка
		Склад = Продажа["Склад"];
	Исключение
		// Поля «Склад» в документе нет (другой вид операции/конфигурация).
		ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Информация,
			"КомплектыОбмен: склад в документе не найден — " + ОписаниеОшибки());
	КонецПопытки;

	Если Не ЗначениеЗаполнено(Склад)
		И Настройки.Свойство("Склад")
		И ЗначениеЗаполнено(Настройки.Склад) Тогда
		Склад = Настройки.Склад;
	КонецЕсли;

	Возврат Склад;

КонецФункции

// Создать (или вернуть существующую) сборку — документ «Комплектация номенклатуры».
//
// Параметры:
//   Карточка           - СправочникСсылка.Номенклатура - что собираем;
//   СоставОдногоНабора - Массив из Структура {Номенклатура, Количество, Сумма} -
//                        нормы на один набор и сумма комплектующей в одном наборе
//                        (Сумма нужна для долей стоимости);
//   ДатаСборки         - Дата - на секунду раньше продажи;
//   Продажа            - ДокументОбъект - документ продажи (для Организации, Склада);
//   КоличествоНаборов  - Число - сколько комплектов собрать;
//   Настройки          - Структура - настройки (склад по умолчанию);
//   СуффиксГруппы      - Строка - суффикс группы (характеристика, ставка НДС)
//                        для ключа идемпотентности сборки.
//
// Возвращаемое значение:
//   Структура - ключи:
//     * Ссылка    - ДокументСсылка.КомплектацияНоменклатуры - сборка или пустая ссылка;
//     * Проведена - Булево - сборка проведена;
//     * Причина   - Строка - почему не проведена (пусто, если проведена).
//
Функция СоздатьСборку(Карточка, СоставОдногоНабора, ДатаСборки, Продажа,
	КоличествоНаборов, Настройки, СуффиксГруппы = "") Экспорт

	Результат = Новый Структура("Ссылка, Проведена, Причина");
	Результат.Ссылка = Документы["КомплектацияНоменклатуры"].ПустаяСсылка();
	Результат.Проведена = Ложь;
	Результат.Причина = "";

	Организация = Неопределено;

	Попытка
		Организация = Продажа["Организация"];
	Исключение
		ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Информация,
			"КомплектыОбмен: организация в документе не найдена — сборка без организации: "
			+ ОписаниеОшибки());
	КонецПопытки;

	Склад = ОпределитьСкладДляСборки(Продажа, Настройки);

	Если Не ЗначениеЗаполнено(Склад) Тогда
		Результат.Причина = "Не заполнен склад для сборки";
		Возврат Результат;
	КонецЕсли;

	Док = Документы["КомплектацияНоменклатуры"].СоздатьДокумент();
	Док.Дата = ДатаСборки;

	Попытка
		Док.ВидОперации = Перечисления["ВидыОперацийКомплектацияНоменклатуры"]["Комплектация"];
	Исключение
		ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Информация,
			"КомплектыОбмен: вид операции «Комплектация» не установлен — " + ОписаниеОшибки());
	КонецПопытки;

	Если ЗначениеЗаполнено(Организация) Тогда
		Док.Организация = Организация;
	КонецЕсли;
	Если ЗначениеЗаполнено(Склад) Тогда
		Док.Склад = Склад;
	КонецЕсли;
	Док.Номенклатура = Карточка;
	Док.Количество = КоличествоНаборов;

	// Комментарий для идемпотентности. Дата — через ДатаКлюч(), а не «ДЛФ=Д»:
	// локалезависимый формат при смене региональных установок давал другую
	// строку, и повторная загрузка создавала вторую сборку (дефект N3).
	Попытка
		Коммент = "Сборка под продажу " + Продажа["Номер"]
			+ " от " + КомплектыОбмен_Сервер.ДатаКлюч(Продажа["Дата"]) + СуффиксГруппы;
		Док["Комментарий"] = Коммент;
	Исключение
		// Комментарий — ключ идемпотентности при повторной загрузке той же
		// продажи: без него сборка задвоится, поэтому предупреждение.
		ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Предупреждение,
			"КомплектыОбмен: комментарий сборки не заполнен — повторная загрузка создаст вторую сборку: "
			+ ОписаниеОшибки());
	КонецПопытки;

	// Счёт учета — 41.01 (конфигурациезависим, пробуем)
	Попытка
		Счет41 = ПланыСчетов["Хозрасчетный"].НайтиПоКоду("41.01");
		Если ЗначениеЗаполнено(Счет41) Тогда
			Док.СчетУчета = Счет41;
		КонецЕсли;
	Исключение
		ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Информация,
			"КомплектыОбмен: счёт 41.01 не найден — сборка без счёта учёта: " + ОписаниеОшибки());
	КонецПопытки;

	// Доли стоимости — пропорционально суммам комплектующих в одном наборе,
	// а не поровну: иначе себестоимость комплекта раскладывается не по вкладу
	// комплектующей (дефект N9). Последняя доля добирает остаток до 100.
	ДолиСтоимости = РассчитатьДолиСтоимости(СоставОдногоНабора);

	ИндексСтроки = 0;
	Для Каждого Компл Из СоставОдногоНабора Цикл
		Строка = Док.Комплектующие.Добавить();
		Строка.Номенклатура = Компл.Номенклатура;
		Строка.Количество = Компл.Количество * КоличествоНаборов;
		Строка.ДоляСтоимости = ДолиСтоимости[ИндексСтроки];
		ИндексСтроки = ИндексСтроки + 1;

		Попытка
			Если ЗначениеЗаполнено(Счет41) Тогда
				Строка["СчетУчета"] = Счет41;
			КонецЕсли;
		Исключение
			ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Информация,
				"КомплектыОбмен: в строке сборки нет реквизита «СчетУчета» — " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

	// Запись и проведение. Отказ проведения не означает успех: остатка нет —
	// себестоимость не сформирована, поэтому причина возвращается вызывающему
	// и попадает в журнал обработки (дефект N5).
	Попытка
		Док.ДополнительныеСвойства.Вставить("ЗаполнитьСчетаУчетаПередЗаписью", Истина);
		Док.Записать(РежимЗаписиДокумента.Проведение);
		Результат.Ссылка = Док.Ссылка;
		Результат.Проведена = Истина;
	Исключение
		ИнфоОш = ИнформацияОбОшибке();
		Попытка
			Док.Записать(РежимЗаписиДокумента.Запись);
			Результат.Ссылка = Док.Ссылка;
			Результат.Проведена = Ложь;
			Результат.Причина = "Сборка записана без проведения: "
				+ КраткоеПредставлениеОшибки(ИнфоОш);
		Исключение
			Результат.Причина = "Сборку не удалось записать: " + КраткоеПредставлениеОшибки(ИнфоОш);
		КонецПопытки;
		ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Предупреждение,
			"КомплектыОбмен: " + Результат.Причина);
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Подавить обратную регистрацию созданных объектов.
// Вызывается из адаптера после всех операций, до завершения сеанса обмена.
//
// Параметры:
//   Карточка  - СправочникСсылка.Номенклатура;
//   Спецификация - СправочникСсылка.СпецификацииНоменклатуры;
//   Сборка    - ДокументСсылка.КомплектацияНоменклатуры.
//
Процедура СнятьРегистрациюОбъектов(Карточка, Спецификация, Сборка) Экспорт

	// Определяем планы обмена на стороне БП
	Планы = Новый Массив;
	Попытка
		Для Каждого План Из Метаданные.ПланыОбмена Цикл
			Планы.Добавить(План.Имя);
		КонецЦикла;
	Исключение
		Возврат;
	КонецПопытки;

	Для Каждого ИмяПлана Из Планы Цикл
		Попытка
			Менеджер = ПланыОбмена[ИмяПлана];
			Если ЗначениеЗаполнено(Карточка) Тогда
				Менеджер.УдалитьРегистрациюИзменений(Карточка);
			КонецЕсли;
			Если ЗначениеЗаполнено(Спецификация) Тогда
				Менеджер.УдалитьРегистрациюИзменений(Спецификация);
			КонецЕсли;
			Если ЗначениеЗаполнено(Сборка) Тогда
				Менеджер.УдалитьРегистрациюИзменений(Сборка);
			КонецЕсли;
		Исключение
			// Объекты останутся в плане обмена и уедут обратно в УТ — это
			// нежелательно, но не смертельно: предупреждение, не ошибка.
			ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Предупреждение,
				"КомплектыОбмен: созданные объекты остались зарегистрированными к выгрузке — "
				+ ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ВнутренниеМетоды

// Доли стоимости комплектующих в процентах, пропорционально суммам.
//
// При нулевой общей сумме (цены не заполнены) откат к равным долям. Последняя
// доля добирает остаток до 100, чтобы сумма долей была ровно 100 и себестоимость
// комплекта сходилась с суммой себестоимостей комплектующих.
//
// Параметры:
//   СоставОдногоНабора - Массив из Структура {Номенклатура, Количество, Сумма}.
//
// Возвращаемое значение:
//   Массив из Число - доли в том же порядке, что и состав.
//
Функция РассчитатьДолиСтоимости(СоставОдногоНабора)

	Количество = СоставОдногоНабора.Количество();
	Доли = Новый Массив;

	Если Количество = 0 Тогда
		Возврат Доли;
	КонецЕсли;

	ОбщаяСумма = 0;
	Для Каждого Компл Из СоставОдногоНабора Цикл
		ОбщаяСумма = ОбщаяСумма + СуммаКомплектующей(Компл);
	КонецЦикла;

	Если ОбщаяСумма <= 0 Тогда
		// Цен нет — доли равные, как было до правки N9.
		РавнаяДоля = Окр(100 / Количество, 2);
		Накоплено = 0;
		Для Индекс = 0 По Количество - 1 Цикл
			Если Индекс = Количество - 1 Тогда
				Доли.Добавить(Окр(100 - Накоплено, 2));
			Иначе
				Доли.Добавить(РавнаяДоля);
				Накоплено = Накоплено + РавнаяДоля;
			КонецЕсли;
		КонецЦикла;
		Возврат Доли;
	КонецЕсли;

	Накоплено = 0;
	Для Индекс = 0 По Количество - 1 Цикл
		Если Индекс = Количество - 1 Тогда
			Доли.Добавить(Окр(100 - Накоплено, 2));
		Иначе
			Доля = Окр(СуммаКомплектующей(СоставОдногоНабора[Индекс]) / ОбщаяСумма * 100, 2);
			Доли.Добавить(Доля);
			Накоплено = Накоплено + Доля;
		КонецЕсли;
	КонецЦикла;

	Возврат Доли;

КонецФункции

// Сумма комплектующей в одном наборе с защитой от отсутствия поля.
//
// Параметры:
//   Компл - Структура - элемент состава {Номенклатура, Количество[, Сумма]}.
//
// Возвращаемое значение:
//   Число - сумма или 0, если суммы нет.
//
Функция СуммаКомплектующей(Компл)

	Если Компл.Свойство("Сумма") И ЗначениеЗаполнено(Компл.Сумма) Тогда
		Возврат Компл.Сумма;
	КонецЕсли;

	Возврат 0;

КонецФункции

Функция НайтиПервыйПоНаименованию(ИмяСправочника, Наименование)

	Попытка
		Запрос = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка
			|ИЗ Справочник." + ИмяСправочника + "
			|ГДЕ Наименование ПОДОБНО &Наименование");
		Запрос.УстановитьПараметр("Наименование", "%" + Наименование + "%");
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	Исключение
		// Справочника нет в этой конфигурации либо в нём нет «Наименование» —
		// вызывающий получит Неопределено и обойдётся без реквизита.
		ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Информация,
			"КомплектыОбмен: поиск «" + Наименование + "» в справочнике «"
			+ ИмяСправочника + "» не выполнен — " + ОписаниеОшибки());
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

// Пишет сообщение прикладного журнала регистрации.
//
// Параметры:
//   Уровень - УровеньЖурналаРегистрации - важность сообщения.
//   Текст   - Строка - описание проблемы.
//
Процедура ЗаписатьВЖурнал(Уровень, Текст)

	ЗаписьЖурналаРегистрации("КомплектыОбмен.Обмен", Уровень, , , Лев(Текст, 1000));

КонецПроцедуры

#КонецОбласти
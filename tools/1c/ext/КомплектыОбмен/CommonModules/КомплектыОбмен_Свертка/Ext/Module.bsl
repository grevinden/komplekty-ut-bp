#Область ПрограммныйИнтерфейс

// Выполнить полную обработку документа: прочитать пометку, для каждой группы
// наборов создать/найти карточку, спецификацию, сборку и заменить строки.
//
// Группа пометки — это набор плюс его характеристика (см. КомплектыОбмен_Пометка).
// Если в группе больше одной ставки НДС и включена настройка
// «РазделятьПоСтавкамНДС», группа делится на подгруппы по ставке: у каждой
// подгруппы своя карточка «Набор (НДС …)», своя спецификация и сборка, а в
// документе — своя строка комплекта. Иначе строка комплекта несла бы ставку
// одной строки и НДС суммы всех строк — внутренне противоречивая строка.
// Если настройка выключена, смешанная группа не сворачивается: строки
// комплектующих остаются в документе, причина пишется в журнал.
//
// Параметры:
//   ПолученныеДанные - ДокументОбъект - документ, собранный из сообщения,
//                      ещё не записанный. Изменяется in-place.
//   Настройки        - Структура - результат КомплектыОбмен_Настройки.ПрочитатьНастройки().
//   ГруппыПометки    - Массив из Структура, Неопределено - уже прочитанная пометка;
//                      Неопределено — прочитать внутри.
//
// Возвращаемое значение:
//   Структура - результат обработки:
//     * Обработано - Булево - была ли свёртка (Истина) или документ без пометки (Ложь);
//     * Группы     - Массив из Структура - что сделано с каждой группой (см. ниже);
//     * Ошибки     - Массив из Строка - сообщения об ошибках по группам.
//
//   Элемент массива Группы:
//     * КлючГруппы        - Строка - ключ группы (УИД, характеристика, ставка НДС);
//     * Успех             - Булево - группа свёрнута (строки заменены строкой комплекта);
//     * ЕстьОшибка        - Булево - обработка завершилась с ошибкой или предупреждением;
//     * Сообщение         - Строка - описание/ошибка;
//     * Карточка          - СправочникСсылка.Номенклатура - комплект;
//     * Спецификация      - СправочникСсылка.СпецификацииНоменклатуры;
//     * Сборка            - ДокументСсылка.КомплектацияНоменклатуры;
//     * КоличествоНаборов - Число.
//
Функция ОбработатьДокумент(ПолученныеДанные, Настройки, ГруппыПометки = Неопределено) Экспорт

	Результат = Новый Структура("Обработано, Группы, Ошибки");
	Результат.Обработано = Ложь;
	Результат.Группы = Новый Массив;
	Результат.Ошибки = Новый Массив;

	// 1. Прочитать пометку
	Если ГруппыПометки = Неопределено Тогда
		ГруппыПометки = КомплектыОбмен_Пометка.ПрочитатьГруппы(ПолученныеДанные);
	КонецЕсли;

	Если ГруппыПометки = Неопределено Или ГруппыПометки.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Обработано = Истина;

	// 2. Разделить строки «Товары» на групповые и негрупповые.
	// Работаем с копией таблицы: исходная очищается на шаге 4, а строки,
	// которые надо сохранить в документе, остаются живыми в копии.
	Товары = ПолученныеДанные["Товары"];
	// У табличной части документа нет метода Скопировать() — он есть только
	// у ТаблицаЗначений. Выгрузить() возвращает таблицу значений с теми же
	// колонками и типами (проверено 05.11.2026 на 8.3.27.2342).
	ТоварыКопия = Товары.Выгрузить();

	// Карта «индекс строки документа → номер группы пометки».
	ИндексВГруппу = Новый Соответствие;
	Для ИндГ = 0 По ГруппыПометки.Количество() - 1 Цикл
		Для Каждого ИндСтроки Из ГруппыПометки[ИндГ].Строки Цикл
			ИндексВГруппу.Вставить(ИндСтроки, ИндГ);
		КонецЦикла;
	КонецЦикла;

	НеГрупповыеСтроки = Новый Массив; // строки без пометки — обычные товары
	СтрокиГрупп = Новый Массив; // по номеру группы: массив строк
	СтавкиГрупп = Новый Массив; // по номеру группы: Соответствие «ключ ставки → сведения»

	Для ИндГ = 0 По ГруппыПометки.Количество() - 1 Цикл
		СтрокиГрупп.Добавить(Новый Массив);
		СтавкиГрупп.Добавить(Новый Соответствие);
	КонецЦикла;

	Для Инд = 0 По ТоварыКопия.Количество() - 1 Цикл
		НомерГруппы = ИндексВГруппу.Получить(Инд);
		Если НомерГруппы = Неопределено Тогда
			НеГрупповыеСтроки.Добавить(ТоварыКопия[Инд]);
			Продолжить;
		КонецЕсли;

		СтрокаТ = ТоварыКопия[Инд];
		СтрокиГрупп[НомерГруппы].Добавить(СтрокаТ);
		Сведения = СведенияОСтавке(СтрокаТ);
		СтавкиГрупп[НомерГруппы].Вставить(Сведения.Ключ, Сведения);
	КонецЦикла;

	// 3. Собрать рабочие единицы: одна группа — или группа целиком, или
	// подгруппы по ставке НДС.
	ГрупповыеДанные = Новый Массив;
	НеудавшиесяГруппы = Новый Массив; // единицы, чьи строки остаются в документе

	Для ИндГ = 0 По ГруппыПометки.Количество() - 1 Цикл
		Группа = ГруппыПометки[ИндГ];
		Строки = СтрокиГрупп[ИндГ];
		Если Строки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		Ставки = СтавкиГрупп[ИндГ];
		Разделять = Настройки.Свойство("РазделятьПоСтавкамНДС") И Настройки.РазделятьПоСтавкамНДС;

		Если Ставки.Количество() > 1 И Не Разделять Тогда
			// Вариант C: смешанную группу не сворачиваем — иначе строка
			// комплекта была бы внутренне противоречивой по НДС.
			Рез = Новый Структура("КлючГруппы, Успех, ЕстьОшибка, Сообщение, Карточка, " +
				"Спецификация, Сборка, КоличествоНаборов");
			Рез.КлючГруппы = Группа.КлючГруппы;
			Рез.Успех = Ложь;
			Рез.ЕстьОшибка = Истина;
			Рез.Сообщение = "Смешанные ставки НДС в наборе не сворачиваются: включите "
				+ "«Разделять по ставкам НДС» в настройках контура";
			Рез.Карточка = Неопределено;
			Рез.Спецификация = Неопределено;
			Рез.Сборка = Неопределено;
			Рез.КоличествоНаборов = Группа.КоличествоНаборов;
			Результат.Группы.Добавить(Рез);
			Результат.Ошибки.Добавить(Рез.Сообщение);

			НеудавшиесяГруппы.Добавить(ЕдиницаГруппы(Группа, Строки, Неопределено));
			Продолжить;
		КонецЕсли;

		Если Ставки.Количество() > 1 Тогда
			// ВАЖНО: обход Соответствия через «Для Каждого» даёт КлючИЗначение,
			// а не значение. Прежний код передавал в ЕдиницаГруппы сам
			// КлючИЗначение, и обращение к Полю «Представление» падало
			// («Object field not found (Представление)» — жив. прогон 08.11.2026).
			Для Каждого ЭлементСтавки Из Ставки Цикл
				СведенияСтавки = ЭлементСтавки.Значение;
				СтрокиПодгруппы = Новый Массив;
				Для Каждого СтрокаТ Из Строки Цикл
					Если СведенияОСтавке(СтрокаТ).Ключ = СведенияСтавки.Ключ Тогда
						СтрокиПодгруппы.Добавить(СтрокаТ);
					КонецЕсли;
				КонецЦикла;
				Если СтрокиПодгруппы.Количество() > 0 Тогда
					ГрупповыеДанные.Добавить(
						ЕдиницаГруппы(Группа, СтрокиПодгруппы, СведенияСтавки));
				КонецЕсли;
			КонецЦикла;
		Иначе
			ГрупповыеДанные.Добавить(ЕдиницаГруппы(Группа, Строки, Неопределено));
		КонецЕсли;
	КонецЦикла;

	// 4. Обработать каждую единицу и перестроить таблицу «Товары».
	ВсеСтрокиЗамены = Новый Массив; // новые строки Товары (комплекты)

	Для Каждого ДанныеГруппы Из ГрупповыеДанные Цикл
		РезГруппы = ОбработатьОднуГруппу(ПолученныеДанные, ДанныеГруппы, Настройки);
		Результат.Группы.Добавить(РезГруппы);

		Если РезГруппы.Успех Тогда
			ВсеСтрокиЗамены.Добавить(ПостроитьСтрокуКомплекта(ДанныеГруппы,
				РезГруппы.Карточка, РезГруппы.КоличествоНаборов));
		Иначе
			Результат.Ошибки.Добавить(РезГруппы.Сообщение);
			// D4: строки неуспешной группы нельзя выбрасывать — иначе товар
			// исчезнет из документа, а сумма уменьшится без следа.
			НеудавшиесяГруппы.Добавить(ДанныеГруппы);
		КонецЕсли;
	КонецЦикла;

	Товары.Очистить();

	// Сначала строки комплектов
	Для Каждого СтрокаЗамены Из ВсеСтрокиЗамены Цикл
		Новая = Товары.Добавить();
		ЗаполнитьЗначенияСвойств(Новая, СтрокаЗамены);
	КонецЦикла;

	// Потом обычные товары (не входившие в группы)
	Для Каждого ОбычнаяСтрока Из НеГрупповыеСтроки Цикл
		Новая = Товары.Добавить();
		ЗаполнитьЗначенияСвойств(Новая, ОбычнаяСтрока);
	КонецЦикла;

	// И строки групп, которые свернуть не удалось — как обычные товары
	Для Каждого ДанныеГруппы Из НеудавшиесяГруппы Цикл
		Для Каждого СтрокаГруппы Из ДанныеГруппы.СтрокиГруппы Цикл
			Новая = Товары.Добавить();
			ЗаполнитьЗначенияСвойств(Новая, СтрокаГруппы);
		КонецЦикла;
	КонецЦикла;

	// 5. Пересчитать сумму документа
	НоваяСумма = 0;
	Для Каждого СтрокаТ Из Товары Цикл
		НоваяСумма = НоваяСумма + СтрокаТ.Сумма;
	КонецЦикла;

	// «Услуги» — отдельная табличная часть только в БП; в УТ услуги лежат
	// в «Товары» и уже посчитаны выше. Наличие ТЧ проверяем по метаданным,
	// а не исключением.
	Если ПолученныеДанные.Метаданные().ТабличныеЧасти.Найти("Услуги") <> Неопределено Тогда
		Для Каждого СтрокаУ Из ПолученныеДанные.Услуги Цикл
			НоваяСумма = НоваяСумма + СтрокаУ.Сумма;
		КонецЦикла;
	КонецЕсли;

	Попытка
		ПолученныеДанные["СуммаДокумента"] = НоваяСумма;
	Исключение
		// Реквизита суммы нет — итог проверит штатная запись документа.
		ЗаписатьВЖурнал("сумма документа не пересчитана: " + ОписаниеОшибки());
	КонецПопытки;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ВнутренниеМетоды

// Рабочая единица свёртки: строки и, при делении по ставкам, сведения о ставке.
//
// Параметры:
//   Группа - Структура - группа пометки;
//   Строки - Массив из СтрокаТаблицыЗначений - строки этой единицы;
//   Ставка - Структура {Ключ, Представление}, Неопределено - подгруппа по ставке.
//
// Возвращаемое значение:
//   Структура - ДанныеГруппы (см. ОбработатьОднуГруппу).
//
Функция ЕдиницаГруппы(Группа, Строки, Ставка)

	ДанныеГруппы = Новый Структура("Группа, Ставка, ПерваяСтрока, СтрокиГруппы, Сумма, СуммаНДС");
	ДанныеГруппы.Группа = Группа;
	ДанныеГруппы.Ставка = Ставка;
	ДанныеГруппы.СтрокиГруппы = Новый Массив;
	ДанныеГруппы.Сумма = 0;
	ДанныеГруппы.СуммаНДС = 0;
	ДанныеГруппы.ПерваяСтрока = Неопределено;

	Для Каждого СтрокаТ Из Строки Цикл
		ДанныеГруппы.СтрокиГруппы.Добавить(СтрокаТ);
		ДанныеГруппы.Сумма = ДанныеГруппы.Сумма + СтрокаТ.Сумма;
		ДанныеГруппы.СуммаНДС = ДанныеГруппы.СуммаНДС
			+ ?(ЗначениеЗаполнено(СтрокаТ.СуммаНДС), СтрокаТ.СуммаНДС, 0);
		Если ДанныеГруппы.ПерваяСтрока = Неопределено Тогда
			ДанныеГруппы.ПерваяСтрока = СтрокаТ;
		КонецЕсли;
	КонецЦикла;

	Возврат ДанныеГруппы;

КонецФункции

Функция ОбработатьОднуГруппу(ПолученныеДанные, ДанныеГруппы, Настройки)

	Рез = Новый Структура("КлючГруппы, Успех, ЕстьОшибка, Сообщение, Карточка, " +
		"Спецификация, Сборка, КоличествоНаборов");
	Группа = ДанныеГруппы.Группа;
	// Ключ единицы обработки включает ставку НДС. Без неё подгруппы одной
	// смешанной группы находили одну и ту же карточку (первую созданную) и
	// писали журнал в одну запись: вторая подгруппа теряла свою карточку, а
	// запись журнала перезаписывалась (живой прогон 08.11.2026, Т2).
	КлючЕдиницы = КлючЕдиницыОбработки(Группа, ДанныеГруппы.Ставка);
	Рез.КлючГруппы = КлючЕдиницы;
	Рез.ЕстьОшибка = Ложь;

	// 1. Карточка комплекта — найти или создать
	Карточка = КомплектыОбмен_Карточки.НайтиКарточкуПоУИД(КлючЕдиницы);
	Если Не ЗначениеЗаполнено(Карточка) Тогда
		Если Настройки.СоздаватьКарточки Тогда
			ИмяНабора = ИмяКарточки(Группа, ДанныеГруппы.Ставка);
			Карточка = КомплектыОбмен_Карточки.СоздатьКарточку(ИмяНабора, Настройки);
			КомплектыОбмен_Карточки.ЗаписатьСоответствие(КлючЕдиницы, ИмяНабора, Карточка);
		Иначе
			Рез.Успех = Ложь;
			Рез.ЕстьОшибка = Истина;
			Рез.Сообщение = "Карточка не найдена, создание запрещено настройками";
			Возврат Рез;
		КонецЕсли;
	КонецЕсли;
	Рез.Карточка = Карточка;

	// 2. Количество наборов
	КолНаборов = Группа.КоличествоНаборов;
	Если КолНаборов < 1 Тогда
		КолНаборов = 1;
	КонецЕсли;
	Рез.КоличествоНаборов = КолНаборов;

	// 2.1. Склад для сборки. Без склада документ «Комплектация номенклатуры»
	// не создать, а спецификация без сборки — это не успех, а недоработка.
	Если Не ЗначениеЗаполнено(КомплектыОбмен_Карточки.ОпределитьСкладДляСборки(
		ПолученныеДанные, Настройки)) Тогда
		Рез.Успех = Ложь;
		Рез.ЕстьОшибка = Истина;
		Рез.Сообщение = "Не заполнен склад для сборки";
		Возврат Рез;
	КонецЕсли;

	// 3. Состав одного набора (норма) и сумма комплектующей в одном наборе.
	СоставОдногоНабора = Новый Массив;
	Для Каждого СтрокаТ Из ДанныеГруппы.СтрокиГруппы Цикл
		Элемент = Новый Структура("Номенклатура, Количество, Сумма");
		Элемент.Номенклатура = СтрокаТ.Номенклатура;
		Элемент.Количество = СтрокаТ.Количество / КолНаборов;
		Элемент.Сумма = СтрокаТ.Сумма / КолНаборов;
		СоставОдногоНабора.Добавить(Элемент);
	КонецЦикла;

	// 4. Ключ идемпотентности: номер продажи + дата без зависимости от локали
	// плюс суффикс группы (характеристика, ставка НДС), иначе две подгруппы
	// одной продажи перетирали бы друг друга при повторной загрузке.
	Суффикс = СуффиксГруппы(Группа, ДанныеГруппы.Ставка);
	Попытка
		ИмяСпецификации = "Реализация " + ПолученныеДанные["Номер"]
			+ " от " + КомплектыОбмен_Сервер.ДатаКлюч(ПолученныеДанные["Дата"]) + Суффикс;
	Исключение
		ИмяСпецификации = "Реализация от "
			+ КомплектыОбмен_Сервер.ДатаКлюч(ТекущаяДатаСеанса()) + Суффикс;
	КонецПопытки;

	КомментСборки = "Сборка под продажу " + ПолученныеДанные["Номер"]
		+ " от " + КомплектыОбмен_Сервер.ДатаКлюч(ПолученныеДанные["Дата"]) + Суффикс;

	// 5. Идемпотентность: удалить прежние спецификацию и сборку для этой продажи
	УдалитьПрежниеОбъекты(Карточка, ИмяСпецификации, КомментСборки);

	// 6. Создать спецификацию (состав одного набора)
	Спецификация = КомплектыОбмен_Карточки.СоздатьСпецификацию(Карточка,
		ИмяСпецификации, СоставОдногоНабора);
	Рез.Спецификация = Спецификация;

	// 7. Создать сборку
	ДатаСборки = ПолученныеДанные["Дата"] - 1;
	РезСборки = КомплектыОбмен_Карточки.СоздатьСборку(Карточка,
		СоставОдногоНабора, ДатаСборки, ПолученныеДанные, КолНаборов, Настройки,
		Суффикс);
	Рез.Сборка = РезСборки.Ссылка;

	// 8. Подавить обратную регистрацию созданных объектов
	КомплектыОбмен_Карточки.СнятьРегистрациюОбъектов(Карточка, Спецификация, РезСборки.Ссылка);

	// 9. Результат группы. Строка комплекта создаётся и при непроведённой
	// сборке (иначе товар поменяет представление), но факт отказа виден.
	Рез.Успех = Истина;
	Если РезСборки.Проведена Тогда
		Рез.Сообщение = "OK";
	Иначе
		Рез.ЕстьОшибка = Истина;
		Рез.Сообщение = "Спецификация создана, сборка не проведена: " + РезСборки.Причина;
	КонецЕсли;

	Возврат Рез;

КонецФункции

Процедура УдалитьПрежниеОбъекты(Карточка, ИмяСпецификации, КомментПоиск)

	// Удалить прежнюю спецификацию с таким же именем — только если она
	// принадлежит этой же карточке. Имя уникально для продажи, но совпасть
	// может у чужой карточки (импорт, ручное создание); удалять чужое нельзя,
	// поэтому такой случай пропускается с записью в журнал (дефект N10).
	Попытка
		Запрос = Новый Запрос("ВЫБРАТЬ Ссылка, Владелец ИЗ Справочник.СпецификацииНоменклатуры
			|ГДЕ Наименование = &Имя");
		Запрос.УстановитьПараметр("Имя", ИмяСпецификации);
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Выборка.Владелец <> Карточка Тогда
				ЗаписатьВЖурнал("прежняя спецификация «" + ИмяСпецификации
					+ "» принадлежит другому владельцу — не удалена");
				Продолжить;
			КонецЕсли;
			Попытка
				Объект = Выборка.Ссылка.ПолучитьОбъект();
				Если Объект <> Неопределено Тогда
					Объект.Удалить();
				КонецЕсли;
			Исключение
				ЗаписатьВЖурнал("не удалось удалить прежнюю спецификацию «"
					+ ИмяСпецификации + "»: " + ОписаниеОшибки());
			КонецПопытки;
		КонецЦикла;
	Исключение
		ЗаписатьВЖурнал("не удалось найти прежние спецификации «" + ИмяСпецификации
			+ "»: " + ОписаниеОшибки());
	КонецПопытки;

	// Удалить прежнюю сборку под эту продажу по комментарию: карточка и дата
	// в отборе ненадёжны (карточка могла быть создана заново, дата сборки
	// сдвигается на секунду), а комментарий содержит номер и дату продажи.
	//
	// Сравнивать комментарий через «=» нельзя: в БП это строка неограниченной
	// длины, запрос падает с «Cannot compare fields of unbounded length»
	// (проверено 05.11.2026 на 8.3.27.2342) — поэтому ПОДОБНО.
	Попытка
		Запрос = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Документ.КомплектацияНоменклатуры
			|ГДЕ Комментарий ПОДОБНО &Комментарий");
		Запрос.УстановитьПараметр("Комментарий", КомментПоиск + "%");
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			Попытка
				ОбъектСборки = Выборка.Ссылка.ПолучитьОбъект();
				Если ОбъектСборки = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				// Проверяем, что это наша сборка (по комментарию)
				ТекстКомментария = ОбъектСборки["Комментарий"];
				Если ПустаяСтрока(ТекстКомментария)
					Или СтрНайти(ТекстКомментария, КомментПоиск) = 0 Тогда
					Продолжить;
				КонецЕсли;
				Если ОбъектСборки.Проведен Тогда
					ОбъектСборки.Записать(РежимЗаписиДокумента.ОтменаПроведения);
				КонецЕсли;
				ОбъектСборки.Удалить();
			Исключение
				ЗаписатьВЖурнал("не удалось удалить прежнюю сборку «" + КомментПоиск
					+ "»: " + ОписаниеОшибки());
			КонецПопытки;
		КонецЦикла;
	Исключение
		ЗаписатьВЖурнал("не удалось найти прежние сборки «" + КомментПоиск
			+ "»: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Пишет сообщение прикладного журнала регистрации по проблемам свёртки.
//
// Параметры:
//   Текст - Строка - описание проблемы.
//
Процедура ЗаписатьВЖурнал(Текст)

	ЗаписьЖурналаРегистрации("КомплектыОбмен.Обмен",
		УровеньЖурналаРегистрации.Ошибка, , , Текст);

КонецПроцедуры

// Есть ли колонка с таким именем в таблице значений строки.
//
// Параметры:
//   СтрокаТаблицы - СтрокаТаблицыЗначений, Неопределено - строка таблицы.
//   ИмяКолонки    - Строка - имя колонки.
//
// Возвращаемое значение:
//   Булево - Истина, если колонка есть.
//
Функция ЕстьКолонка(СтрокаТаблицы, ИмяКолонки)

	Если СтрокаТаблицы = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Владелец = СтрокаТаблицы.Владелец();
	Если Владелец = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Владелец.Колонки.Найти(ИмяКолонки) <> Неопределено;

КонецФункции

// Ключ и представление ставки НДС строки документа.
//
// Ключ не зависит от локали: для перечисления берётся имя значения, для числа —
// XML-представление. Представление нужно только для имени карточки и ключей
// идемпотентности и читается человеком.
//
// Параметры:
//   СтрокаТовара - СтрокаТаблицыЗначений - строка ТЧ «Товары».
//
// Возвращаемое значение:
//   Структура - ключи Ключ и Представление.
//
Функция СведенияОСтавке(СтрокаТовара)

	Сведения = Новый Структура("Ключ, Представление", "БезНДС", "без НДС");

	Если Не ЕстьКолонка(СтрокаТовара, "СтавкаНДС") Тогда
		Возврат Сведения;
	КонецЕсли;

	Ставка = СтрокаТовара["СтавкаНДС"];
	Если Не ЗначениеЗаполнено(Ставка) Тогда
		Возврат Сведения;
	КонецЕсли;

	Если ТипЗнч(Ставка) = Тип("Число") Тогда
		Сведения.Ключ = "Ч" + XMLСтрока(Ставка);
		Сведения.Представление = Формат(Ставка, "ЧДЦ=0") + "%";
	Иначе
		Сведения.Ключ = "С" + Строка(Ставка);
		Представление = СокрЛП(СтрЗаменить(Строка(Ставка), "НДС", ""));
		Если ПустаяСтрока(Представление) Тогда
			Представление = Строка(Ставка);
		КонецЕсли;
		Сведения.Представление = Представление;
	КонецЕсли;

	Возврат Сведения;

КонецФункции

// Имя карточки комплекта: набор плюс характеристика и/или ставка НДС.
//
// Параметры:
//   Группа - Структура - группа пометки;
//   Ставка - Структура {Ключ, Представление}, Неопределено - подгруппа по ставке.
//
// Возвращаемое значение:
//   Строка - имя карточки.
//
Функция ИмяКарточки(Группа, Ставка)

	Имя = Группа.Набор;
	Если ПустаяСтрока(Имя) Тогда
		Имя = "Комплект " + Лев(Группа.КлючГруппы, 8);
	КонецЕсли;

	Возврат Имя + СуффиксГруппы(Группа, Ставка);

КонецФункции

// Суффикс группы для имени карточки, имени спецификации и комментария сборки.
//
// В суффикс входят характеристика набора и ставка НДС (если группа поделена).
// Он же различает ключи идемпотентности двух подгрупп одной продажи.
//
// Параметры:
//   Группа - Структура - группа пометки;
//   Ставка - Структура {Ключ, Представление}, Неопределено - подгруппа по ставке.
//
// Возвращаемое значение:
//   Строка - « (…)» или пустая строка.
//
Функция СуффиксГруппы(Группа, Ставка)

	Части = Новый Массив;

	Если Группа.Свойство("Характеристика") И Не ПустаяСтрока(Группа.Характеристика) Тогда
		Части.Добавить(Группа.Характеристика);
	КонецЕсли;

	Если Ставка <> Неопределено Тогда
		Части.Добавить("НДС " + Ставка.Представление);
	КонецЕсли;

	Если Части.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат " (" + СтрСоединить(Части, "; ") + ")";

КонецФункции

// Ключ единицы обработки: группы пометки плюс ставка НДС.
//
// Подгруппы одной смешанной группы (одна продажа, разные ставки НДС) должны
// иметь разные карточки и разные записи журнала. Ключ группы без ставки этого
// не даёт: вторая подгруппа находила карточку первой и перезаписывала её
// запись журнала (живой прогон 08.11.2026, Т2). Ключ устойчив между загрузками
// одной и той же продажи, потому что собирается из УИД набора и ставки.
//
// Параметры:
//   Группа - Структура - группа пометки;
//   Ставка - Структура {Ключ, Представление}, Неопределено - подгруппа по ставке.
//
// Возвращаемое значение:
//   Строка - ключ единицы обработки.
//
Функция КлючЕдиницыОбработки(Группа, Ставка)

	Если Ставка = Неопределено Тогда
		Возврат Группа.КлючГруппы;
	КонецЕсли;

	Возврат Группа.КлючГруппы + "|Н:" + Ставка.Ключ;

КонецФункции

Функция ПостроитьСтрокуКомплекта(ДанныеГруппы, Карточка, КоличествоНаборов)

	Первая = ДанныеГруппы.ПерваяСтрока;

	СтрокаРезультат = Новый Структура;
	СтрокаРезультат.Вставить("Номенклатура", Карточка);
	СтрокаРезультат.Вставить("Количество", КоличествоНаборов);
	СтрокаРезультат.Вставить("Цена", Окр(ДанныеГруппы.Сумма / КоличествоНаборов, 2));
	СтрокаРезультат.Вставить("Сумма", ДанныеГруппы.Сумма);
	СтрокаРезультат.Вставить("СуммаНДС", ДанныеГруппы.СуммаНДС);

	// Переносим счета, ставку НДС, субконто и единицу из первой строки группы.
	// Набор реквизитов зависит от конфигурации (БП и УТ называют их по-разному),
	// поэтому переносим только те, что есть в колонках таблицы. Проверка по
	// колонкам дешевле и честнее, чем Попытка на каждое имя: раньше пустые
	// блоки «Исключение» гасили в том числе настоящие ошибки типов.
	ИменаДляПереноса = "СтавкаНДС,СчетУчета,СчетДоходов,СчетРасходов,"
		+ "СчетУчетаНДСПоРеализации,Субконто,ЕдиницаИзмерения,Коэффициент";
	Для Каждого ИмяПоля Из СтрРазделить(ИменаДляПереноса, ",") Цикл
		Если ЕстьКолонка(Первая, ИмяПоля) Тогда
			СтрокаРезультат.Вставить(ИмяПоля, Первая[ИмяПоля]);
		КонецЕсли;
	КонецЦикла;

	// Идентификатор строки нужен, чтобы приёмник не считал строку новой
	// при повторной загрузке; если такого реквизита нет, лишний ключ
	// структуры ЗаполнитьЗначенияСвойств просто пропустит.
	СтрокаРезультат.Вставить("ИдентификаторСтроки", Новый УникальныйИдентификатор);

	Возврат СтрокаРезультат;

КонецФункции

#КонецОбласти

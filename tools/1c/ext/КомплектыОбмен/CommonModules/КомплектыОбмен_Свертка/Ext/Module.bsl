#Область ПрограммныйИнтерфейс

// Выполнить полную обработку документа: прочитать пометку, для каждой группы
// наборов создать/найти карточку, спецификацию, сборку и заменить строки.
//
// Параметры:
//   ПолученныеДанные - ДокументОбъект - документ, собранный из сообщения,
//                      ещё не записанный. Изменяется in-place.
//   Настройки        - Структура - результат КомплектыОбмен_Настройки.ПрочитатьНастройки().
//
// Возвращаемое значение:
//   Структура - результат обработки:
//     * Обработано - Булево - была ли свёртка (Истина) или документ без пометки (Ложь);
//     * Группы     - Массив из Структура - что сделано с каждой группой (см. ниже);
//     * Ошибки     - Массив из Строка - сообщения об ошибках по группам.
//
//   Элемент массива Группы:
//     * КлючГруппы        - Строка - УИД набора;
//     * Успех             - Булево - группа обработана без ошибок;
//     * Сообщение         - Строка - описание/ошибка;
//     * Карточка          - СправочникСсылка.Номенклатура - комплект;
//     * Спецификация      - СправочникСсылка.СпецификацииНоменклатуры;
//     * Сборка            - ДокументСсылка.КомплектацияНоменклатуры;
//     * КоличествоНаборов - Число.
//
Функция ОбработатьДокумент(ПолученныеДанные, Настройки) Экспорт

	Результат = Новый Структура("Обработано, Группы, Ошибки");
	Результат.Обработано = Ложь;
	Результат.Группы = Новый Массив;
	Результат.Ошибки = Новый Массив;

	// 1. Прочитать пометку
	ГруппыПометки = КомплектыОбмен_Пометка.ПрочитатьГруппы(ПолученныеДанные);
	Если ГруппыПометки = Неопределено Или ГруппыПометки.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Обработано = Истина;

	// 2. Разделить строки «Товары» на групповые и негрупповые.
	// Работаем с копией таблицы: исходная очищается на шаге 5, а строки,
	// которые надо сохранить в документе, остаются живыми в копии.
	Товары = ПолученныеДанные["Товары"];
	// У табличной части документа нет метода Скопировать() — он есть только
	// у ТаблицаЗначений. Выгрузить() возвращает таблицу значений с теми же
	// колонками и типами (проверено 05.11.2026 на 8.3.27.2342).
	ТоварыКопия = Товары.Выгрузить();
	НеГрупповыеСтроки = Новый Массив; // строки без пометки — обычные товары
	ГрупповыеДанные = Новый Массив; // массив структур {Группа, ПерваяСтрока, СтрокиГруппы, Сумма, СуммаНДС}

	// Инициализируем групповые данные
	Для Каждого Группа Из ГруппыПометки Цикл
		ДанныеГруппы = Новый Структура("Группа, ПерваяСтрока, СтрокиГруппы, Сумма, СуммаНДС");
		ДанныеГруппы.Группа = Группа;
		ДанныеГруппы.СтрокиГруппы = Новый Массив;
		ДанныеГруппы.Сумма = 0;
		ДанныеГруппы.СуммаНДС = 0;
		ДанныеГруппы.ПерваяСтрока = Неопределено;
		ГрупповыеДанные.Добавить(ДанныеГруппы);
	КонецЦикла;

	// Строим карту: индекс → ДанныеГруппы
	ИндексВДанные = Новый Соответствие;
	Для Инд = 0 По ГрупповыеДанные.Количество() - 1 Цикл
		Для Каждого ИндСтроки Из ГрупповыеДанные[Инд].Группа.Строки Цикл
			ИндексВДанные.Вставить(ИндСтроки, Инд);
		КонецЦикла;
	КонецЦикла;

	Для Инд = 0 По ТоварыКопия.Количество() - 1 Цикл
		НомерГруппы = ИндексВДанные.Получить(Инд);
		Если НомерГруппы = Неопределено Тогда
			НеГрупповыеСтроки.Добавить(ТоварыКопия[Инд]);
		Иначе
			ДанныеГруппы = ГрупповыеДанные[НомерГруппы];
			СтрокаТ = ТоварыКопия[Инд];
			ДанныеГруппы.СтрокиГруппы.Добавить(СтрокаТ);
			ДанныеГруппы.Сумма = ДанныеГруппы.Сумма + СтрокаТ.Сумма;

			СуммаНДС = ?(ЗначениеЗаполнено(СтрокаТ.СуммаНДС), СтрокаТ.СуммаНДС, 0);
			ДанныеГруппы.СуммаНДС = ДанныеГруппы.СуммаНДС + СуммаНДС;

			Если ДанныеГруппы.ПерваяСтрока = Неопределено Тогда
				ДанныеГруппы.ПерваяСтрока = СтрокаТ;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	// 3. Обработать каждую группу
	ВсеСтрокиЗамены = Новый Массив; // новые строки Товары (комплекты)
	НеудавшиесяГруппы = Новый Массив; // группы, чьи строки остаются в документе

	Для Каждого ДанныеГруппы Из ГрупповыеДанные Цикл
		РезГруппы = ОбработатьОднуГруппу(ПолученныеДанные, ДанныеГруппы, Настройки);
		Результат.Группы.Добавить(РезГруппы);

		Если РезГруппы.Успех Тогда
			// Создаём строку комплекта для замены
			НоваяСтрока = ПостроитьСтрокуКомплекта(ДанныеГруппы,
				РезГруппы.Карточка, РезГруппы.КоличествоНаборов);
			ВсеСтрокиЗамены.Добавить(НоваяСтрока);
		Иначе
			Результат.Ошибки.Добавить(РезГруппы.Сообщение);
			// D4: строки неуспешной группы нельзя выбрасывать — иначе товар
			// исчезнет из документа, а сумма уменьшится без следа.
			НеудавшиесяГруппы.Добавить(ДанныеГруппы);
		КонецЕсли;
	КонецЦикла;

	// 4. Перестроить таблицу Товары
	Товары.Очистить();

	// Сначала строки комплектов
	Для Каждого СтрокаЗамены Из ВсеСтрокиЗамены Цикл
		Новая = Товары.Добавить();
		ЗаполнитьЗначенияСвойств(Новая, СтрокаЗамены);
	КонецЦикла;

	// Потом обычные товары (не входившие в группы)
	Для Каждого ОбычнаяСтрока Из НеГрупповыеСтроки Цикл
		Новая = Товары.Добавить();
		ЗаполнитьЗначенияСвойств(Новая, ОбычнаяСтрока);
	КонецЦикла;

	// И строки групп, которые свернуть не удалось — как обычные товары
	Для Каждого ДанныеГруппы Из НеудавшиесяГруппы Цикл
		Для Каждого СтрокаГруппы Из ДанныеГруппы.СтрокиГруппы Цикл
			Новая = Товары.Добавить();
			ЗаполнитьЗначенияСвойств(Новая, СтрокаГруппы);
		КонецЦикла;
	КонецЦикла;

	// 5. Пересчитать сумму документа
	НоваяСумма = 0;
	Для Каждого СтрокаТ Из Товары Цикл
		НоваяСумма = НоваяСумма + СтрокаТ.Сумма;
	КонецЦикла;

	// «Услуги» — отдельная табличная часть только в БП; в УТ услуги лежат
	// в «Товары» и уже посчитаны выше. Наличие ТЧ проверяем по метаданным,
	// а не исключением.
	Если ПолученныеДанные.Метаданные().ТабличныеЧасти.Найти("Услуги") <> Неопределено Тогда
		Для Каждого СтрокаУ Из ПолученныеДанные.Услуги Цикл
			НоваяСумма = НоваяСумма + СтрокаУ.Сумма;
		КонецЦикла;
	КонецЕсли;

	Попытка
		ПолученныеДанные["СуммаДокумента"] = НоваяСумма;
	Исключение
		// Реквизита суммы нет — итог проверит штатная запись документа.
		ЗаписатьВЖурнал("сумма документа не пересчитана: " + ОписаниеОшибки());
	КонецПопытки;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ВнутренниеМетоды

Функция ОбработатьОднуГруппу(ПолученныеДанные, ДанныеГруппы, Настройки)

	Рез = Новый Структура("КлючГруппы, Успех, Сообщение, Карточка, Спецификация, Сборка, КоличествоНаборов");
	Группа = ДанныеГруппы.Группа;
	Рез.КлючГруппы = Группа.КлючГруппы;

	// 1. Карточка комплекта — найти или создать
	Карточка = КомплектыОбмен_Карточки.НайтиКарточкуПоУИД(Группа.КлючГруппы);
	Если Не ЗначениеЗаполнено(Карточка) Тогда
		Если Настройки.СоздаватьКарточки Тогда
			ИмяНабора = Группа.Набор;
			Если ПустаяСтрока(ИмяНабора) Тогда
				ИмяНабора = "Комплект " + Лев(Группа.КлючГруппы, 8);
			КонецЕсли;
			Карточка = КомплектыОбмен_Карточки.СоздатьКарточку(ИмяНабора, Настройки);
			КомплектыОбмен_Карточки.ЗаписатьСоответствие(Группа.КлючГруппы, ИмяНабора, Карточка);
		Иначе
			Рез.Успех = Ложь;
			Рез.Сообщение = "Карточка не найдена, создание запрещено настройками";
			Возврат Рез;
		КонецЕсли;
	КонецЕсли;
	Рез.Карточка = Карточка;

	// 2. Количество наборов
	КолНаборов = Группа.КоличествоНаборов;
	Если КолНаборов < 1 Тогда
		КолНаборов = 1;
	КонецЕсли;
	Рез.КоличествоНаборов = КолНаборов;

	// 2.1. Склад для сборки. Без склада документ «Комплектация номенклатуры»
	// не создать, а спецификация без сборки — это не успех, а недоработка.
	Если Не ЗначениеЗаполнено(КомплектыОбмен_Карточки.ОпределитьСкладДляСборки(
		ПолученныеДанные, Настройки)) Тогда
		Рез.Успех = Ложь;
		Рез.Сообщение = "Не заполнен склад для сборки";
		Возврат Рез;
	КонецЕсли;

	// 3. Состав одного набора (норма)
	СоставОдногоНабора = Новый Массив;
	Для Каждого СтрокаТ Из ДанныеГруппы.СтрокиГруппы Цикл
		Элемент = Новый Структура("Номенклатура, Количество");
		Элемент.Номенклатура = СтрокаТ.Номенклатура;
		Элемент.Количество = СтрокаТ.Количество / КолНаборов;
		СоставОдногоНабора.Добавить(Элемент);
	КонецЦикла;

	// 4. Имя спецификации = номер продажи + дата
	Попытка
		ИмяСпецификации = "Реализация " + ПолученныеДанные["Номер"]
			+ " от " + Формат(ПолученныеДанные["Дата"], "ДЛФ=Д");
	Исключение
		ИмяСпецификации = "Реализация от " + Формат(ТекущаяДатаСеанса(), "ДЛФ=Д");
	КонецПопытки;

	// 5. Идемпотентность: удалить прежние спецификацию и сборку для этой продажи
	УдалитьПрежниеОбъекты(Карточка, ИмяСпецификации, ПолученныеДанные);

	// 6. Создать спецификацию
	Спецификация = КомплектыОбмен_Карточки.СоздатьСпецификацию(Карточка,
		ИмяСпецификации, СоставОдногоНабора, КолНаборов);
	Рез.Спецификация = Спецификация;

	// 7. Создать сборку
	ДатаСборки = ПолученныеДанные["Дата"] - 1;
	Сборка = КомплектыОбмен_Карточки.СоздатьСборку(Карточка,
		СоставОдногоНабора, ДатаСборки, ПолученныеДанные, КолНаборов, Настройки);
	Рез.Сборка = Сборка;

	// 8. Подавить обратную регистрацию созданных объектов
	КомплектыОбмен_Карточки.СнятьРегистрациюОбъектов(Карточка, Спецификация, Сборка);

	// 9. Результат группы — без ошибок
	Рез.Успех = Истина;
	Рез.Сообщение = "OK";

	Возврат Рез;

КонецФункции

Процедура УдалитьПрежниеОбъекты(Карточка, ИмяСпецификации, Продажа)

	// Удалить прежнюю спецификацию с таким же именем (повторная загрузка той же продажи).
	// Владелец в отборе не участвует: имя содержит номер и дату продажи и уникально
	// для продажи, а карточка при повторной загрузке может оказаться другой (дубль
	// карточки) — тогда отбор по владельцу не находит прежнюю спецификацию.
	Попытка
		Запрос = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Справочник.СпецификацииНоменклатуры
			|ГДЕ Наименование = &Имя");
		Запрос.УстановитьПараметр("Имя", ИмяСпецификации);
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			Попытка
				Объект = Выборка.Ссылка.ПолучитьОбъект();
				Если Объект <> Неопределено Тогда
					Объект.Удалить();
				КонецЕсли;
			Исключение
				ЗаписатьВЖурнал("не удалось удалить прежнюю спецификацию «"
					+ ИмяСпецификации + "»: " + ОписаниеОшибки());
			КонецПопытки;
		КонецЦикла;
	Исключение
		ЗаписатьВЖурнал("не удалось найти прежние спецификации «" + ИмяСпецификации
			+ "»: " + ОписаниеОшибки());
	КонецПопытки;

	// Удалить прежнюю сборку под эту продажу по комментарию: карточка и дата
	// в отборе ненадёжны (карточка могла быть создана заново, дата сборки
	// сдвигается на секунду), а комментарий содержит номер и дату продажи.
	//
	// Сравнивать комментарий через «=» нельзя: в БП это строка неограниченной
	// длины, запрос падает с «Cannot compare fields of unbounded length»
	// (проверено 05.11.2026 на 8.3.27.2342) — поэтому ПОДОБНО.
	Попытка
		КомментПоиск = "Сборка под продажу " + Продажа["Номер"] + " от "
			+ Формат(Продажа["Дата"], "ДЛФ=Д");
		Запрос = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Документ.КомплектацияНоменклатуры
			|ГДЕ Комментарий ПОДОБНО &Комментарий");
		Запрос.УстановитьПараметр("Комментарий", КомментПоиск + "%");
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			Попытка
				ОбъектСборки = Выборка.Ссылка.ПолучитьОбъект();
				Если ОбъектСборки = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				// Проверяем, что это наша сборка (по комментарию)
				ТекстКомментария = ОбъектСборки["Комментарий"];
				Если ПустаяСтрока(ТекстКомментария)
					Или СтрНайти(ТекстКомментария, КомментПоиск) = 0 Тогда
					Продолжить;
				КонецЕсли;
				Если ОбъектСборки.Проведен Тогда
					ОбъектСборки.Записать(РежимЗаписиДокумента.ОтменаПроведения);
				КонецЕсли;
				ОбъектСборки.Удалить();
			Исключение
				ЗаписатьВЖурнал("не удалось удалить прежнюю сборку «" + КомментПоиск
					+ "»: " + ОписаниеОшибки());
			КонецПопытки;
		КонецЦикла;
	Исключение
		ЗаписатьВЖурнал("не удалось найти прежние сборки «" + КомментПоиск
			+ "»: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Пишет сообщение прикладного журнала регистрации по проблемам свёртки.
//
// Параметры:
//   Текст - Строка - описание проблемы.
//
Процедура ЗаписатьВЖурнал(Текст)

	ЗаписьЖурналаРегистрации("КомплектыОбмен.Обмен",
		УровеньЖурналаРегистрации.Ошибка, , , Текст);

КонецПроцедуры

// Есть ли колонка с таким именем в таблице значений строки.
//
// Параметры:
//   СтрокаТаблицы - СтрокаТаблицыЗначений, Неопределено - строка таблицы.
//   ИмяКолонки    - Строка - имя колонки.
//
// Возвращаемое значение:
//   Булево - Истина, если колонка есть.
//
Функция ЕстьКолонка(СтрокаТаблицы, ИмяКолонки)

	Если СтрокаТаблицы = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Владелец = СтрокаТаблицы.Владелец();
	Если Владелец = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Владелец.Колонки.Найти(ИмяКолонки) <> Неопределено;

КонецФункции

Функция ПостроитьСтрокуКомплекта(ДанныеГруппы, Карточка, КоличествоНаборов)

	Первая = ДанныеГруппы.ПерваяСтрока;

	СтрокаРезультат = Новый Структура;
	СтрокаРезультат.Вставить("Номенклатура", Карточка);
	СтрокаРезультат.Вставить("Количество", КоличествоНаборов);
	СтрокаРезультат.Вставить("Цена", Окр(ДанныеГруппы.Сумма / КоличествоНаборов, 2));
	СтрокаРезультат.Вставить("Сумма", ДанныеГруппы.Сумма);
	СтрокаРезультат.Вставить("СуммаНДС", ДанныеГруппы.СуммаНДС);

	// Переносим счета, ставку НДС, субконто и единицу из первой строки группы.
	// Набор реквизитов зависит от конфигурации (БП и УТ называют их по-разному),
	// поэтому переносим только те, что есть в колонках таблицы. Проверка по
	// колонкам дешевле и честнее, чем Попытка на каждое имя: раньше пустые
	// блоки «Исключение» гасили в том числе настоящие ошибки типов.
	ИменаДляПереноса = "СтавкаНДС,СчетУчета,СчетДоходов,СчетРасходов,"
		+ "СчетУчетаНДСПоРеализации,Субконто,ЕдиницаИзмерения,Коэффициент";
	Для Каждого ИмяПоля Из СтрРазделить(ИменаДляПереноса, ",") Цикл
		Если ЕстьКолонка(Первая, ИмяПоля) Тогда
			СтрокаРезультат.Вставить(ИмяПоля, Первая[ИмяПоля]);
		КонецЕсли;
	КонецЦикла;

	// Идентификатор строки нужен, чтобы приёмник не считал строку новой
	// при повторной загрузке; если такого реквизита нет, лишний ключ
	// структуры ЗаполнитьЗначенияСвойств просто пропустит.
	СтрокаРезультат.Вставить("ИдентификаторСтроки", Новый УникальныйИдентификатор);

	Возврат СтрокаРезультат;

КонецФункции

#КонецОбласти
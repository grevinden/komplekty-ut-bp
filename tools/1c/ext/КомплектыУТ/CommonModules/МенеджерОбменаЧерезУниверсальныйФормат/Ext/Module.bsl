// Адаптер управления торговлей: заимствованный общий модуль менеджера обмена.
// Добавлены &После на точки:
//  1. ДобавитьПКО_Документ_РеализацияТоваровУслуг_Отправка — добавление свойств пометки набора в ПКО;
//  2. ПКО_Документ_РеализацияТоваровУслуг_Отправка_ПриОтправкеДанных — заполнение свойств.

#Область ПрограммныйИнтерфейс

&После("ДобавитьПКО_Документ_РеализацияТоваровУслуг_Отправка")
Процедура КомплектыУТ_ДополнитьПКООтправка(ПравилаКонвертации) Экспорт

	URI = "http://v8.1c.ru/edi/edi_stnd_ext_enterprisedata/EnterpriseData/1.20";

	// Инициализировать расширение правила конвертации
	Попытка
		ОбменДаннымиXDTOСервер.ИнициализироватьРасширениеПравилаКонвертацииОбъекта(
			ПравилаКонвертации, URI);
	Исключение
		Возврат;
	КонецПопытки;

	// Добавить наши свойства к табличной части «Товары»
	Попытка
		СвойстваТЧ = ПравилаКонвертации.Свойства.Найти("Товары");
		Если СвойстваТЧ = Неопределено Тогда
			Возврат;
		КонецЕсли;

		ДобавитьПКС(СвойстваТЧ, "", "КомплектыОбмен_НаборУИД", 1, "", URI);
		ДобавитьПКС(СвойстваТЧ, "", "КомплектыОбмен_Набор", 1, "", URI);
		ДобавитьПКС(СвойстваТЧ, "", "КомплектыОбмен_КоличествоНаборов", 1, "", URI);
	Исключение
	КонецПопытки;

КонецПроцедуры

&После("ПКО_Документ_РеализацияТоваровУслуг_Отправка_ПриОтправкеДанных")
Процедура КомплектыУТ_ЗаполнитьПометку(
	ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки) Экспорт

	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;

	Попытка
		URI = "http://v8.1c.ru/edi/edi_stnd_ext_enterprisedata/EnterpriseData/1.20";

		// Товары документа
		ТоварыИБ = ДанныеИБ.Товары;
		Если ТоварыИБ.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;

		// Собираем группы: НоменклатураНабора → {Строки, КоличествоНаборов}
		Группы = Новый Соответствие;
		Для Каждого СтрокаТовара Из ТоварыИБ Цикл
			Набор = СтрокаТовара.НоменклатураНабора;
			Если Не ЗначениеЗаполнено(Набор) Тогда
				Продолжить; // строка без набора — обычный товар
			КонецЕсли;

			УИД = Строка(Набор.УникальныйИдентификатор());
			ДанныеГруппы = Группы.Получить(УИД);
			Если ДанныеГруппы = Неопределено Тогда
				ДанныеГруппы = Новый Структура;
				ДанныеГруппы.Вставить("УИД", УИД);
				ДанныеГруппы.Вставить("Набор", Набор);
				ДанныеГруппы.Вставить("Строки", Новый Массив);
				Группы.Вставить(УИД, ДанныеГруппы);
			КонецЕсли;
			ДанныеГруппы.Строки.Добавить(СтрокаТовара);
		КонецЦикла;

		Если Группы.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;

		// Теперь нужно записать пометку в XDTO-данные.
		// Получаем доступ к Товарам в XDTO через фабрику или прямой доступ.
		// Для строк XDTO табличной части используем свойство по индексу.
		Попытка
			XDTOТовары = ДанныеXDTO.Товары;
			Если XDTOТовары = Неопределено Тогда
				Возврат;
			КонецЕсли;
			// Проходим по строкам XDTO и заполняем пометку
			Для НомерСтроки = 0 По XDTOТовары.Количество() - 1 Цикл
				СтрокаXDTO = XDTOТовары[НомерСтроки];

				Попытка
					НомерДокСтроки = СтрокаXDTO.НомерСтрокиДокумента;
				Исключение
					Продолжить;
				КонецПопытки;

				// Ищем соответствующую строку ИБ по номеру строки
				СтрокаИБ = Неопределено;
				Для Инд = 0 По ТоварыИБ.Количество() - 1 Цикл
					Если ТоварыИБ[Инд].НомерСтроки = НомерДокСтроки Тогда
						СтрокаИБ = ТоварыИБ[Инд];
						Прервать;
					КонецЕсли;
				КонецЦикла;

				Если СтрокаИБ = Неопределено Или Не ЗначениеЗаполнено(СтрокаИБ.НоменклатураНабора) Тогда
					Продолжить;
				КонецЕсли;

				УИД = Строка(СтрокаИБ.НоменклатураНабора.УникальныйИдентификатор());
				ДанныеГруппы = Группы.Получить(УИД);
				Если ДанныеГруппы = Неопределено Тогда
					Продолжить;
				КонецЕсли;

				// Установка расширенных свойств XDTO
				Попытка
					Фабрика = КомпонентыОбмена.ФабрикаXDTO;
					ТипXDTOСтроки = СтрокаXDTO.Тип();

					// Создаём значение для расширенного свойства
					СтрокаXDTO.КомплектыОбмен_НаборУИД = УИД;
					СтрокаXDTO.КомплектыОбмен_Набор = Строка(ДанныеГруппы.Набор);
					СтрокаXDTO.КомплектыОбмен_КоличествоНаборов = 1;
				Исключение
					// Если прямое присвоение не сработало — пробуем через свойство
					Попытка
						УстановитьРасширенноеСвойствоXDTO(
							СтрокаXDTO, URI, "КомплектыОбмен_НаборУИД", УИД);
						УстановитьРасширенноеСвойствоXDTO(
							СтрокаXDTO, URI, "КомплектыОбмен_Набор", Строка(ДанныеГруппы.Набор));
						УстановитьРасширенноеСвойствоXDTO(
							СтрокаXDTO, URI, "КомплектыОбмен_КоличествоНаборов", 1);
					Исключение
					КонецПопытки;
				КонецПопытки;

			КонецЦикла;
		Исключение
		КонецПопытки;
	Исключение
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедуры

Процедура УстановитьРасширенноеСвойствоXDTO(ОбъектXDTO, URI, ИмяСвойства, Значение)

	Попытка
		Свойство = ОбъектXDTO.Тип().Свойства.Найти(ИмяСвойства);
		Если Свойство <> Неопределено Тогда
			ОбъектXDTO.Установить(Свойство, ФабрикаXDTO.Создать(Свойство.Тип, Значение));
		КонецЕсли;
	Исключение
	КонецПопытки;

КонецПроцедуры

#КонецОбласти
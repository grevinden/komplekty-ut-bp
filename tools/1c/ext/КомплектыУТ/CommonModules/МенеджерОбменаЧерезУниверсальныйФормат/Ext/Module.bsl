// Адаптер управления торговлей: заимствованный общий модуль менеджера обмена.
// Добавлены &После на точки:
//  1. ДобавитьПКО_Документ_РеализацияТоваровУслуг_Отправка — добавление свойств пометки набора в ПКО;
//  2. ПКО_Документ_РеализацияТоваровУслуг_Отправка_ПриОтправкеДанных — заполнение колонок
//     пометки в таблице значений «Товары», которую движок затем превращает в XDTO.
//
// Имена свойств пометки едины для пары баз (см. КомплектыОбмен_Пометка).

#Область ПрограммныйИнтерфейс

&После("ДобавитьПКО_Документ_РеализацияТоваровУслуг_Отправка")
Процедура КомплектыУТ_ДополнитьПКООтправка(ПравилаКонвертации) Экспорт

	URI = КомплектыОбмен_Пометка.ПространствоИменРасширения();

	// Штатная процедура менеджера уже добавила строку ПКО и заполнила её.
	// ИнициализироватьРасширениеПравилаКонвертацииОбъекта принимает СТРОКУ
	// правил конвертации: у самой таблицы поля «Расширения» нет
	// (проверено 05.11.2026, см. cfg/EVIDENCE-2026-11-06-pometka-wire.md).
	СтрокаПКО = СтрокаПравилаКонвертации(ПравилаКонвертации,
		"Документ_РеализацияТоваровУслуг_Отправка");
	Если СтрокаПКО = Неопределено Тогда
		ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Предупреждение,
			"КомплектыУТ: в правилах конвертации нет ПКО «Документ_РеализацияТоваровУслуг_Отправка» — пометка наборов не выгружена.");
		Возврат;
	КонецЕсли;

	// Движок должен знать, что у объекта есть расширяющий XDTO-пакет,
	// иначе свойства пометки не попадут в сообщение.
	Если СтрокаПКО.Расширения = Неопределено Тогда
		СтрокаПКО.Расширения = Новый Соответствие;
	КонецЕсли;
	ОбменДаннымиXDTOСервер.ИнициализироватьРасширениеПравилаКонвертацииОбъекта(
		СтрокаПКО, URI);

	// В ПКО отправки табличная часть «Товары» заведена как ТЧФормата = "Товары"
	// (ТЧКонфигурации пустая), поэтому ищем именно по имени в формате.
	СвойстваТЧ = СвойстваТабличнойЧастиФормата(СтрокаПКО, "Товары");
	Если СвойстваТЧ = Неопределено Тогда
		ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Предупреждение,
			"КомплектыУТ: в ПКО отправки не найдена табличная часть формата «Товары» — пометка наборов не выгружена.");
		Возврат;
	КонецЕсли;

	ДобавитьПКС(СвойстваТЧ, "", "КомплектыОбмен_НаборУИД", 1, "", URI);
	ДобавитьПКС(СвойстваТЧ, "", "КомплектыОбмен_Набор", 1, "", URI);
	ДобавитьПКС(СвойстваТЧ, "", "КомплектыОбмен_ХарактеристикаНабора", 1, "", URI);
	ДобавитьПКС(СвойстваТЧ, "", "КомплектыОбмен_КоличествоНаборов", 1, "", URI);

КонецПроцедуры

&После("ПКО_Документ_РеализацияТоваровУслуг_Отправка_ПриОтправкеДанных")
Процедура КомплектыУТ_ЗаполнитьПометку(
	ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки) Экспорт

	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;

	ТоварыИБ = ДанныеИБ.Товары;
	Если ТоварыИБ.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// Карта «номер строки документа → пометка набора». Номер строки уникален
	// внутри табличной части и переносится в XDTO свойством НомерСтрокиДокумента,
	// поэтому по нему и сопоставляем строки.
	ПометкаПоНомеру = Новый Соответствие;
	// Число наборов считается один раз на набор: все строки одного набора
	// в документе относятся к одному и тому же количеству наборов.
	КоличествоНаборовПоГруппе = Новый Соответствие;
	Для Каждого СтрокаТовара Из ТоварыИБ Цикл
		Набор = СтрокаТовара.НоменклатураНабора;
		Если Не ЗначениеЗаполнено(Набор) Тогда
			Продолжить; // строка без набора — обычный товар
		КонецЕсли;

		КлючГруппы = Строка(Набор.УникальныйИдентификатор()) + ":"
			+ Строка(СтрокаТовара.ХарактеристикаНабора);
		КоличествоНаборов = КоличествоНаборовПоГруппе.Получить(КлючГруппы);
		Если КоличествоНаборов = Неопределено Тогда
			КоличествоНаборов = ОпределитьКоличествоНаборов(СтрокаТовара);
			КоличествоНаборовПоГруппе.Вставить(КлючГруппы, КоличествоНаборов);
		КонецЕсли;

		Пометка = Новый Структура("НаборУИД, Набор, Характеристика, КоличествоНаборов");
		Пометка.НаборУИД = Строка(Набор.УникальныйИдентификатор());
		Пометка.Набор = Строка(Набор);
		// Характеристика входит в ключ группы приёмника: в УТ учёт набора
		// ведётся в разрезе характеристики, и два варианта одного набора
		// в документе — разные группы (дефект N7).
		Пометка.Характеристика = ?(ЗначениеЗаполнено(СтрокаТовара.ХарактеристикаНабора),
			СокрЛП(Строка(СтрокаТовара.ХарактеристикаНабора)), "");
		Пометка.КоличествоНаборов = КоличествоНаборов;

		ПометкаПоНомеру.Вставить(СтрокаТовара.НомерСтроки, Пометка);
	КонецЦикла;

	Если ПометкаПоНомеру.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// На этом шаге «Товары» — ещё таблица значений, собранная типовым
	// обработчиком отправки. Движок превратит её в XDTO-объекты и перенесёт
	// только те колонки, которые есть в расширяющем типе строки.
	ТоварыXDTO = Неопределено;
	Если Не ДанныеXDTO.Свойство("Товары", ТоварыXDTO) Тогда
		ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Предупреждение,
			"КомплектыУТ: в данных отправки нет свойства «Товары» — пометка наборов не выгружена.");
		Возврат;
	КонецЕсли;

	Если ТипЗнч(ТоварыXDTO) <> Тип("ТаблицаЗначений") Тогда
		ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Предупреждение,
			"КомплектыУТ: «Товары» в данных отправки имеет тип "
			+ Строка(ТипЗнч(ТоварыXDTO)) + " вместо таблицы значений — пометка не выгружена.");
		Возврат;
	КонецЕсли;

	Если ТоварыXDTO.Колонки.Найти("НомерСтрокиДокумента") = Неопределено Тогда
		ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Предупреждение,
			"КомплектыУТ: в таблице «Товары» нет колонки «НомерСтрокиДокумента» — сопоставить строки нельзя.");
		Возврат;
	КонецЕсли;

	ДобавитьКолонку(ТоварыXDTO, "КомплектыОбмен_НаборУИД", Новый ОписаниеТипов("Строка"));
	ДобавитьКолонку(ТоварыXDTO, "КомплектыОбмен_Набор", Новый ОписаниеТипов("Строка"));
	ДобавитьКолонку(ТоварыXDTO, "КомплектыОбмен_ХарактеристикаНабора", Новый ОписаниеТипов("Строка"));
	ДобавитьКолонку(ТоварыXDTO, "КомплектыОбмен_КоличествоНаборов", Новый ОписаниеТипов("Число"));

	Заполнено = 0;
	Для Каждого СтрокаXDTO Из ТоварыXDTO Цикл
		Пометка = ПометкаПоНомеру.Получить(СтрокаXDTO.НомерСтрокиДокумента);
		Если Пометка = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		СтрокаXDTO.КомплектыОбмен_НаборУИД = Пометка.НаборУИД;
		СтрокаXDTO.КомплектыОбмен_Набор = Пометка.Набор;
		СтрокаXDTO.КомплектыОбмен_ХарактеристикаНабора = Пометка.Характеристика;
		СтрокаXDTO.КомплектыОбмен_КоличествоНаборов = Пометка.КоличествоНаборов;
		Заполнено = Заполнено + 1;
	КонецЦикла;

	Если Заполнено = 0 Тогда
		ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Предупреждение,
			"КомплектыУТ: пометка есть у " + Строка(ПометкаПоНомеру.Количество())
			+ " строк ИБ, но ни одна строка XDTO не сопоставлена по «НомерСтрокиДокумента».");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедуры

// Сколько наборов продано в строке документа.
//
// УТ не хранит число наборов в строке: строка набора — это строка
// комплектующей, количество в ней уже умножено на число наборов. Поэтому
// количество строки делится на количество этой комплектующей в одном наборе
// (состав варианта комплектации по умолчанию для набора и его характеристики).
// Если состав прочитать не удалось, возвращается 1 — поведение до правки:
// лучше занизить количество в приёмнике, чем уронить выгрузку (D8).
//
// Параметры:
//   СтрокаТовара - СтрокаТаблицыЗначений - строка ТЧ «Товары» документа.
//
// Возвращаемое значение:
//   Число - количество наборов, не меньше 1.
//
Функция ОпределитьКоличествоНаборов(СтрокаТовара)

	Количество = СтрокаТовара.Количество;
	Если Количество <= 0 Тогда
		Возврат 1;
	КонецЕсли;

	Попытка
		Набор = СтрокаТовара.НоменклатураНабора;
		ХарактеристикаНабора = СтрокаТовара.ХарактеристикаНабора;
		Вариант = НаборыВызовСервера.ВариантКомплектацииНоменклатурыПоУмолчанию(
			Набор, ХарактеристикаНабора);
		Если Вариант = Неопределено Тогда
			Возврат 1;
		КонецЕсли;

		МенеджерВариантов = Справочники["ВариантыКомплектацииНоменклатуры"];
		Комплектующие = МенеджерВариантов.ПолучитьКомплектующиеНоменклатуры(Вариант);
		Отбор = Новый Структура("Номенклатура", СтрокаТовара.Номенклатура);
		СтрокиСостава = Комплектующие.НайтиСтроки(Отбор);
		Если СтрокиСостава.Количество() = 0 Тогда
			Возврат 1;
		КонецЕсли;

		КоличествоВНаборе = СтрокиСостава[0].Количество;
		Если КоличествоВНаборе <= 0 Тогда
			Возврат 1;
		КонецЕсли;

		ЧислоНаборов = Окр(Количество / КоличествоВНаборе, 0);
		Если ЧислоНаборов < 1 Тогда
			ЧислоНаборов = 1;
		КонецЕсли;
		Возврат ЧислоНаборов;
	Исключение
		ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Информация,
			"КомплектыУТ: число наборов в строке не определено, принято 1 — "
			+ ОписаниеОшибки());
		Возврат 1;
	КонецПопытки;

КонецФункции

// Строка правила конвертации объекта по имени ПКО.
//
// Параметры:
//   ПравилаКонвертации - ТаблицаЗначений - таблица правил конвертации.
//   ИмяПКО             - Строка - имя правила конвертации объекта.
//
// Возвращаемое значение:
//   СтрокаТаблицыЗначений, Неопределено - найденная строка или Неопределено.
//
Функция СтрокаПравилаКонвертации(ПравилаКонвертации, ИмяПКО)

	Для Каждого СтрокаПКО Из ПравилаКонвертации Цикл
		Если СтрокаПКО.ИмяПКО = ИмяПКО Тогда
			Возврат СтрокаПКО;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Свойства табличной части правила конвертации по имени в формате.
//
// Параметры:
//   ПравилаКонвертации - СтрокаТаблицыЗначений - строка ПКО.
//   ИмяТЧФормата       - Строка - имя табличной части в формате обмена.
//
// Возвращаемое значение:
//   ТаблицаЗначений, Неопределено - таблица свойств ТЧ или Неопределено, если ТЧ нет.
//
Функция СвойстваТабличнойЧастиФормата(ПравилаКонвертации, ИмяТЧФормата)

	Для Каждого КонвертацияТЧ Из ПравилаКонвертации.СвойстваТабличныхЧастей Цикл
		Если КонвертацияТЧ.ТЧФормата = ИмяТЧФормата Тогда
			Возврат КонвертацияТЧ.Свойства;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Процедура ДобавитьКолонку(Таблица, ИмяКолонки, ОписаниеТипов)

	Если Таблица.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
		Таблица.Колонки.Добавить(ИмяКолонки, ОписаниеТипов);
	КонецЕсли;

КонецПроцедуры

Процедура ЗаписатьВЖурнал(Уровень, Текст)

	ЗаписьЖурналаРегистрации("КомплектыОбмен.Обмен", Уровень, , , Текст);

КонецПроцедуры

#КонецОбласти

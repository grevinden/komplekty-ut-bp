// Адаптер бухгалтерии: обработка полученного из обмена документа
// «Реализация товаров услуг». Вызывается из &После на заимствованном
// «МенеджерОбменаЧерезУниверсальныйФормат13».
//
// Состоит из трёх частей:
//   1. Вызов алгоритма свёртки (общее расширение «КомплектыОбмен_Сервер»);
//   2. Запись журнала обработки в «КомплектыБП_ЖурналОбработки»;
//   3. Формирование сообщения в Комментарий документа для визуального контроля.

#Область ПрограммныйИнтерфейс

// Основной обработчик. Вызывается до записи документа в базу.
//
// Свёртка выполняется до записи (строки документа формируются здесь), а журнал
// обработки откладывается и пишется после успешной записи — обработчиком
// подписки «ПослеЗаписи» (см. ОбработатьПослеЗаписи). До записи у документа нет
// ссылки, поэтому записи журнала складываются в ДополнительныеСвойства
// записываемого объекта и переносятся в регистр только после записи (D6).
//
// Параметры:
//   ПолученныеДанные - ДокументОбъект.РеализацияТоваровУслуг -
//       документ, собранный из сообщения, но ещё не записанный.
//       Изменяется in-place: товарные строки заменяются строкой комплекта.
//   ДанныеИБ - ДокументОбъект, Неопределено - объект, который будет записан
//       (для нового документа движок записывает сам ПолученныеДанные).
//
Процедура ОбработатьПередЗаписью(ПолученныеДанные, ДанныеИБ = Неопределено) Экспорт

	ЗаполнитьСкладПриЗагрузке(ПолученныеДанные);

	// Для нового документа движок записывает ПолученныеДанные, для найденного
	// в базе — ДанныеИБ. Отложенный журнал храним на том объекте, что запишется.
	ОбъектДляЖурнала = ?(ДанныеИБ = Неопределено, ПолученныеДанные, ДанныеИБ);

	РезультатСвертки = Неопределено;

	Попытка
		РезультатСвертки = КомплектыОбмен_Сервер.ОбработатьПолученныйДокумент(ПолученныеДанные);
	Исключение
		ИнфоОбОшибке = ИнформацияОбОшибке();
		ОтложитьЗаписьЖурнала(ОбъектДляЖурнала, Неопределено, Истина,
			"Исключение: " + ПодробноеПредставлениеОшибки(ИнфоОбОшибке));
		Возврат;
	КонецПопытки;

	Если РезультатСвертки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не РезультатСвертки.Обработано Тогда
		// Нет пометки — ничего не делаем, документ запишется как пришёл
		Возврат;
	КонецЕсли;

	// Отложить журнал по каждой группе до записи документа
	Для Каждого РезГруппы Из РезультатСвертки.Группы Цикл
		ЕстьОшибка = РезультатСвертки.Ошибки.Найти(РезГруппы.Сообщение) <> Неопределено
			Или Не РезГруппы.Успех;
		ОтложитьЗаписьЖурнала(ОбъектДляЖурнала, РезГруппы, ЕстьОшибка, "");
	КонецЦикла;

	// Добавить отметку в Комментарий документа
	Попытка
		Коммент = ПолученныеДанные["Комментарий"];
		Метка = "Комплекты: обработано " + Формат(РезультатСвертки.Группы.Количество(), "ЧГ=0")
			+ " групп(ы)";
		Если РезультатСвертки.Ошибки.Количество() > 0 Тогда
			Метка = Метка + ", ошибок " + Формат(РезультатСвертки.Ошибки.Количество(), "ЧГ=0");
		КонецЕсли;
		Если ПустаяСтрока(Коммент) Тогда
			ПолученныеДанные["Комментарий"] = Метка;
		Иначе
			ПолученныеДанные["Комментарий"] = Коммент + "; " + Метка;
		КонецЕсли;
	Исключение
		// Отметка в Комментарии — только визуальный контроль для пользователя.
		// Её отсутствие не влияет на данные: факт обработки виден в журнале
		// регистра «КомплектыБП_ЖурналОбработки», поэтому здесь предупреждение.
		ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Предупреждение,
			"КомплектыБП: не удалось дописать отметку в Комментарий документа — "
			+ ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Обработчик подписки «ПослеЗаписи» документа «Реализация товаров и услуг».
//
// Пишет в регистр «КомплектыБП_ЖурналОбработки» записи, отложенные в
// ДополнительныеСвойства записанного объекта (D6). Вызывается только после
// успешной записи: если документ не записался, журнал не врёт про обработку.
//
// Параметры:
//   Источник - ДокументОбъект.РеализацияТоваровУслуг - записанный документ.
//
Процедура ОбработатьПослеЗаписи(Источник) Экспорт

	Попытка
		Если Не Источник.ДополнительныеСвойства.Свойство(ИмяОтложенногоЖурнала()) Тогда
			Возврат;
		КонецЕсли;
		Записи = Источник.ДополнительныеСвойства[ИмяОтложенногоЖурнала()];
		СсылкаДокумента = Источник.Ссылка;
		Для Каждого Запись Из Записи Цикл
			ЗаписатьЖурналПоСсылке(СсылкаДокумента, Запись.РезГруппы,
				Запись.ЕстьОшибка, Запись.ДопСообщение);
		КонецЦикла;
		Источник.ДополнительныеСвойства.Удалить(ИмяОтложенногоЖурнала());
	Исключение
		// Журнал обработки — вспомогательный: сбой записи не должен валить
		// запись самого документа, но должен быть виден в журнале регистрации.
		ЗаписьЖурналаРегистрации("КомплектыОбмен.Обмен",
			УровеньЖурналаРегистрации.Ошибка, , ,
			"КомплектыБП: не удалось записать журнал обработки после записи документа — "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область ВнутренниеМетоды

// Ключ ДополнительныеСвойства, под которым копятся отложенные записи журнала.
//
// Возвращаемое значение:
//   Строка - имя ключа структуры ДополнительныеСвойства документа.
//
Функция ИмяОтложенногоЖурнала() Экспорт

	Возврат "КомплектыБП_ОтложенныйЖурнал";

КонецФункции

// Учётная правка принятого из обмена документа: универсальный формат (ED 1.20)
// не передаёт склад в шапке РеализацииТоваровУслуг, а в БП 3.0 при виде операции
// «Товары» поле обязательное — без него принятый документ не проводится
// («Склад» is a required field, проверено на прогоне 05.11.2026, протокол
// EVIDENCE-2026-11-05). Заполняем первым складом справочника, только если
// шапочный склад пуст; сам склад выбирается по наименованию, чтобы в базе с
// одним складом («Основной склад» в демо) результат был детерминированным.
//
// Параметры:
//   ПолученныеДанные - ДокументОбъект.РеализацияТоваровУслуг -
//       собираемый из сообщения документ, ещё не записанный.
//
Процедура ЗаполнитьСкладПриЗагрузке(ПолученныеДанные)

	// Склад берём из шапки принятого документа, иначе — первый из справочника.
	Склад = Неопределено;

	Попытка
		Если ЗначениеЗаполнено(ПолученныеДанные["Склад"]) Тогда
			Склад = ПолученныеДанные["Склад"];
		КонецЕсли;
	Исключение
		// поля «Склад» у документа нет (другой вид операции) — не трогаем
		Возврат;
	КонецПопытки;

	Если Склад = Неопределено Тогда
		Попытка
			Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
				|	Склады.Ссылка КАК Ссылка
				|ИЗ Справочник.Склады КАК Склады
				|УПОРЯДОЧИТЬ ПО Склады.Наименование");
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Склад = Выборка.Ссылка;
			КонецЕсли;
		Исключение
			// склада в базе нет — пусть срабатывает штатная проверка обязательности
			Возврат;
		КонецПопытки;
	КонецЕсли;

	Если Склад = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ПолученныеДанные["Склад"] = Склад;
	Исключение
		// У документа другого вида операции шапочного склада нет. Строки при
		// этом уже заполнены ниже, а обязательность проверит штатная запись.
		ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Информация,
			"КомплектыБП: шапочный склад в документ не записан — " + ОписаниеОшибки());
	КонецПопытки;

	// ED 1.20 не передаёт склад и в строках, а в БП 3.0 обязательный «Склад»
	// лежит в табличной части «Товары» — проставляем его там, где поле есть.
	Попытка
		Для Каждого СтрокаТовара Из ПолученныеДанные.Товары Цикл
			Попытка
				Если Не ЗначениеЗаполнено(СтрокаТовара["Склад"]) Тогда
					СтрокаТовара["Склад"] = Склад;
				КонецЕсли;
			Исключение
				// поля «Склад» в табличной части нет — достаточно шапочного
				Прервать;
			КонецПопытки;
		КонецЦикла;
	Исключение
		// Табличной части «Товары» у документа нет (услуги/другой вид операции) —
		// заполнять склад в строках нечего, шапочного значения достаточно.
		ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Информация,
			"КомплектыБП: склад в строках не заполнен — " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Складывает запись журнала в ДополнительныеСвойства записываемого объекта.
//
// Параметры:
//   ОбъектДокумента - ДокументОбъект - объект, который будет записан.
//   РезГруппы       - Структура, Неопределено - результат группы свёртки.
//   ЕстьОшибка      - Булево - группа завершилась ошибкой.
//   ДопСообщение    - Строка - дополнительный текст сообщения.
//
Процедура ОтложитьЗаписьЖурнала(ОбъектДокумента, РезГруппы, ЕстьОшибка, ДопСообщение)

	Попытка
		Если Не ОбъектДокумента.ДополнительныеСвойства.Свойство(ИмяОтложенногоЖурнала()) Тогда
			ОбъектДокумента.ДополнительныеСвойства.Вставить(ИмяОтложенногоЖурнала(),
				Новый Массив);
		КонецЕсли;
		Записи = ОбъектДокумента.ДополнительныеСвойства[ИмяОтложенногоЖурнала()];

		Запись = Новый Структура("РезГруппы, ЕстьОшибка, ДопСообщение");
		Запись.РезГруппы = РезГруппы;
		Запись.ЕстьОшибка = ЕстьОшибка;
		Запись.ДопСообщение = ДопСообщение;
		Записи.Добавить(Запись);
	Исключение
		// Дополнительные свойства недоступны (не документ) — пишем сразу по
		// будущей ссылке, чтобы запись не потерялась.
		ЗаписатьЖурналПоСсылке(ПолучитьБудущуюСсылку(ОбъектДокумента), РезГруппы,
			ЕстьОшибка, ДопСообщение);
	КонецПопытки;

КонецПроцедуры

// Будущая ссылка незаписанного объекта, если объект её отдаёт.
Функция ПолучитьБудущуюСсылку(ОбъектДокумента)

	Попытка
		Если ЗначениеЗаполнено(ОбъектДокумента.Ссылка) Тогда
			Возврат ОбъектДокумента.Ссылка;
		КонецЕсли;
		Если ОбъектДокумента.ЭтоНовый() Тогда
			Возврат ОбъектДокумента.ПолучитьСсылкуНового();
		КонецЕсли;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

Процедура ЗаписатьВЖурнал(Уровень, Текст)

	ЗаписьЖурналаРегистрации("КомплектыОбмен.Обмен", Уровень, , , Текст);

КонецПроцедуры

// Пишет одну запись журнала обработки по ссылке уже записанного документа.
//
// Параметры:
//   СсылкаДокумента - ДокументСсылка.РеализацияТоваровУслуг - записанный документ.
//   РезГруппы       - Структура, Неопределено - результат группы свёртки.
//   ЕстьОшибка      - Булево - группа завершилась ошибкой.
//   ДопСообщение    - Строка - дополнительный текст сообщения.
//
Процедура ЗаписатьЖурналПоСсылке(СсылкаДокумента, РезГруппы, ЕстьОшибка, ДопСообщение)

	Если Не ЗначениеЗаполнено(СсылкаДокумента) Тогда
		Возврат; // журналировать нечего: запись с пустым документом бесполезна
	КонецЕсли;

	Попытка
		Менеджер = РегистрыСведений["КомплектыБП_ЖурналОбработки"];
	Исключение
		Возврат;
	КонецПопытки;

	КлючГруппы = "?";
	Карточка = Неопределено;
	Спецификация = Неопределено;
	Сборка = Неопределено;
	КолНаборов = 1;
	Сообщение = ДопСообщение;

	Если РезГруппы <> Неопределено Тогда
		КлючГруппы = РезГруппы.КлючГруппы;
		Карточка = РезГруппы.Карточка;
		Спецификация = РезГруппы.Спецификация;
		Сборка = РезГруппы.Сборка;
		КолНаборов = РезГруппы.КоличествоНаборов;
		Если ПустаяСтрока(Сообщение) Тогда
			Сообщение = РезГруппы.Сообщение;
		КонецЕсли;
	КонецЕсли;

	Попытка
		// Менеджер записи, а не набор записей: у независимого регистра
		// набор записей без отбора при Записать() заменяет ВСЮ таблицу
		// (проверено 06.11.2026: после второй загрузки журнал терял строку
		// предыдущего документа). Менеджер записи пишет одну строку по
		// измерениям и не трогает остальные.
		Запись = Менеджер.СоздатьМенеджерЗаписи();

		Запись.Документ = СсылкаДокумента;
		Запись.КлючГруппы = КлючГруппы;

		Если ЗначениеЗаполнено(Карточка) Тогда
			Запись.Карточка = Карточка;
		КонецЕсли;
		Запись.КоличествоНаборов = КолНаборов;
		Если ЗначениеЗаполнено(Спецификация) Тогда
			Запись.Спецификация = Спецификация;
		КонецЕсли;
		Если ЗначениеЗаполнено(Сборка) Тогда
			Запись.Сборка = Сборка;
		КонецЕсли;

		Если ЕстьОшибка Тогда
			Запись.Состояние = Перечисления["КомплектыБП_СостояниеОбработки"]["Ошибка"];
		Иначе
			Запись.Состояние = Перечисления["КомплектыБП_СостояниеОбработки"]["Обработан"];
		КонецЕсли;

		Запись.Сообщение = Лев(Сообщение, 500);
		Запись.Обработано = ТекущаяДатаСеанса();

		Запись.Записать();
	Исключение
		// Ошибка записи журнала не должна срывать обработку документа.
		ЗаписьЖурналаРегистрации("КомплектыОбмен.Обмен",
			УровеньЖурналаРегистрации.Ошибка, , ,
			"КомплектыБП: не удалось записать запись журнала обработки — "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

#КонецОбласти
// Адаптер бухгалтерии: обработка полученного из обмена документа
// «Реализация товаров услуг». Вызывается из &После на заимствованном
// «МенеджерОбменаЧерезУниверсальныйФормат13».
//
// Состоит из трёх частей:
//   1. Вызов алгоритма свёртки (общее расширение «КомплектыОбмен_Сервер»);
//   2. Запись журнала обработки в «КомплектыБП_ЖурналОбработки»;
//   3. Формирование сообщения в Комментарий документа для визуального контроля.

#Область ПрограммныйИнтерфейс

// Основной обработчик. Вызывается до записи документа в базу.
//
// Параметры:
//   ПолученныеДанные - ДокументОбъект.РеализацияТоваровУслуг -
//       документ, собранный из сообщения, но ещё не записанный.
//       Изменяется in-place: товарные строки заменяются строкой комплекта.
//
Процедура ОбработатьПередЗаписью(ПолученныеДанные) Экспорт

	ЗаполнитьСкладПриЗагрузке(ПолученныеДанные);

	РезультатСвертки = Неопределено;

	Попытка
		РезультатСвертки = КомплектыОбмен_Сервер.ОбработатьПолученныйДокумент(ПолученныеДанные);
	Исключение
		ИнфоОбОшибке = ИнформацияОбОшибке();
		ЗаписатьЖурнал(ПолученныеДанные, Неопределено, Истина,
			"Исключение: " + КраткоеПредставлениеОшибки(ИнфоОбОшибке));
		Возврат;
	КонецПопытки;

	Если РезультатСвертки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не РезультатСвертки.Обработано Тогда
		// Нет пометки — ничего не делаем, документ запишется как пришёл
		Возврат;
	КонецЕсли;

	// Записать журнал по каждой группе
	Для Каждого РезГруппы Из РезультатСвертки.Группы Цикл
		ЕстьОшибка = РезультатСвертки.Ошибки.Найти(РезГруппы.Сообщение) <> Неопределено
			Или Не РезГруппы.Успех;
		ЗаписатьЖурнал(ПолученныеДанные, РезГруппы, ЕстьОшибка, "");
	КонецЦикла;

	// Добавить отметку в Комментарий документа
	Попытка
		Коммент = ПолученныеДанные["Комментарий"];
		Метка = "Комплекты: обработано " + Формат(РезультатСвертки.Группы.Количество(), "ЧГ=0")
			+ " групп(ы)";
		Если РезультатСвертки.Ошибки.Количество() > 0 Тогда
			Метка = Метка + ", ошибок " + Формат(РезультатСвертки.Ошибки.Количество(), "ЧГ=0");
		КонецЕсли;
		Если ПустаяСтрока(Коммент) Тогда
			ПолученныеДанные["Комментарий"] = Метка;
		Иначе
			ПолученныеДанные["Комментарий"] = Коммент + "; " + Метка;
		КонецЕсли;
	Исключение
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область ВнутренниеМетоды

// Учётная правка принятого из обмена документа: универсальный формат (ED 1.20)
// не передаёт склад в шапке РеализацииТоваровУслуг, а в БП 3.0 при виде операции
// «Товары» поле обязательное — без него принятый документ не проводится
// («Склад» is a required field, проверено на прогоне 05.11.2026, протокол
// EVIDENCE-2026-11-05). Заполняем первым складом справочника, только если
// шапочный склад пуст; сам склад выбирается по наименованию, чтобы в базе с
// одним складом («Основной склад» в демо) результат был детерминированным.
//
// Параметры:
//   ПолученныеДанные - ДокументОбъект.РеализацияТоваровУслуг -
//       собираемый из сообщения документ, ещё не записанный.
//
Процедура ЗаполнитьСкладПриЗагрузке(ПолученныеДанные)

	// Склад берём из шапки принятого документа, иначе — первый из справочника.
	Склад = Неопределено;

	Попытка
		Если ЗначениеЗаполнено(ПолученныеДанные["Склад"]) Тогда
			Склад = ПолученныеДанные["Склад"];
		КонецЕсли;
	Исключение
		// поля «Склад» у документа нет (другой вид операции) — не трогаем
		Возврат;
	КонецПопытки;

	Если Склад = Неопределено Тогда
		Попытка
			Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
				|	Склады.Ссылка КАК Ссылка
				|ИЗ Справочник.Склады КАК Склады
				|УПОРЯДОЧИТЬ ПО Склады.Наименование");
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Склад = Выборка.Ссылка;
			КонецЕсли;
		Исключение
			// склада в базе нет — пусть срабатывает штатная проверка обязательности
			Возврат;
		КонецПопытки;
	КонецЕсли;

	Если Склад = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ПолученныеДанные["Склад"] = Склад;
	Исключение
	КонецПопытки;

	// ED 1.20 не передаёт склад и в строках, а в БП 3.0 обязательный «Склад»
	// лежит в табличной части «Товары» — проставляем его там, где поле есть.
	Попытка
		Для Каждого СтрокаТовара Из ПолученныеДанные.Товары Цикл
			Попытка
				Если Не ЗначениеЗаполнено(СтрокаТовара["Склад"]) Тогда
					СтрокаТовара["Склад"] = Склад;
				КонецЕсли;
			Исключение
				// поля «Склад» в табличной части нет — достаточно шапочного
				Прервать;
			КонецПопытки;
		КонецЦикла;
	Исключение
	КонецПопытки;

КонецПроцедуры

Процедура ЗаписатьЖурнал(ПолученныеДанные, РезГруппы, ЕстьОшибка, ДопСообщение)

	Попытка
		Менеджер = РегистрыСведений["КомплектыБП_ЖурналОбработки"];
	Исключение
		Возврат;
	КонецПопытки;

	Попытка
		СсылкаДокумента = ПолученныеДанные["Ссылка"];
		Если Не ЗначениеЗаполнено(СсылкаДокумента) Тогда
			СсылкаДокумента = ПолученныеДанные.Ссылка;
		КонецЕсли;
	Исключение
		СсылкаДокумента = Неопределено;
	КонецПопытки;

	КлючГруппы = "?";
	Карточка = Неопределено;
	Спецификация = Неопределено;
	Сборка = Неопределено;
	КолНаборов = 1;
	Сообщение = ДопСообщение;

	Если РезГруппы <> Неопределено Тогда
		КлючГруппы = РезГруппы.КлючГруппы;
		Карточка = РезГруппы.Карточка;
		Спецификация = РезГруппы.Спецификация;
		Сборка = РезГруппы.Сборка;
		КолНаборов = РезГруппы.КоличествоНаборов;
		Если ПустаяСтрока(Сообщение) Тогда
			Сообщение = РезГруппы.Сообщение;
		КонецЕсли;
	КонецЕсли;

	Попытка
		НаборЗаписей = Менеджер.СоздатьНаборЗаписей();
		Запись = НаборЗаписей.Добавить();

		Запись.Документ = СсылкаДокумента;
		Запись.КлючГруппы = КлючГруппы;

		Если ЗначениеЗаполнено(Карточка) Тогда
			Запись.Карточка = Карточка;
		КонецЕсли;
		Запись.КоличествоНаборов = КолНаборов;
		Если ЗначениеЗаполнено(Спецификация) Тогда
			Запись.Спецификация = Спецификация;
		КонецЕсли;
		Если ЗначениеЗаполнено(Сборка) Тогда
			Запись.Сборка = Сборка;
		КонецЕсли;

		Если ЕстьОшибка Тогда
			Запись.Состояние = Перечисления["КомплектыБП_СостояниеОбработки"]["Ошибка"];
		Иначе
			Запись.Состояние = Перечисления["КомплектыБП_СостояниеОбработки"]["Обработан"];
		КонецЕсли;

		Запись.Сообщение = Лев(Сообщение, 500);
		Запись.Обработано = ТекущаяДата();

		НаборЗаписей.Записать();
	Исключение
	КонецПопытки;

КонецПроцедуры

#КонецОбласти
// Адаптер бухгалтерии: заимствованный общий модуль менеджера обмена.
// Добавлены &После на точки:
//  1. ДобавитьПКО_Документ_РеализацияТоваровУслуг — регистрация свойств пометки
//     набора в правилах конвертации объекта (приёмка);
//  2. ПКО_Документ_РеализацияТоваровУслуг_ПриКонвертацииДанныхXDTO — перенос
//     пометки из XDTO в реквизиты строк полученного документа (строки к этому
//     моменту уже сконвертированы 1-м этапом движка);
//  3. ПКО_Документ_РеализацияТоваровУслуг_ПередЗаписьюПолученныхДанных — вызов
//     алгоритма свёртки.
//
// Имена свойств пометки едины для пары баз (см. КомплектыОбмен_Пометка).

#Область ПрограммныйИнтерфейс

// Регистрирует свойства пометки набора в правилах конвертации приёмки.
//
// Параметры:
//   ПравилаКонвертации - ТаблицаЗначений - таблица правил конвертации объектов,
//                        уже заполненная штатной процедурой менеджера.
//
&После("ДобавитьПКО_Документ_РеализацияТоваровУслуг")
Процедура КомплектыБП_ДополнитьПКО(ПравилаКонвертации) Экспорт

	URI = КомплектыОбмен_Пометка.ПространствоИменРасширения();

	// Штатная процедура менеджера уже добавила строку ПКО и заполнила её.
	// ИнициализироватьРасширениеПравилаКонвертацииОбъекта принимает СТРОКУ
	// правил конвертации: у самой таблицы поля «Расширения» нет
	// (проверено 05.11.2026, см. cfg/EVIDENCE-2026-11-06-pometka-wire.md).
	СтрокаПКО = СтрокаПравилаКонвертации(ПравилаКонвертации,
		"Документ_РеализацияТоваровУслуг");
	Если СтрокаПКО = Неопределено Тогда
		ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Предупреждение,
			"КомплектыБП: в правилах конвертации нет ПКО «Документ_РеализацияТоваровУслуг» — пометка наборов не прочитана.");
		Возврат;
	КонецЕсли;

	// Движок должен знать, что у объекта есть расширяющий XDTO-пакет,
	// иначе свойства пометки не читаются из сообщения.
	Если СтрокаПКО.Расширения = Неопределено Тогда
		СтрокаПКО.Расширения = Новый Соответствие;
	КонецЕсли;
	ОбменДаннымиXDTOСервер.ИнициализироватьРасширениеПравилаКонвертацииОбъекта(
		СтрокаПКО, URI);

	// В ПКО приёмки табличная часть «Товары» заведена как ТЧКонфигурации =
	// «Товары» (ТЧФормата пустая) — ищем именно по имени в конфигурации.
	СвойстваТЧ = СвойстваТабличнойЧастиКонфигурации(СтрокаПКО, "Товары");
	Если СвойстваТЧ = Неопределено Тогда
		ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Предупреждение,
			"КомплектыБП: в ПКО приёмки не найдена табличная часть «Товары» — пометка наборов не прочитана.");
		Возврат;
	КонецЕсли;

	// Свойство формата пустое: значение приходит не из XDTO напрямую, а из
	// дополнительных свойств строки (см. КомплектыБП_ПеренестиПометку).
	ДобавитьПКС(СвойстваТЧ, "КомплектыОбмен_НаборУИД", "", 1, "", URI);
	ДобавитьПКС(СвойстваТЧ, "КомплектыОбмен_Набор", "", 1, "", URI);
	ДобавитьПКС(СвойстваТЧ, "КомплектыОбмен_ХарактеристикаНабора", "", 1, "", URI);
	ДобавитьПКС(СвойстваТЧ, "КомплектыОбмен_КоличествоНаборов", "", 1, "", URI);

КонецПроцедуры

// Переносит пометку наборов из сообщения в данные, из которых движок
// заполняет строки полученного документа на 2-м этапе конвертации.
//
// Параметры:
//   ДанныеXDTO      - Структура - данные объекта из сообщения (ОбъектXDTOВСтруктуру).
//   ПолученныеДанные - ДокументОбъект - документ, собираемый из сообщения.
//   КомпонентыОбмена - Структура - компоненты обмена (не используется).
//
&После("ПКО_Документ_РеализацияТоваровУслуг_ПриКонвертацииДанныхXDTO")
Процедура КомплектыБП_ПеренестиПометку(ДанныеXDTO, ПолученныеДанные,
	КомпонентыОбмена) Экспорт

	// ДанныеXDTO — Структура, собранная ОбъектXDTOВСтруктуру(): табличные части
	// в ней — ТаблицаЗначений, строки — СтрокаТаблицыЗначений. На проходе поиска
	// ссылки приходит Структура только из ключевых свойств: «Товары» в ней нет,
	// и обработчик штатно выходит по проверке ниже.
	//
	// ВАЖНО: у XDTO-объекта нет метода Тип() и нет Тип().Свойства.Найти():
	// проверка наличия свойства делается только через Свойство(<Имя>), которое
	// возвращает Булево (05.11.2026, отказ загрузки БП — см.
	// cfg/EVIDENCE-2026-11-05-cross-ut-bp.md).
	// Разбор обёрнут в Попытку: сбой чтения пометки не должен срывать загрузку
	// всего сообщения — деградируем до «пометка не перенесена» с записью в журнал.
	//
	// Пометка переносится по номеру строки: строки сообщения и структуры
	// дополнительных свойств собираются базовой процедурой в одном порядке.
	// Проверка количества обязательна: при расхождении пометка попала бы не в ту строку.
	Пометки = Новый Массив; // по индексу строки: Структура или Неопределено
	ИмяТЧТовары = "Товары";
	Попытка

		Если Не ДанныеXDTO.Свойство(ИмяТЧТовары) Тогда
			Возврат;
		КонецЕсли;

		ТоварыXDTO = ДанныеXDTO.Товары;
		Если ТипЗнч(ТоварыXDTO) <> Тип("ТаблицаЗначений") Тогда
			ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Предупреждение,
				"КомплектыБП: табличная часть «Товары» пришла не ТаблицейЗначений ("
				+ Строка(ТипЗнч(ТоварыXDTO)) + ") — пометка наборов не перенесена.");
			Возврат;
		КонецЕсли;

		Если ТоварыXDTO.Колонки.Найти("КомплектыОбмен_НаборУИД") = Неопределено Тогда
			// Расширение формата не подключено — свойства пометки не прочитаны из
			// сообщения. Это не «обычная продажа без пометки», поэтому в журнал.
			ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Предупреждение,
				"КомплектыБП: в табличной части «Товары» нет колонок КомплектыОбмен_* — "
				+ "расширение формата EnterpriseData не подключено, пометка наборов не перенесена.");
			Возврат;
		КонецЕсли;

		// Состав колонок проверяется один раз: у СтрокаТаблицыЗначений нет метода
		// Свойство(), поэтому обращение к несуществующей колонке — исключение.
		ЕстьКолонкаНабор = ТоварыXDTO.Колонки.Найти("КомплектыОбмен_Набор") <> Неопределено;
		ЕстьКолонкаКоличество =
			ТоварыXDTO.Колонки.Найти("КомплектыОбмен_КоличествоНаборов") <> Неопределено;
		ЕстьКолонкаХарактеристика =
			ТоварыXDTO.Колонки.Найти("КомплектыОбмен_ХарактеристикаНабора") <> Неопределено;

		Для Каждого СтрокаXDTO Из ТоварыXDTO Цикл
			Пометки.Добавить(ПометкаСтрокиТоваров(СтрокаXDTO,
				ЕстьКолонкаНабор, ЕстьКолонкаХарактеристика, ЕстьКолонкаКоличество));
		КонецЦикла;

	Исключение
		ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Предупреждение,
			"КомплектыБП: пометка наборов не прочитана из сообщения — " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	Перенесено = 0;
	Для Индекс = 0 По Пометки.Количество() - 1 Цикл
		Если Пометки[Индекс] <> Неопределено Тогда
			Перенесено = Перенесено + 1;
		КонецЕсли;
	КонецЦикла;

	Если Перенесено = 0 Тогда
		Возврат; // сообщение без пометки — обычная продажа
	КонецЕсли;

	// Строки документа на этом этапе ещё не созданы: базовая процедура собирает
	// их в ПолученныеДанные.ДополнительныеСвойства["Товары"] (массив структур),
	// а движок на 2-м этапе переносит значения структур в строки ТЧ по ПКС
	// с ИспользуетсяАлгоритмКонвертации = Истина. Поэтому пометка пишется
	// в те же структуры (05.11.2026: строкДок=0 на входе обработчика,
	// см. cfg/EVIDENCE-2026-11-06-pometka-wire.md).
	Если Не ПолученныеДанные.ДополнительныеСвойства.Свойство(ИмяТЧТовары) Тогда
		ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Предупреждение,
			"КомплектыБП: в сообщении " + Строка(Перенесено)
			+ " строк с пометкой набора, но дополнительные свойства «Товары» не заполнены — "
			+ "пометка наборов не перенесена.");
		Возврат;
	КонецЕсли;

	СтрокиТоваров = ПолученныеДанные.ДополнительныеСвойства[ИмяТЧТовары];
	Если СтрокиТоваров.Количество() <> Пометки.Количество() Тогда
		ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Предупреждение,
			"КомплектыБП: в сообщении " + Строка(Пометки.Количество())
			+ " строк «Товары», в дополнительных свойствах " + Строка(СтрокиТоваров.Количество())
			+ " — пометка наборов не перенесена (сопоставление по номеру строки невозможно).");
		Возврат;
	КонецЕсли;

	Для Индекс = 0 По Пометки.Количество() - 1 Цикл
		Пометка = Пометки[Индекс];
		Если Пометка = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ЗаписатьПометкуВСтруктуру(СтрокиТоваров[Индекс], Пометка);
	КонецЦикла;

КонецПроцедуры

// Запускает свёртку набора перед записью полученного документа.
//
// Параметры:
//   ПолученныеДанные - ДокументОбъект - документ, собираемый из сообщения.
//   ДанныеИБ         - ДокументОбъект, Неопределено - объект, который будет
//                      записан (для нового документа совпадает с ПолученныеДанные).
//   КонвертацияСвойств - Соответствие - конвертация свойств (не используется).
//   КомпонентыОбмена - Структура - компоненты обмена (не используется).
//
&После("ПКО_Документ_РеализацияТоваровУслуг_ПередЗаписьюПолученныхДанных")
Процедура КомплектыБП_ПередЗаписью(ПолученныеДанные, ДанныеИБ,
	КонвертацияСвойств, КомпонентыОбмена) Экспорт

	КомплектыБП_Обмен.ОбработатьПередЗаписью(ПолученныеДанные, ДанныеИБ);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедуры

// Пометка набора в одной строке табличной части «Товары» сообщения.
//
// Параметры:
//   СтрокаXDTO           - СтрокаТаблицыЗначений - строка табличной части
//                          «Товары», собранной движком из XDTO.
//   ЕстьКолонкаНабор     - Булево - в таблице есть колонка КомплектыОбмен_Набор.
//   ЕстьКолонкаХарактеристика - Булево - есть колонка КомплектыОбмен_ХарактеристикаНабора.
//   ЕстьКолонкаКоличество - Булево - есть колонка КомплектыОбмен_КоличествоНаборов.
//
// Возвращаемое значение:
//   Структура, Неопределено - поля НаборУИД, Набор, Характеристика, КоличествоНаборов;
//                             Неопределено, если строка без пометки.
//
Функция ПометкаСтрокиТоваров(СтрокаXDTO, ЕстьКолонкаНабор,
	ЕстьКолонкаХарактеристика, ЕстьКолонкаКоличество)

	НаборУИД = СокрЛП(СтрокаXDTO.КомплектыОбмен_НаборУИД);
	Если ПустаяСтрока(НаборУИД) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Пометка = Новый Структура("НаборУИД, Набор, Характеристика, КоличествоНаборов",
		НаборУИД, "", "", 1);
	Если ЕстьКолонкаНабор Тогда
		Пометка.Набор = СокрЛП(СтрокаXDTO.КомплектыОбмен_Набор);
	КонецЕсли;
	Если ЕстьКолонкаХарактеристика Тогда
		Пометка.Характеристика = СокрЛП(СтрокаXDTO.КомплектыОбмен_ХарактеристикаНабора);
	КонецЕсли;
	Если ЕстьКолонкаКоличество
		И ЗначениеЗаполнено(СтрокаXDTO.КомплектыОбмен_КоличествоНаборов) Тогда
		Пометка.КоличествоНаборов = СтрокаXDTO.КомплектыОбмен_КоличествоНаборов;
	КонецЕсли;

	Возврат Пометка;

КонецФункции

// Записывает поля пометки набора в структуру строки «Товары».
//
// Параметры:
//   СтрокаТоваров - Структура - данные строки ТЧ «Товары» для 2-го этапа движка.
//   Пометка       - Структура - поля НаборУИД, Набор, Характеристика, КоличествоНаборов.
//
Процедура ЗаписатьПометкуВСтруктуру(СтрокаТоваров, Пометка)

	СвойстваПометки = Новый Структура(
		"КомплектыОбмен_НаборУИД, КомплектыОбмен_Набор, " +
		"КомплектыОбмен_ХарактеристикаНабора, КомплектыОбмен_КоличествоНаборов",
		Пометка.НаборУИД, Пометка.Набор, Пометка.Характеристика, Пометка.КоличествоНаборов);
	Для Каждого СвойствоПометки Из СвойстваПометки Цикл
		Если СтрокаТоваров.Свойство(СвойствоПометки.Ключ) Тогда
			СтрокаТоваров[СвойствоПометки.Ключ] = СвойствоПометки.Значение;
		Иначе
			СтрокаТоваров.Вставить(СвойствоПометки.Ключ, СвойствоПометки.Значение);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Строка правила конвертации объекта по имени ПКО.
//
// Параметры:
//   ПравилаКонвертации - ТаблицаЗначений - таблица правил конвертации.
//   ИмяПКО             - Строка - имя правила конвертации объекта.
//
// Возвращаемое значение:
//   СтрокаТаблицыЗначений, Неопределено - найденная строка или Неопределено.
//
Функция СтрокаПравилаКонвертации(ПравилаКонвертации, ИмяПКО)

	Для Каждого СтрокаПКО Из ПравилаКонвертации Цикл
		Если СтрокаПКО.ИмяПКО = ИмяПКО Тогда
			Возврат СтрокаПКО;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Свойства табличной части правила конвертации по имени в конфигурации.
//
// Параметры:
//   ПравилаКонвертации - СтрокаТаблицыЗначений - строка ПКО.
//   ИмяТЧКонфигурации  - Строка - имя табличной части в конфигурации.
//
// Возвращаемое значение:
//   ТаблицаЗначений, Неопределено - таблица свойств ТЧ или Неопределено, если ТЧ нет.
//
Функция СвойстваТабличнойЧастиКонфигурации(ПравилаКонвертации, ИмяТЧКонфигурации)

	Для Каждого КонвертацияТЧ Из ПравилаКонвертации.СвойстваТабличныхЧастей Цикл
		Если КонвертацияТЧ.ТЧКонфигурации = ИмяТЧКонфигурации Тогда
			Возврат КонвертацияТЧ.Свойства;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Процедура ЗаписатьВЖурнал(Уровень, Текст)

	ЗаписьЖурналаРегистрации("КомплектыОбмен.Обмен", Уровень, , , Текст);

КонецПроцедуры

#КонецОбласти

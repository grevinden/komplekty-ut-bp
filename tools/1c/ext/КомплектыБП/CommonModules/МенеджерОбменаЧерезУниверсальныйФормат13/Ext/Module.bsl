// Адаптер бухгалтерии: заимствованный общий модуль менеджера обмена.
// Добавлены &После на точки:
//  1. ДобавитьПКО_Документ_РеализацияТоваровУслуг — регистрация новых свойств в ПКО;
//  2. ПКО_Документ_РеализацияТоваровУслуг_ПередЗаписьюПолученныхДанных — вызов алгоритма свёртки.

#Область ПрограммныйИнтерфейс

&После("ДобавитьПКО_Документ_РеализацияТоваровУслуг")
Процедура КомплектыБП_ДополнитьПКО(ПравилаКонвертации) Экспорт

	URI = "http://v8.1c.ru/edi/edi_stnd_ext_enterprisedata/EnterpriseData/1.20";

	// Инициализировать расширение правила конвертации (регистрация XDTO-типа)
	Попытка
		ОбменДаннымиXDTOСервер.ИнициализироватьРасширениеПравилаКонвертацииОбъекта(
			ПравилаКонвертации, URI);
	Исключение
		Возврат;
	КонецПопытки;

	// Найти свойства табличной части Товары и добавить наши свойства
	Попытка
		СвойстваТЧ = ПравилаКонвертации.Свойства.Найти("Товары");
		Если СвойстваТЧ = Неопределено Тогда
			Возврат;
		КонецЕсли;

		ДобавитьПКС(СвойстваТЧ, "КомплектыБП_НаборУИД", "", 1, "", URI);
		ДобавитьПКС(СвойстваТЧ, "КомплектыБП_Набор", "", 1, "", URI);
		ДобавитьПКС(СвойстваТЧ, "КомплектыБП_КоличествоНаборов", "", 1, "", URI);
	Исключение
	КонецПопытки;

КонецПроцедуры

&После("ПКО_Документ_РеализацияТоваровУслуг_ПередЗаписьюПолученныхДанных")
Процедура КомплектыБП_ПередЗаписью(ПолученныеДанные, ДанныеИБ,
	КонвертацияСвойств, КомпонентыОбмена) Экспорт

	КомплектыБП_Обмен.ОбработатьПередЗаписью(ПолученныеДанные);

КонецПроцедуры

#КонецОбласти